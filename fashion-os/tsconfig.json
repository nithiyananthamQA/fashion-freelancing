{
  "extends": "astro/tsconfigs/strict",
  "include": [".astro/types.d.ts", "**/*.ts", "**/*.astro"],
  "exclude": ["dist", "node_modules"],
  "compilerOptions": {
    "types": ["astro/client", "@cloudflare/workers-types/experimental"],
    "baseUrl": ".",
    "paths": { "@/*": ["src/*"] },
    "strictNullChecks": true,
    "noUncheckedIndexedAccess": true
  }
}
