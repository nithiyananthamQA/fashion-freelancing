---
import Logo from './Logo.astro';
const { current = '' } = Astro.props;
const nav = [
  { section: 'Overview', items: [
    { href: '/admin', label: 'Dashboard', k: 'dash' },
  ]},
  { section: 'Trust & safety', items: [
    { href: '/admin/moderation',   label: 'Moderation queue', k: 'mod', badge: '24' },
    { href: '/admin/verification', label: 'Verifications',    k: 'ver', badge: '47' },
    { href: '/admin/disputes',     label: 'Disputes',         k: 'dis', badge: '8' },
    { href: '/admin/fraud',        label: 'Fraud monitoring', k: 'fraud' },
  ]},
  { section: 'Operations', items: [
    { href: '/admin/users',         label: 'Users',         k: 'users' },
    { href: '/admin/subscriptions', label: 'Subscriptions', k: 'subs' },
    { href: '/admin/reports',       label: 'Reports',       k: 'reports' },
  ]},
  { section: 'Platform', items: [
    { href: '/admin/services',  label: 'Services catalog', k: 'svc' },
    { href: '/admin/analytics', label: 'Analytics',        k: 'an' },
    { href: '/admin/settings',  label: 'Settings',         k: 'set' },
  ]},
];
---
<div id="db-nav-backdrop" class="fixed inset-0 bg-ink-900/40 backdrop-blur-sm z-40 opacity-0 invisible transition-all duration-300 lg:hidden"></div>

<aside id="db-sidebar"
  class="fixed lg:sticky top-0 left-0 z-50 lg:z-auto flex flex-col w-64 shrink-0 border-r border-line bg-white h-screen
         -translate-x-full lg:translate-x-0 transition-transform duration-300">
  <div class="px-5 h-16 flex items-center border-b border-line gap-2">
    <Logo />
    <span class="ml-1 text-[10px] font-semibold uppercase tracking-wider text-rose-700 bg-rose-50 border border-rose-100 rounded px-1.5 py-0.5">Admin</span>
    <button id="db-nav-close" aria-label="Close menu" class="lg:hidden ml-auto w-9 h-9 rounded-lg flex items-center justify-center hover:bg-ink-50 text-ink-500">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M18 6 6 18M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="px-3 py-4 flex-1 overflow-y-auto">
    {nav.map((group) => (
      <div class="mb-4">
        <div class="px-3 mb-1.5 text-[10px] uppercase tracking-[0.22em] text-ink-6 mono">{group.section}</div>
        <ul class="space-y-0.5">
          {group.items.map((it) => (
            <li>
              <a href={it.href} class={`nav-item ${current === it.k ? 'active' : ''}`}>
                <span class="flex-1">{it.label}</span>
                {it.badge && <span data-badge-k={it.k} class={`text-[10px] mono px-1.5 py-0.5 rounded-full ${current === it.k ? 'bg-white/20 text-white' : 'bg-rose-50 text-rose-700'}`}>{it.badge}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>

  <div class="border-t border-line p-3 relative">
    <button type="button" id="adm-user-chip" class="w-full flex items-center gap-3 p-2 rounded-lg hover:bg-paper-2 text-left">
      <div class="w-9 h-9 rounded-full bg-ink text-paper flex items-center justify-center font-bold text-xs">A</div>
      <div class="min-w-0 flex-1">
        <div class="text-sm font-medium truncate">Admin user</div>
        <div class="text-[11px] text-ink-5 mono truncate">internal · v1</div>
      </div>
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-ink-5"><path d="M6 9l6 6 6-6"/></svg>
    </button>
    <div id="adm-user-menu" class="hidden absolute left-3 right-3 bottom-[68px] bg-white border border-line rounded-xl shadow-xl py-1.5 z-50">
      <a href="/admin/settings" class="block px-4 py-2 text-sm hover:bg-paper-2">Settings</a>
      <div class="border-t border-line my-1"></div>
      <button type="button" id="adm-signout" class="w-full text-left px-4 py-2 text-sm text-rose-700 hover:bg-rose-50">Sign out</button>
    </div>
  </div>
</aside>

<script is:inline>
  (function () {
    const chip = document.getElementById('adm-user-chip');
    const menu = document.getElementById('adm-user-menu');
    const signout = document.getElementById('adm-signout');
    if (!chip || !menu) return;
    function close() { menu.classList.add('hidden'); }
    chip.addEventListener('click', (e) => {
      e.stopPropagation();
      menu.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!menu.contains(e.target) && e.target !== chip) close();
    });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
    if (signout) {
      signout.addEventListener('click', async () => {
        try { await window.api.users.signOut(); } catch (_) {}
        window.UI && window.UI.toast && window.UI.toast('Signed out.', { kind: 'success' });
        setTimeout(() => { location.href = '/'; }, 300);
      });
    }
  })();
</script>

<script is:inline>
  (function () {
    const sidebar  = document.getElementById('db-sidebar');
    const backdrop = document.getElementById('db-nav-backdrop');
    if (!sidebar || !backdrop) return;
    function open() {
      sidebar.classList.remove('-translate-x-full');
      backdrop.classList.remove('opacity-0', 'invisible');
      document.body.style.overflow = 'hidden';
    }
    function close() {
      sidebar.classList.add('-translate-x-full');
      backdrop.classList.add('opacity-0', 'invisible');
      document.body.style.overflow = '';
    }
    backdrop.addEventListener('click', close);
    document.getElementById('db-nav-close')?.addEventListener('click', close);
    document.addEventListener('click', (e) => {
      if (e.target.closest && e.target.closest('#db-nav-toggle')) open();
    });
    sidebar.querySelectorAll('a[href]').forEach(a => a.addEventListener('click', close));
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });
  })();
</script>

<!-- Live badge counts for moderation / verifications / disputes -->
<script is:inline>
  (function () {
    function paintBadges() {
      const api = window.api;
      if (!api || !api._store) return;
      const state = api._store.getState();
      const fmt = n => (n | 0).toString();
      const updates = {
        ver: (state.freelancers || []).filter(f => f.approvalStatus === 'pending').length,
        mod: 0,                                           // no moderation collection in store yet
        dis: (state.orders || []).filter(o => o.status === 'disputed').length,
      };
      Object.entries(updates).forEach(([k, n]) => {
        document.querySelectorAll('[data-badge-k="' + k + '"]').forEach(el => {
          if (n > 0) {
            el.textContent = fmt(n);
            el.style.display = '';
          } else {
            el.style.display = 'none';   // hide the badge entirely when there's nothing pending
          }
        });
      });
    }
    if (window.api) paintBadges();
    else window.addEventListener('ff:ready', paintBadges, { once: true });
  })();
</script>
