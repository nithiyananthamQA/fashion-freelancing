---
const { title = 'Overview', role = 'creator' } = Astro.props;
---
<header class="db-topbar border-b border-line sticky top-0 z-40">
  <div class="h-16 px-4 lg:px-8 flex items-center gap-3 lg:gap-4">
    <button id="db-nav-toggle" aria-label="Open menu"
      class="lg:hidden w-10 h-10 -ml-1 rounded-lg flex flex-col items-center justify-center gap-[5px] border border-line bg-white/70 backdrop-blur hover:border-champagne transition">
      <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
      <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
      <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
    </button>
    <h1 class="editorial text-xl lg:text-2xl">{title}</h1>

    <div class="flex-1 max-w-md mx-4 hidden md:block">
      <div class="relative">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute left-3.5 top-1/2 -translate-y-1/2 text-ink-400"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
        <input class="w-full bg-ink-50 border border-line rounded-full pl-10 pr-20 py-2.5 text-sm placeholder:text-ink-400 focus:outline-none focus:bg-white focus:border-ink-300 transition" placeholder={role === 'brand' ? 'Search creators, projects, files…' : 'Search briefs, messages, files…'} />
        <span class="absolute right-3 top-1/2 -translate-y-1/2 mono text-[10px] text-ink-400 chip !py-0.5 !px-1.5 !text-[10px]">⌘ K</span>
      </div>
    </div>

    <div class="ml-auto flex items-center gap-2">
      <button aria-label="Notifications" class="relative chip rounded-full !p-0 w-9 h-9 flex items-center justify-center hover:border-ink-300">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 1 1 12 0c0 7 3 7 3 9H3c0-2 3-2 3-9zM10 21a2 2 0 0 0 4 0"/></svg>
        <span class="absolute top-1.5 right-2 w-1.5 h-1.5 rounded-full bg-gold"></span>
      </button>
      <a href={role === 'brand' ? '/brand/post' : '/dashboard/gigs/new'} class="hidden md:inline btn-gold !py-2 text-sm rounded-full">{role === 'brand' ? 'Post a job' : 'Add a service'}</a>
    </div>
  </div>
</header>
