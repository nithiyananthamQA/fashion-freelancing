        <ul class="space-y-2.5 text-sm text-ink-600">
          <li><a href="/talent/womenswear-designers" class="hover:text-ink-900">Designers</a></li>
          <li><a href="/talent/pattern-makers" class="hover:text-ink-900">Pattern makers</a></li>
          <li><a href="/talent/tech-pack-specialists" class="hover:text-ink-900">Tech pack pros</a></li>
          <li><a href="/talent/editorial-stylists" class="hover:text-ink-900">Stylists</a></li>
          <li><a href="/talent/verified-manufacturers" class="hover:text-ink-900">Manufacturers</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-[0.18em] text-ink-500 mb-4">Creators</div>
        <ul class="space-y-2.5 text-sm text-ink-600">
          <li><a href="/signup" class="hover:text-ink-900">Become a creator</a></li>
          <li><a href="/marketplace" class="hover:text-ink-900">Find work</a></li>
          <li><a href="/ai-studio" class="hover:text-ink-900">AI Studio</a></li>
          <li><a href="/pricing" class="hover:text-ink-900">Pricing</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-[0.18em] text-ink-500 mb-4">Platform</div>
        <ul class="space-y-2.5 text-sm text-ink-600">
          <li><a href="/workflow" class="hover:text-ink-900">Workflow</a></li>
          <li><a href="/dashboard/messages" class="hover:text-ink-900">Messaging</a></li>
          <li><a href="/pricing" class="hover:text-ink-900">Payments</a></li>
          <li><a href="/community" class="hover:text-ink-900">Community</a></li>
        </ul>
      </div>

      <div>
        <div class="text-xs uppercase tracking-[0.18em] text-ink-500 mb-4">Company</div>
        <ul class="space-y-2.5 text-sm text-ink-600">
          <li><a href="/blog" class="hover:text-ink-900">Editorial</a></li>
          <li><a href="#" class="hover:text-ink-900">About</a></li>
          <li><a href="#" class="hover:text-ink-900">Careers</a></li>
          <li><a href="#" class="hover:text-ink-900">Press</a></li>
          <li><a href="#" class="hover:text-ink-900">Contact</a></li>
        </ul>
      </div>
    </div>

    <div class="mt-14 pt-6 border-t border-line flex flex-col md:flex-row md:items-center justify-between gap-4 text-xs text-ink-500">
      <div>© 2026 Fashion Freelancing · Made for fashion people.</div>
      <div class="flex gap-6">
        <a href="#" class="hover:text-ink-900">Privacy</a>
        <a href="#" class="hover:text-ink-900">Terms</a>
        <a href="#" class="hover:text-ink-900">Cookies</a>
        <a href="#" class="hover:text-ink-900">Accessibility</a>
