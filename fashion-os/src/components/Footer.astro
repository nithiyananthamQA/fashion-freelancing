---
import Logo from './Logo.astro';
---
<footer class="border-t border-line bg-surface">
  <div class="container-x py-16">
    <div class="grid grid-cols-2 lg:grid-cols-6 gap-10">
      <div class="col-span-2">
        <Logo />
        <p class="text-ink-500 text-sm mt-4 max-w-xs">Hire fashion freelancers, or get hired as one. Pay safely. Get paid safely. That's it.</p>
        <div class="mt-6 flex gap-3">
          <a href="#" class="chip rounded-full w-9 h-9 !p-0 flex items-center justify-center hover:border-gold/40">
