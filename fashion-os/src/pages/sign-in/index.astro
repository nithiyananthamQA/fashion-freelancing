---
/**
 * /sign-in — one shared sign-in for companies and freelancers (plan §3).
 *
 * The page handles its own POST so it works without JavaScript, and `next` is
 * carried through the whole exchange so a visitor who was part-way through a
 * hire request lands back exactly where they were (§6.1).
 */
export const prerender = false;

import Night from '../../layouts/Night.astro';
import { db, env } from '../../server/db';
import { landingFor, rolesOf, signIn, signUp } from '../../server/auth';
import { googleConfigured } from '../../server/google';
import { safeNext } from '../../server/guards';
import { createSession, setSessionCookie } from '../../server/session';
import { mergeCookieShortlist } from '../../server/shortlist';
import { passwordProblem } from '../../server/password';
import { HONEYPOT, parse, trapped } from '../../server/validate';
import { accountKey, clientKey, limited, tooManyRequests, windowInWords } from '../../server/rate-limit';

const database = db(Astro);
const runtimeEnv = env(Astro);

/* Already signed in? Skip straight to where they were heading. */
if (Astro.locals.user) {
  return Astro.redirect(landingFor(Astro.url.searchParams.get('next'), Astro.locals.user));
}

let mode = Astro.url.searchParams.get('mode') === 'create' ? 'create' : 'signin';
let errors: Record<string, string> = {};
let values = { name: '', email: '' };
const note = Astro.url.searchParams.get('note');
/* Checked on the way in, not only on the way out: `next` is echoed into the
   form and the "other mode" link, so an unsafe one must not survive a round trip. */
let next = safeNext(Astro.url.searchParams.get('next'), null);

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  mode = form.get('mode') === 'create' ? 'create' : 'signin';
  next = form.has('next') ? safeNext(form.get('next'), null) : next;

  if (trapped(form)) return Astro.redirect('/specialists');

  const { f, errors: found } = parse(form);
  errors = found;

  const email = f.email('email');
  const password = f.text('password', 'Password', { required: true, max: 200 });
  values = { name: f.text('name', 'Your name', { required: mode === 'create', max: 120 }), email };

  if (await limited(database, mode === 'create' ? 'signUp' : 'signIn', clientKey(Astro.request))) {
    return tooManyRequests();
  }

  if (mode === 'create') {
    const problem = passwordProblem(password);
    if (problem) errors.password = problem;
    f.consent('terms', 'Please accept the terms and privacy policy to continue.');

    if (!Object.keys(errors).length) {
      const result = await signUp(database, runtimeEnv, Astro.request, {
        name: values.name,
        email,
        password,
        country: f.text('country', 'Country', { max: 60 }) || null,
        timezone: f.text('timezone', 'Timezone', { max: 60 }) || null,
        acceptedTerms: true, tenant: Astro.locals.tenant,
      });
      if (!result.ok) {
        errors[result.field] = result.message;
      } else {
        const token = await createSession(database, result.userId, Astro.request.headers.get('user-agent'));
        setSessionCookie(Astro, token);
        // A brand-new account has no company yet, so the saved list stays in the
        // cookie and is merged the moment one exists (company setup, or the
        // first hire request). Nothing is dropped here.
        return Astro.redirect(landingFor(next, { companyIds: [], profileId: null, isAdmin: false }));
      }
    }
  } else if (!Object.keys(errors).length) {
    /* Per account as well as per address, so guesses spread across many
       machines still run out. Said in the form rather than as a bare 429: the
       person most likely to see it is the owner, and they need the way out. */
    const result = await limited(database, 'signInAccount', await accountKey(email))
      ? { ok: false as const, message: `Too many attempts for this account. Wait ${windowInWords('signInAccount')}, or reset your password below.` }
      : await signIn(database, Astro.request, email, password, Astro.locals.tenant);
    if (!result.ok) {
      errors.password = result.message;
    } else {
      const token = await createSession(database, result.userId, Astro.request.headers.get('user-agent'));
      setSessionCookie(Astro, token);
      const roles = await rolesOf(database, result.userId);
      // Anything shortlisted before signing in now belongs to their company.
      if (roles.companyIds[0]) {
        await mergeCookieShortlist(Astro, database, roles.companyIds[0], result.userId);
      }
      return Astro.redirect(landingFor(next, roles));
    }
  }
}


const creating = mode === 'create';
const google = googleConfigured(runtimeEnv);
const googleUrl = `/sign-in/google${next ? `?next=${encodeURIComponent(next)}` : ''}`;
const otherModeUrl = `/sign-in?mode=${creating ? 'signin' : 'create'}${next ? `&next=${encodeURIComponent(next)}` : ''}`;
---

<Night title={creating ? 'Create your account — Fashion Freelancing' : 'Sign in — Fashion Freelancing'} noindex current="" quoteBot={false}>
  <section class="net-hero" style="padding-bottom:calc(var(--u) * 8);">
    <div class="wrap">
      <div class="flow" style="max-width:520px;">

        <div class="flow-head">
          <span class="kicker">{creating ? 'New account' : 'Welcome back'}</span>
          <h1 style="margin-top:14px;">{creating ? 'Create your account.' : 'Sign in.'}</h1>
          <p class="sub" style="margin-top:12px;">
            One account covers both sides — hire a specialist, offer your own work, or do both.
          </p>
        </div>

        {note === 'hire' && (
          <div class="notice">Sign in to send this request. Your brief and the specialist you picked are saved.</div>
        )}
        {note === 'save' && (
          <div class="notice">Sign in to save specialists to your company's shortlist.</div>
        )}
        {note === 'everywhere' && (
          <div class="notice" role="status">You are signed out on every device, this one included.</div>
        )}
        {note === 'google-cancelled' && (
          <div class="notice" role="status">Google sign-in was cancelled. Try again, or use your email below.</div>
        )}
        {note === 'google-failed' && (
          <div class="notice bad" role="alert">Google sign-in did not go through — the link may have expired. Please try again.</div>
        )}
        {note === 'google-other-account' && (
          <div class="notice bad" role="alert">That email is already linked to a different Google account. Sign in with that one, or with your password.</div>
        )}
        {note === 'google-inactive' && (
          <div class="notice bad" role="alert">That account is not active. Contact us if you think this is wrong.</div>
        )}

        <div class="flow-panel glass-p">
          {Object.keys(errors).length > 0 && (
            <p class="notice bad" role="alert" style="margin-bottom:22px;">
              Nothing was lost — check the highlighted {Object.keys(errors).length === 1 ? 'field' : 'fields'} below.
            </p>
          )}

          {google && (
            <Fragment>
              <a href={googleUrl} class="btn-glass google-btn" style="width:100%;justify-content:center;gap:10px;">
                <svg width="18" height="18" viewBox="0 0 48 48" aria-hidden="true">
                  <path fill="#FFC107" d="M43.6 20.5H42V20H24v8h11.3C33.7 32.7 29.2 36 24 36c-6.6 0-12-5.4-12-12s5.4-12 12-12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 12.9 4 4 12.9 4 24s8.9 20 20 20 20-8.9 20-20c0-1.3-.1-2.4-.4-3.5z"/>
                  <path fill="#FF3D00" d="M6.3 14.7l6.6 4.8C14.7 15.1 19 12 24 12c3.1 0 5.8 1.2 7.9 3.1l5.7-5.7C34 6.1 29.3 4 24 4 16.3 4 9.7 8.3 6.3 14.7z"/>
                  <path fill="#4CAF50" d="M24 44c5.2 0 9.9-2 13.4-5.2l-6.2-5.2C29.2 35.1 26.7 36 24 36c-5.2 0-9.6-3.3-11.3-7.9l-6.5 5C9.5 39.6 16.2 44 24 44z"/>
                  <path fill="#1976D2" d="M43.6 20.5H42V20H24v8h11.3c-.8 2.2-2.2 4.2-4.1 5.6l6.2 5.2C37 39.2 44 34 44 24c0-1.3-.1-2.4-.4-3.5z"/>
                </svg>
                {creating ? 'Sign up with Google' : 'Continue with Google'}
              </a>
              {/* Shown in both modes: Google creates the account if there is none yet. */}
              <p class="fh" style="margin-top:10px;text-align:center;">
                By continuing with Google you accept the <a href="/pages/terms" target="_blank" rel="noopener" style="color:var(--champagne-2);">terms</a>
                {' '}and <a href="/pages/privacy" target="_blank" rel="noopener" style="color:var(--champagne-2);">privacy policy</a>.
              </p>
              <p class="fh" style="text-align:center;margin:18px 0;">or with your email</p>
            </Fragment>
          )}

          <form method="post" class="cform" novalidate>
            <input type="hidden" name="mode" value={mode} />
            {next && <input type="hidden" name="next" value={next} />}
            <input type="text" name={HONEYPOT} tabindex="-1" autocomplete="off" class="visually-hidden" aria-hidden="true" />

            {creating && (
              <label>
                <span class="fl">Your name<span class="rq" aria-hidden="true">*</span></span>
                <input class="fi" id="f-name" type="text" name="name" required minlength="2" maxlength="120" autocomplete="name"
                       value={values.name} aria-invalid={errors.name ? 'true' : undefined} />
                {errors.name && <span class="cform-err" role="alert">{errors.name}</span>}
              </label>
            )}

            <label>
              <span class="fl">Work email<span class="rq" aria-hidden="true">*</span></span>
              <input class="fi" id="f-email" type="email" name="email" required autocomplete="email"
                     value={values.email} aria-invalid={errors.email ? 'true' : undefined} />
              {errors.email && <span class="cform-err" role="alert">{errors.email}</span>}
            </label>

            <label>
              <span class="fl">Password<span class="rq" aria-hidden="true">*</span></span>
              <input class="fi" id="f-password" type="password" name="password" required
                     autocomplete={creating ? 'new-password' : 'current-password'}
                     aria-invalid={errors.password ? 'true' : undefined} />
              {errors.password
                ? <span class="cform-err" role="alert">{errors.password}</span>
                : creating && <span class="fh">At least 10 characters. Length matters more than symbols.</span>}
            </label>

            {creating && (
              <>
                <div class="row2" style="display:grid;grid-template-columns:1fr 1fr;gap:14px;">
                  <label>
                    <span class="fl">Country</span>
                    <input class="fi" type="text" name="country" autocomplete="country-name" />
                  </label>
                  <label>
                    <span class="fl">Timezone</span>
                    <input class="fi" id="f-timezone" type="text" name="timezone" placeholder="Detected automatically" />
                  </label>
                </div>

                <label class="opt" id="f-terms" style="width:100%;">
                  <input type="checkbox" name="terms" value="on" required />
                  <span>I accept the <a href="/pages/terms" target="_blank" rel="noopener" style="color:var(--champagne-2);">terms</a>{' '}
                    and <a href="/pages/privacy" target="_blank" rel="noopener" style="color:var(--champagne-2);">privacy policy</a>.</span>
                </label>
                {errors.terms && <span class="cform-err" role="alert">{errors.terms}</span>}
              </>
            )}

            <button type="submit" class="btn-hot" style="width:100%;margin-top:6px;">
              {creating ? 'Create account' : 'Sign in'}
            </button>
          </form>

          <div class="row-sm" style="justify-content:space-between;margin-top:20px;">
            <a href={otherModeUrl} class="link-t">
              {creating ? 'I already have an account' : 'Create an account'}
            </a>
            {!creating && (
              <a href="/sign-in/forgot" class="link-t" style="color:var(--ink-5);">Forgot password?</a>
            )}
          </div>
        </div>

        <p class="fh" style="text-align:center;margin-top:20px;">
          Looking to hire our team instead? <a href="/#contact" style="color:var(--champagne-2);">Start a project</a> — no account needed.
        </p>
      </div>
    </div>
  </section>

  <script is:inline>
    /* Fill the timezone field from the browser so nobody has to know theirs. */
    (function () {
      var field = document.getElementById('f-timezone');
      if (!field || field.value) return;
      try { field.value = Intl.DateTimeFormat().resolvedOptions().timeZone || ''; } catch (e) {}
    })();
  </script>
</Night>
