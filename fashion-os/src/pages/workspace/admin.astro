---
/**
 * /workspace/admin — internal operations (plan §10).
 *
 * Built fresh; nothing from the legacy marketplace admin is reused. Guarded by
 * `requireAdmin`, which returns 404 rather than a redirect so the route's
 * existence is not discoverable by a non-admin.
 *
 * Every action here writes an audit_logs entry (§10, §13).
 */
export const prerender = false;

import Night from '../../layouts/Night.astro';
import { all, db, one, run } from '../../server/db';
import { guard, requireAdmin } from '../../server/guards';
import { handleFromName, newId, nowIso } from '../../server/ids';
import { audit, notify } from '../../server/audit';
import { parse } from '../../server/validate';
import { AVAILABILITY, PROJECT_SIZE, RATE_MODEL, WORK_LOCATION, getService } from '../../data/taxonomy';
import { projectStatusForCompany, statusTone } from '../../data/labels';
import { loadApplicationsForReview } from '../../server/repo/specialists';

const gate = await guard(Astro, () => requireAdmin(Astro));
if (gate.response) return gate.response;
const admin = gate.value;

const database = db(Astro);
let flash: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const { f } = parse(form);
  const now = nowIso();

  // ---------- profile review ----------
  if (['approve', 'needs_changes', 'reject', 'pause'].includes(action)) {
    const profileId = String(form.get('profileId') ?? '');
    const notes = f.text('notes', 'Notes', { max: 2000 });
    const profile = await one<{ id: string; user_id: string; handle: string | null; name: string }>(
      database,
      'SELECT p.id, p.user_id, p.handle, u.name FROM specialist_profiles p JOIN users u ON u.id = p.user_id WHERE p.id = ?',
      profileId,
    );

    if (profile) {
      const nextStatus =
        action === 'approve' ? 'approved' : action === 'pause' ? 'paused' : action === 'reject' ? 'draft' : 'needs_changes';

      // A public handle is minted once, at first approval, and never changes —
      // an approved profile URL must keep working.
      let handle = profile.handle;
      if (action === 'approve' && !handle) {
        const base = handleFromName(profile.name);
        handle = base;
        for (let n = 2; n < 50; n++) {
          const clash = await one<{ id: string }>(database, 'SELECT id FROM specialist_profiles WHERE handle = ?', handle);
          if (!clash) break;
          handle = `${base}-${n}`;
        }
      }

      await run(
        database,
        `UPDATE specialist_profiles
            SET status = ?, handle = ?, approved_at = COALESCE(approved_at, ?), updated_at = ?
          WHERE id = ?`,
        nextStatus,
        handle,
        action === 'approve' ? now : null,
        now,
        profile.id,
      );
      await run(
        database,
        'INSERT INTO verification_reviews (id, profile_id, reviewer_id, decision, notes, created_at) VALUES (?, ?, ?, ?, ?, ?)',
        newId(), profile.id, admin.id,
        action === 'approve' ? 'approved' : action === 'pause' ? 'paused' : action === 'reject' ? 'rejected' : 'needs_changes',
        notes || null, now,
      );
      await notify(database, {
        userId: profile.user_id,
        kind: 'profile_review',
        title:
          action === 'approve' ? 'Your profile is approved' :
          action === 'pause' ? 'Your profile has been paused' :
          action === 'reject' ? 'Your application needs rework' : 'A few changes are needed',
        body: notes || undefined,
        link: '/workspace/freelancer',
      });
      await audit(database, {
        actorId: admin.id,
        action: action === 'approve' ? 'profile.approved' : action === 'pause' ? 'profile.paused'
              : action === 'reject' ? 'profile.rejected' : 'profile.needs_changes',
        entityType: 'specialist_profile', entityId: profile.id, detail: { notes }, request: Astro.request,
      });
      flash = `Profile ${nextStatus.replace('_', ' ')}.`;
    }
  }

  // ---------- direct-service enquiries ----------
  if (action === 'lead_status') {
    const leadId = String(form.get('leadId') ?? '');
    const next = String(form.get('status') ?? 'contacted');
    if (['new', 'contacted', 'quoted', 'won', 'lost'].includes(next)) {
      await run(database, 'UPDATE leads SET status = ? WHERE id = ?', next, leadId);
      flash = `Enquiry marked ${next}.`;
    }
  }

  // ---------- feature or pause an already-approved specialist (§10) ----------
  if (action === 'feature' || action === 'unfeature' || action === 'pause_live' || action === 'relist') {
    const profileId = String(form.get('profileId') ?? '');
    if (action === 'feature' || action === 'unfeature') {
      await run(database, 'UPDATE specialist_profiles SET featured = ?, updated_at = ? WHERE id = ?',
        action === 'feature' ? 1 : 0, now, profileId);
      flash = action === 'feature' ? 'Featured — they now sort to the top of the directory.' : 'No longer featured.';
    } else {
      const next = action === 'pause_live' ? 'paused' : 'approved';
      await run(database, 'UPDATE specialist_profiles SET status = ?, updated_at = ? WHERE id = ?', next, now, profileId);
      flash = next === 'paused' ? 'Paused — hidden from the directory and from matching.' : 'Back in the directory.';
      await audit(database, {
        actorId: admin.id, action: next === 'paused' ? 'profile.paused' : 'profile.approved',
        entityType: 'specialist_profile', entityId: profileId, request: Astro.request,
      });
    }
  }

  // ---------- moderate a live project (§10) ----------
  if (action === 'close_project') {
    const projectId = String(form.get('projectId') ?? '');
    await run(database, "UPDATE projects SET status = 'closed', updated_at = ? WHERE id = ?", now, projectId);
    await audit(database, {
      actorId: admin.id, action: 'project.closed', entityType: 'project', entityId: projectId,
      detail: { reason: f.text('reason', 'Reason', { max: 500 }) }, request: Astro.request,
    });
    flash = 'Project closed. It no longer appears to specialists.';
  }

  // ---------- recommend a specialist to a posted project by hand (§10) ----------
  if (action === 'recommend') {
    const projectId = String(form.get('projectId') ?? '');
    const profileId = String(form.get('profileId') ?? '');
    const project = await one<{ id: string; title: string; service_id: string }>(
      database, 'SELECT id, title, service_id FROM projects WHERE id = ?', projectId,
    );
    const owner = await one<{ user_id: string }>(
      database, "SELECT user_id FROM specialist_profiles WHERE id = ? AND status = 'approved'", profileId,
    );
    if (project && owner) {
      await run(
        database,
        `INSERT INTO project_invites (id, project_id, profile_id, reason, status, created_at)
         VALUES (?, ?, ?, ?, 'sent', ?)
         ON CONFLICT (project_id, profile_id) DO UPDATE SET reason = excluded.reason`,
        newId(), project.id, profileId,
        'Recommended by the Fashion Freelancing team after reading the brief.', now,
      );
      await notify(database, {
        userId: owner.user_id, kind: 'project_invite',
        title: `We think this suits you: ${project.title}`,
        body: 'Our team matched you to this brief by hand.', link: '/projects',
      });
      flash = 'Recommended. They have been told and can see the brief.';
    }
  }

  // ---------- taxonomy normalization (§5) ----------
  if (['tag_approve', 'tag_merge', 'tag_reject'].includes(action)) {
    const table = String(form.get('table') ?? '') === 'tools' ? 'tools' : 'skills';
    const tagId = String(form.get('tagId') ?? '');
    const mergeInto = String(form.get('mergeInto') ?? '');

    if (action === 'tag_approve') {
      await run(database, `UPDATE ${table} SET status = 'approved' WHERE id = ?`, tagId);
      flash = 'Tag approved — it is now a public filter.';
    } else if (action === 'tag_merge' && mergeInto) {
      await run(database, `UPDATE ${table} SET status = 'merged', merged_into = ? WHERE id = ?`, mergeInto, tagId);
      flash = 'Tag merged. Profiles using it now display the canonical name.';
    } else if (action === 'tag_reject') {
      await run(database, `UPDATE ${table} SET status = 'rejected' WHERE id = ?`, tagId);
      flash = 'Tag rejected.';
    }
    await audit(database, {
      actorId: admin.id,
      action: action === 'tag_approve' ? 'taxonomy.tag_approved' : action === 'tag_merge' ? 'taxonomy.tag_merged' : 'taxonomy.tag_rejected',
      entityType: table, entityId: tagId, detail: { mergeInto }, request: Astro.request,
    });
  }

  // ---------- portfolio moderation ----------
  if (action === 'portfolio_approve' || action === 'portfolio_reject') {
    const itemId = String(form.get('itemId') ?? '');
    await run(
      database, 'UPDATE portfolio_items SET moderation = ? WHERE id = ?',
      action === 'portfolio_approve' ? 'approved' : 'rejected', itemId,
    );
    await audit(database, {
      actorId: admin.id, action: 'portfolio.moderated', entityType: 'portfolio_item', entityId: itemId,
      detail: { decision: action }, request: Astro.request,
    });
    flash = action === 'portfolio_approve' ? 'Portfolio item approved.' : 'Portfolio item rejected.';
  }
}

const [pending, pendingSkills, pendingTools, pendingPortfolio, leads, live, projects, mailQueue, recentAudit, counts] =
  await Promise.all([
    loadApplicationsForReview(database),
    all<{ id: string; name: string; service_id: string | null }>(
      database, "SELECT id, name, service_id FROM skills WHERE status = 'pending' ORDER BY created_at",
    ),
    all<{ id: string; name: string; service_id: string | null }>(
      database, "SELECT id, name, service_id FROM tools WHERE status = 'pending' ORDER BY created_at",
    ),
    all<{ id: string; title: string; contribution: string; name: string; media_key: string | null; external_url: string | null }>(
      database,
      `SELECT pi.id, pi.title, pi.contribution, u.name, pi.media_key, pi.external_url
         FROM portfolio_items pi
         JOIN specialist_profiles p ON p.id = pi.profile_id
         JOIN users u ON u.id = p.user_id
        WHERE pi.moderation = 'pending' ORDER BY pi.created_at LIMIT 30`,
    ),
    all<{
      id: string; name: string; email: string; company: string | null; service: string | null;
      message: string; timeline: string | null; source: string; status: string; created_at: string;
    }>(
      database,
      `SELECT id, name, email, company, service, message, timeline, source, status, created_at
         FROM leads ORDER BY (status = 'new') DESC, created_at DESC LIMIT 50`,
    ),
    all<{ id: string; handle: string | null; name: string; headline: string | null; featured: number; status: string; service_id: string | null }>(
      database,
      `SELECT p.id, p.handle, u.name, p.headline, p.featured, p.status,
              (SELECT o.service_id FROM specialist_service_offerings o
                WHERE o.profile_id = p.id ORDER BY o.is_primary DESC LIMIT 1) AS service_id
         FROM specialist_profiles p JOIN users u ON u.id = p.user_id
        WHERE p.status IN ('approved','paused')
        ORDER BY p.featured DESC, u.name`,
    ),
    all<{ id: string; title: string; status: string; company_name: string; service_id: string; applicants: number }>(
      database,
      `SELECT p.id, p.title, p.status, c.name AS company_name, p.service_id,
              (SELECT COUNT(*) FROM applications a WHERE a.project_id = p.id) AS applicants
         FROM projects p JOIN companies c ON c.id = p.company_id
        WHERE p.status != 'draft' ORDER BY p.created_at DESC LIMIT 20`,
    ),
    all<{ id: string; to_email: string; subject: string; body: string; status: string; created_at: string }>(
      database,
      "SELECT id, to_email, subject, body, status, created_at FROM outbound_email WHERE status = 'queued' ORDER BY created_at DESC LIMIT 10",
    ),
    all<{ action: string; entity_type: string; entity_id: string; created_at: string; actor: string | null }>(
      database,
      `SELECT a.action, a.entity_type, a.entity_id, a.created_at, u.name AS actor
         FROM audit_logs a LEFT JOIN users u ON u.id = a.actor_id
        ORDER BY a.created_at DESC LIMIT 20`,
    ),
    one<{ approved: number; companies: number; projects: number; engagements: number }>(
      database,
      `SELECT
        (SELECT COUNT(*) FROM specialist_profiles WHERE status = 'approved') AS approved,
        (SELECT COUNT(*) FROM companies) AS companies,
        (SELECT COUNT(*) FROM projects WHERE status != 'draft') AS projects,
        (SELECT COUNT(*) FROM engagements WHERE status = 'active') AS engagements`,
    ),
  ]);

/** Merge targets offered next to a pending tag: the approved tags in its service. */
const approvedTags = await all<{ id: string; name: string; service_id: string | null; kind: string }>(
  database,
  `SELECT id, name, service_id, 'skills' AS kind FROM skills WHERE status = 'approved'
   UNION ALL
   SELECT id, name, service_id, 'tools' AS kind FROM tools WHERE status = 'approved'
   ORDER BY name`,
);
const mergeTargets = (kind: 'skills' | 'tools', serviceId: string | null) =>
  approvedTags.filter((tag) => tag.kind === kind && tag.service_id === serviceId);

/* An audit log is only useful if a human can read it. `profile.needs_changes`
   tells an operator nothing at a glance; "asked a specialist for changes" does. */
const ACTION_TEXT: Record<string, string> = {
  'user.signed_up': 'created an account',
  'user.signed_in': 'signed in',
  'user.email_verified': 'confirmed their email',
  'user.password_reset': 'reset their password',
  'company.created': 'set up a company',
  'company.member_added': 'added someone to a company',
  'profile.created': 'started an application',
  'profile.submitted': 'submitted an application for review',
  'profile.approved': 'approved a specialist',
  'profile.needs_changes': 'asked a specialist for changes',
  'profile.rejected': 'rejected an application',
  'profile.paused': 'paused a specialist',
  'taxonomy.tag_proposed': 'proposed a new tag',
  'taxonomy.tag_approved': 'approved a tag',
  'taxonomy.tag_merged': 'merged a duplicate tag',
  'taxonomy.tag_rejected': 'rejected a tag',
  'portfolio.moderated': 'moderated a portfolio piece',
  'project.published': 'published a project',
  'project.closed': 'closed a project',
  'hire_request.sent': 'sent a hire request',
  'hire_request.answered': 'answered a hire request',
  'engagement.created': 'started an engagement',
  'engagement.completed': 'completed an engagement',
  'payment.recorded': 'recorded a payment',
};
const describeAction = (action: string): string => ACTION_TEXT[action] ?? action.replace(/[._]/g, ' ');

/** "20 Aug, 14:32" beats a raw ISO string for someone scanning a list. */
function shortTime(iso: string): string {
  const at = new Date(iso);
  if (Number.isNaN(at.getTime())) return iso;
  return at.toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
}
---

<Night title="Operations — Fashion Freelancing" noindex current="" quoteBot={false}>
  <section class="net-hero" style="padding-bottom:calc(var(--u) * 2);">
    <div class="wrap">
      <div class="ws-head">
        <div>
          <span class="kicker">Internal only</span>
          <h1 style="margin-top:12px;">Operations.</h1>
        </div>
        <form method="post" action="/api/sign-out">
          <button type="submit" class="btn-glass btn-sm">Sign out</button>
        </form>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;">
    <div class="wrap">
      {flash && <div class="notice ok" style="margin-bottom:22px;">{flash}</div>}

      <div class="ws-stats">
        <div class="ws-stat glass-p"><b>{counts?.approved ?? 0}</b><span>Approved specialists</span></div>
        <div class="ws-stat glass-p"><b>{leads.filter((l) => l.status === 'new').length}</b><span>New enquiries</span></div>
        <div class="ws-stat glass-p"><b>{pending.length}</b><span>Awaiting review</span></div>
        <div class="ws-stat glass-p"><b>{counts?.projects ?? 0}</b><span>Projects posted</span></div>
        <div class="ws-stat glass-p"><b>{counts?.engagements ?? 0}</b><span>Jobs in progress</span></div>
      </div>

      <!-- ---------- direct-service enquiries: the main business ---------- -->
      <div class="panel glass-p">
        <h2>Project enquiries ({leads.filter((l) => l.status === 'new').length} new)</h2>
        {leads.length === 0 ? (
          <p>Nothing yet. Enquiries from the homepage, the service pages and the quote bot land here.</p>
        ) : (
          <div class="ws-list">
            {leads.map((lead) => (
              <article class="ws-row" style="display:block;border:1px solid var(--line);border-radius:16px;">
                <div class="row-sm" style="justify-content:space-between;align-items:flex-start;">
                  <div>
                    <h3>{lead.name}{lead.company ? ` · ${lead.company}` : ''}</h3>
                    <div class="line">
                      <span>{lead.email}</span>
                      {lead.service && <span>{getService(lead.service)?.name ?? lead.service}</span>}
                      {lead.timeline && <span>{lead.timeline}</span>}
                      <span>{lead.source === 'quote-bot' ? 'Quote bot' : 'Contact form'}</span>
                      <span>{shortTime(lead.created_at)}</span>
                    </div>
                  </div>
                  <span class={`pill-status ${lead.status === 'new' ? 'warn' : lead.status === 'won' ? 'ok' : lead.status === 'lost' ? 'bad' : 'info'}`}>
                    {lead.status}
                  </span>
                </div>
                <p style="margin:12px 0 0;color:var(--ink-4);font-size:14px;line-height:1.6;white-space:pre-wrap;">{lead.message}</p>
                <form method="post" class="ws-row-actions" style="margin-top:14px;">
                  <input type="hidden" name="leadId" value={lead.id} />
                  <a class="btn-glass btn-sm" href={`mailto:${lead.email}`}>Reply by email</a>
                  <input type="hidden" name="action" value="lead_status" />
                  {(['contacted', 'quoted', 'won', 'lost'] as const).map((next) => (
                    <button class="btn-glass btn-sm" name="status" value={next}>
                      {next[0]!.toUpperCase() + next.slice(1)}
                    </button>
                  ))}
                </form>
              </article>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- applications: the whole submission, not a summary ---------- -->
      <div class="panel glass-p">
        <h2>Freelancer applications</h2>
        {pending.length === 0 ? (
          <p>Nothing waiting. Submitted applications land here.</p>
        ) : (
          <div class="ws-list">
            {pending.map((app) => {
              const availability = AVAILABILITY.find((a) => a.id === app.availability)?.name;
              const workLocation = WORK_LOCATION.find((w) => w.id === app.workLocation)?.name;
              const size = PROJECT_SIZE.find((x) => x.id === app.preferredSize)?.name;
              const charges = app.rateModel
                .map((id) => RATE_MODEL.find((r) => r.id === id)?.name)
                .filter(Boolean).join(', ');
              const rate = app.rateMin
                ? app.rateMax && app.rateMax !== app.rateMin
                  ? `${app.rateCurrency} ${app.rateMin}–${app.rateMax}`
                  : `From ${app.rateCurrency} ${app.rateMin}`
                : null;
              const terms = [availability, rate, charges, workLocation, size, app.turnaround].filter(Boolean);
              return (
                <article class="review">
                  <header class="review-head">
                    <div>
                      <h3>{app.name}</h3>
                      <div class="line">
                        <span>{app.email}</span>
                        {app.location && <span>{app.location}</span>}
                        {app.yearsExperience !== null && <span>{app.yearsExperience} years</span>}
                        {app.languages.length > 0 && <span>{app.languages.join(', ')}</span>}
                      </div>
                    </div>
                    <span class={`pill-status ${app.status === 'needs_changes' ? 'warn' : 'info'}`}>
                      {app.status === 'needs_changes' ? 'changes requested' : 'awaiting review'}
                    </span>
                  </header>

                  {app.headline && <p class="review-headline">{app.headline}</p>}

                  {app.bio && (
                    <div class="review-block">
                      <h4>In their words</h4>
                      {app.bioLines.map((line) => <p>{line}</p>)}
                    </div>
                  )}

                  {app.offerings.map((offering) => (
                    <div class="review-block">
                      <h4>
                        {offering.serviceName}
                        {offering.isPrimary && <span class="pill-status info" style="margin-left:8px;">main</span>}
                        {offering.roleName && <span class="pill-status" style="margin-left:8px;">{offering.roleName}</span>}
                      </h4>
                      {offering.specialties.length > 0 && <p class="review-tags"><b>Specialties</b> {offering.specialties.join(' · ')}</p>}
                      {offering.skills.length > 0 && <p class="review-tags"><b>Skills</b> {offering.skills.join(' · ')}</p>}
                      {offering.tools.length > 0 && <p class="review-tags"><b>Tools</b> {offering.tools.join(' · ')}</p>}
                      {offering.stack.length > 0 && <p class="review-tags"><b>Stack</b> {offering.stack.join(' · ')}</p>}
                    </div>
                  ))}

                  <div class="review-block">
                    <h4>Working terms</h4>
                    <p class="review-tags">{terms.length ? terms.join('  ·  ') : 'Not stated'}</p>
                  </div>

                  <div class="review-block">
                    <h4>Portfolio ({app.portfolio.length})</h4>
                    {app.portfolio.length === 0 ? (
                      <p class="review-tags">Nothing attached — this cannot go public as it stands.</p>
                    ) : (
                      <div class="review-work">
                        {app.portfolio.map((item) => (
                          <div class="review-piece">
                            <strong>{item.title}</strong>
                            <p>{item.contribution}</p>
                            <div class="row-sm" style="margin-top:8px;">
                              {item.mediaKey && (
                                <a class="btn-glass btn-sm" href={`/api/files/${item.mediaKey}`} target="_blank" rel="noopener">Open file</a>
                              )}
                              {item.externalUrl && (
                                <a class="btn-glass btn-sm" href={item.externalUrl} target="_blank" rel="noopener nofollow">Open link ↗</a>
                              )}
                              <span class={`pill-status ${item.moderation === 'approved' ? 'ok' : item.moderation === 'rejected' ? 'bad' : ''}`}>
                                {item.moderation}
                              </span>
                            </div>
                            {item.clientName && <p class="review-tags" style="margin-top:6px;">Client: {item.clientName}</p>}
                          </div>
                        ))}
                      </div>
                    )}
                  </div>

                  {app.lastNote && (
                    <div class="notice" style="margin-top:14px;">
                      <strong>Your last note</strong>
                      <p style="margin:6px 0 0;color:inherit;">{app.lastNote}</p>
                    </div>
                  )}

                  <form method="post" class="cform" style="margin-top:18px;">
                    <input type="hidden" name="profileId" value={app.id} />
                    <label>
                      <span class="fl">Notes to the applicant</span>
                      <textarea class="fi" name="notes" rows="2"
                                placeholder="If you are asking for changes, say exactly what to fix."></textarea>
                      <span class="fh">Sent to them, and kept in the review history.</span>
                    </label>
                    <div class="ws-row-actions">
                      <button class="btn-hot btn-sm" name="action" value="approve" data-busy="Approving…">Approve &amp; publish</button>
                      <button class="btn-glass btn-sm" name="action" value="needs_changes" formnovalidate>Request changes</button>
                      <button class="btn-glass btn-sm" name="action" value="pause" formnovalidate>Pause</button>
                      <button class="btn-glass btn-sm" name="action" value="reject" formnovalidate>Reject</button>
                    </div>
                    <p class="fh" style="margin:0;">Approving mints their public URL and lists them in the directory immediately.</p>
                  </form>
                </article>
              );
            })}
          </div>
        )}
      </div>

      <!-- ---------- taxonomy normalization ---------- -->
      <div class="panel glass-p">
        <h2>Custom skills &amp; tools awaiting normalization</h2>
        {pendingSkills.length + pendingTools.length === 0 ? (
          <p>Nothing pending. Values proposed by freelancers appear here before they become public filters.</p>
        ) : (
          <div class="ws-list">
            {[...pendingSkills.map((t) => ({ ...t, kind: 'skills' as const })),
              ...pendingTools.map((t) => ({ ...t, kind: 'tools' as const }))].map((tag) => (
              <form method="post" class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <input type="hidden" name="tagId" value={tag.id} />
                <input type="hidden" name="table" value={tag.kind} />
                <div>
                  <h3>{tag.name}</h3>
                  <div class="line">
                    <span>{tag.kind === 'skills' ? 'Skill' : 'Tool'}</span>
                    <span>{getService(tag.service_id ?? '')?.name ?? 'No service'}</span>
                  </div>
                  <label style="display:block;margin-top:10px;">
                    <span class="fl">Merge into</span>
                    <select class="fi" name="mergeInto">
                      <option value="">Keep as its own tag</option>
                      {mergeTargets(tag.kind, tag.service_id).map((target) => (
                        <option value={target.id}>{target.name}</option>
                      ))}
                    </select>
                  </label>
                </div>
                <div class="ws-row-actions">
                  <button class="btn-hot btn-sm" name="action" value="tag_approve">Approve</button>
                  <button class="btn-glass btn-sm" name="action" value="tag_merge">Merge</button>
                  <button class="btn-glass btn-sm" name="action" value="tag_reject">Reject</button>
                </div>
              </form>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- portfolio moderation ---------- -->
      {pendingPortfolio.length > 0 && (
        <div class="panel glass-p">
          <h2>Portfolio awaiting moderation</h2>
          <div class="ws-list">
            {pendingPortfolio.map((item) => (
              <form method="post" class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <input type="hidden" name="itemId" value={item.id} />
                <div>
                  <h3>{item.title}</h3>
                  <div class="line"><span>{item.name}</span></div>
                  <p style="margin:8px 0 0;color:var(--ink-4);font-size:13px;line-height:1.55;">{item.contribution}</p>
                  {item.media_key && (
                    <a class="btn-glass btn-sm" href={`/api/files/${item.media_key}`} target="_blank" rel="noopener"
                       style="margin-top:10px;">Open file</a>
                  )}
                  {item.external_url && (
                    <a class="btn-glass btn-sm" href={item.external_url} target="_blank" rel="noopener nofollow"
                       style="margin-top:10px;">Open link ↗</a>
                  )}
                </div>
                <div class="ws-row-actions">
                  <button class="btn-hot btn-sm" name="action" value="portfolio_approve">Approve</button>
                  <button class="btn-glass btn-sm" name="action" value="portfolio_reject">Reject</button>
                </div>
              </form>
            ))}
          </div>
        </div>
      )}

      <!-- ---------- who is live, and how they rank ---------- -->
      <div class="panel glass-p">
        <h2>Live specialists ({live.filter((x) => x.status === 'approved').length})</h2>
        {live.length === 0 ? (
          <p>Nobody is live yet. Approve an application above and they appear here.</p>
        ) : (
          <div class="ws-list">
            {live.map((person) => (
              <div class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <div>
                  <h3>
                    {person.name}
                    {person.featured === 1 && <span class="pill-status ok" style="margin-left:8px;">featured</span>}
                    {person.status === 'paused' && <span class="pill-status warn" style="margin-left:8px;">paused</span>}
                  </h3>
                  <div class="line">
                    <span>{getService(person.service_id ?? '')?.name}</span>
                    {person.headline && <span>{person.headline}</span>}
                  </div>
                </div>
                <div class="ws-row-actions">
                  {person.handle && (
                    <a class="btn-glass btn-sm" href={`/specialists/${person.handle}`} target="_blank" rel="noopener">View</a>
                  )}
                  <form method="post">
                    <input type="hidden" name="profileId" value={person.id} />
                    <button class="btn-glass btn-sm" name="action"
                            value={person.featured === 1 ? 'unfeature' : 'feature'}>
                      {person.featured === 1 ? 'Unfeature' : 'Feature'}
                    </button>
                  </form>
                  <form method="post">
                    <input type="hidden" name="profileId" value={person.id} />
                    <button class="btn-glass btn-sm" name="action"
                            value={person.status === 'paused' ? 'relist' : 'pause_live'}>
                      {person.status === 'paused' ? 'Put back in the directory' : 'Hide from the directory'}
                    </button>
                  </form>
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- projects: moderate, and match by hand ---------- -->
      <div class="panel glass-p">
        <h2>Posted projects</h2>
        {projects.length === 0 ? <p>No projects posted yet.</p> : (
          <div class="ws-list">
            {projects.map((project) => {
              const eligible = live.filter(
                (person) => person.status === 'approved' && person.service_id === project.service_id,
              );
              return (
                <article class="ws-row" style="display:block;border:1px solid var(--line);border-radius:16px;">
                  <div class="row-sm" style="justify-content:space-between;align-items:flex-start;">
                    <div>
                      <h3>{project.title}</h3>
                      <div class="line">
                        <span>{project.company_name}</span>
                        <span>{getService(project.service_id)?.name}</span>
                        <span>{project.applicants} applied</span>
                      </div>
                    </div>
                    <span class={`pill-status ${statusTone(project.status)}`}>{projectStatusForCompany(project.status)}</span>
                  </div>

                  {eligible.length > 0 && project.status !== 'closed' && (
                    <form method="post" class="cform" style="margin-top:14px;">
                      <input type="hidden" name="projectId" value={project.id} />
                      <label>
                        <span class="fl">Recommend someone by hand</span>
                        <select class="fi" name="profileId">
                          {eligible.map((person) => <option value={person.id}>{person.name}</option>)}
                        </select>
                        <span class="fh">They are told, and the brief opens for them — used when matching misses someone.</span>
                      </label>
                      <div class="ws-row-actions">
                        <button class="btn-hot btn-sm" name="action" value="recommend">Recommend</button>
                      </div>
                    </form>
                  )}

                  {project.status !== 'closed' && (
                    <form method="post" class="cform" style="margin-top:12px;">
                      <input type="hidden" name="projectId" value={project.id} />
                      <label>
                        <span class="fl">Close this project</span>
                        <input class="fi" type="text" name="reason" maxlength="500"
                               placeholder="Why — kept in the audit history" />
                      </label>
                      <div class="ws-row-actions">
                        <button class="btn-glass btn-sm" name="action" value="close_project" formnovalidate>
                          Close project
                        </button>
                      </div>
                    </form>
                  )}
                </article>
              );
            })}
          </div>
        )}
      </div>

      <!-- ---------- outbound mail ---------- -->
      {mailQueue.length > 0 && (
        <details class="ops-fold">
          <summary>Queued email ({mailQueue.length}) — no mail provider configured</summary>
          <div class="panel glass-p">
          <h2>Queued email</h2>
          <p>
            No mail provider is configured, so verification and reset messages are held here instead of
            being lost. Set <code>RESEND_API_KEY</code> and <code>MAIL_FROM</code> to send them for real.
          </p>
          <div class="ws-list">
            {mailQueue.map((mail) => (
              <div class="ws-row" style="display:block;border:1px solid var(--line);border-radius:16px;">
                <h3>{mail.subject}</h3>
                <div class="line"><span>{mail.to_email}</span><span>{mail.created_at}</span></div>
                <details style="margin-top:10px;">
                  <summary class="fh" style="cursor:pointer;">Show message</summary>
                  <pre style="margin:10px 0 0;white-space:pre-wrap;word-break:break-all;font-family:var(--mono);font-size:11.5px;color:var(--ink-4);line-height:1.6;">{mail.body}</pre>
                </details>
              </div>
            ))}
          </div>
          </div>
        </details>
      )}

      <!-- ---------- audit ---------- -->
      <details class="ops-fold">
        <summary>Recent activity ({recentAudit.length})</summary>
        <div class="panel glass-p">
          <h2>Recent activity</h2>
          <div class="log">
            {recentAudit.map((entry) => (
              <p class="log-row">
                <span><b>{entry.actor ?? 'System'}</b> {describeAction(entry.action)}</span>
                <time datetime={entry.created_at}>{shortTime(entry.created_at)}</time>
              </p>
            ))}
          </div>
        </div>
      </details>
    </div>
  </section>
</Night>
