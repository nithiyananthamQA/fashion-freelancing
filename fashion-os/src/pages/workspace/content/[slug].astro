---
/**
 * /workspace/content/<page> — one page, section by section, every field in
 * reading order. Each section saves on its own. A field left equal to the
 * page's original text is not stored at all, so "Reset" is just that. The
 * page's recent changes sit at the bottom and any of them can be undone.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { db } from '../../../server/db';
import { guard, requireEditor } from '../../../server/guards';
import { adminNav, editorNav } from '../../../data/workspace-nav';
import { fieldsOf, loadOverrides, pageBySlug, recentChanges, saveField, undoChange, type Field } from '../../../server/site-content';

const gate = await guard(Astro, () => requireEditor(Astro));
if (gate.response) return gate.response;
const user = gate.value;

const page = pageBySlug(Astro.params.slug ?? '');
if (!page) return new Response(null, { status: 404 });
const database = db(Astro);

let flash: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const sections = fieldsOf(page, await loadOverrides(Astro, page));
  const byKey = new Map<string, Field>(sections.flatMap((s) => s.fields.map((f) => [f.key, f])));
  if (action === 'save') {
    const sectionId = String(form.get('section') ?? '');
    let saved = 0, reset = 0;
    for (const f of sections.find((s) => s.id === sectionId)?.fields ?? []) {
      const raw = f.kind === 'image'
        ? JSON.stringify({ src: form.get(`src:${f.key}`) ?? '', alt: form.get(`alt:${f.key}`) ?? '' })
        : form.get(`f:${f.key}`);
      if (raw === null) continue;
      const r = await saveField(Astro, page, f, String(raw), user.id);
      if (r === 'saved') saved++; if (r === 'reset') reset++;
    }
    flash = saved || reset ? `Saved — ${saved} change${saved === 1 ? '' : 's'}${reset ? `, ${reset} put back to the original` : ''}. It is live now.` : 'Nothing changed.';
  } else if (action === 'reset') {
    const f = byKey.get(String(form.get('key') ?? ''));
    if (f) { await saveField(Astro, page, f, '', user.id); flash = `${f.label} is back to the original.`; }
  } else if (action === 'undo') {
    flash = (await undoChange(Astro, page, String(form.get('change') ?? ''), user.id)) ? 'Undone.' : 'That change is no longer there.';
  }
}

const sections = fieldsOf(page, await loadOverrides(Astro, page));
const changes = await recentChanges(Astro, page);
const edited = sections.reduce((n, s) => n + s.fields.filter((f) => f.value !== null).length, 0);
const img = (f: Field) => { try { return JSON.parse(f.value ?? f.original) as { src: string; alt: string }; } catch { return { src: '', alt: '' }; } };
const short = (s: string | null) => (s === null ? '— original —' : s.replace(/<[^>]+>/g, '').slice(0, 70) + (s.length > 70 ? '…' : ''));
const when = (iso: string) => new Date(iso).toLocaleString('en-GB', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });
const multiline = (f: Field) => f.kind === 'html' || ['text', 'item', 'caption'].some((k) => f.key.includes(`.${k}-`));
---
<Workspace title={`Edit — ${page.title}`} role={user.isAdmin ? 'admin' : 'editor'} current="/workspace/content"
  items={user.isAdmin ? adminNav() : editorNav()} who={user.name} heading={page.title}
  lede={`${sections.length} sections · ${edited} field${edited === 1 ? '' : 's'} changed from the original.`} flash={flash}>

  <p class="cms-top"><a href="/workspace/content">← All pages</a> · <a href={page.path} target="_blank" rel="noopener">View the live page ↗</a></p>
  {/* Reset buttons live inside the section forms but submit this one, so a
      reset can never be mistaken for a save. */}
  <form method="post" id="cms-reset"><input type="hidden" name="action" value="reset" /></form>

  <nav class="cms-index ws-card" aria-label="Sections on this page">
    <span class="cms-index-title">Jump to a section</span>
    {sections.map((s) => { const n = s.fields.filter((f) => f.value !== null).length; return (
      <a href={`#s-${s.id}`}>{s.label}{n > 0 && <em>{n}</em>}</a>
    ); })}
  </nav>

  {sections.map((s) => (
    <details class="cms-section ws-card" id={`s-${s.id}`} open>
      <summary class="cms-section-title">{s.label}<span class="cms-count">{s.fields.length} field{s.fields.length === 1 ? '' : 's'}{s.fields.some((f) => f.value !== null) && ' · edited'}</span></summary>
    <form method="post" class="cms-form">
      <input type="hidden" name="action" value="save" />
      <input type="hidden" name="section" value={s.id} />
      {s.fields.map((f) => (
        <div class={`cms-field${f.value !== null ? ' is-changed' : ''}`}>
          <div class="cms-field-head">
            <span class="cms-label">{f.label}{f.value !== null && <em>edited</em>}</span>
            {f.value !== null && <button type="submit" class="cms-reset" form="cms-reset" name="key" value={f.key}>Reset</button>}
          </div>
          {f.kind === 'image' ? (
            <div class="cms-image">
              <img src={img(f).src} alt="" class="cms-preview" />
              <div class="cms-image-controls">
                <input type="hidden" name={`src:${f.key}`} value={img(f).src} />
                <label class="cms-upload">Replace image <input type="file" accept="image/*" data-upload={f.key} data-page={page.slug} /></label>
                <label class="cms-alt">Alt text <input class="fi" type="text" name={`alt:${f.key}`} value={img(f).alt} /></label>
                <span class="cms-hint">JPG, PNG or WebP, up to 25 MB. Replaces the image everywhere it appears in this slot.</span>
              </div>
            </div>
          ) : f.kind === 'html' ? (
            <div class="cms-richwrap" data-rich>
              <div class="cms-toolbar" hidden>
                <button type="button" data-cmd="bold" title="Bold"><b>B</b></button>
                <button type="button" data-cmd="italic" title="Italic"><i>I</i></button>
                <button type="button" data-cmd="highlight" title="Highlight in the accent colour"><span class="cms-hl">Highlight</span></button>
                <button type="button" data-cmd="link" title="Link">Link</button>
                <button type="button" data-cmd="clear" title="Remove formatting from the selection">Plain</button>
              </div>
              <textarea class="fi" name={`f:${f.key}`} rows={Math.min(8, Math.max(2, Math.ceil((f.value ?? f.original).length / 90)))}>{f.value ?? f.original}</textarea>
            </div>
          ) : multiline(f) ? (
            <textarea class="fi" name={`f:${f.key}`} rows={Math.min(8, Math.max(2, Math.ceil((f.value ?? f.original).length / 90)))}>{f.value ?? f.original}</textarea>
          ) : (
            <input class="fi" type="text" name={`f:${f.key}`} value={f.value ?? f.original} />
          )}
          {f.kind === 'html' && <span class="cms-hint">Select words, then Bold, Italic, Highlight or Link. Highlight is the accent colour the page uses.</span>}
        </div>
      ))}
      <div class="cms-actions"><button type="submit" class="btn-hot">Save this section</button></div>
    </form>
    </details>
  ))}

  {changes.length > 0 && (
    <section class="cms-section ws-card">
      <h2 class="cms-section-title">Recent changes</h2>
      <ul class="cms-history">
        {changes.map((c) => (
          <li>
            <div><b>{c.key}</b> — {c.changed_by_name ?? 'someone'}, {when(c.changed_at)}</div>
            <div class="cms-diff"><span>{short(c.old_value)}</span> → <span>{short(c.new_value)}</span></div>
            <form method="post"><input type="hidden" name="action" value="undo" /><input type="hidden" name="change" value={c.id} /><button type="submit" class="cms-reset">Undo</button></form>
          </li>
        ))}
      </ul>
    </section>
  )}
</Workspace>

<script>
  // Rich text for fields that carry inline markup. The textarea stays the
  // real form field; an editable box mirrors it, so no JavaScript still works.
  document.querySelectorAll<HTMLElement>('[data-rich]').forEach((wrap) => {
    const ta = wrap.querySelector<HTMLTextAreaElement>('textarea')!;
    const bar = wrap.querySelector<HTMLElement>('.cms-toolbar')!;
    const box = document.createElement('div');
    box.className = 'fi cms-rich'; box.contentEditable = 'true'; box.innerHTML = ta.value;
    ta.hidden = true; bar.hidden = false; wrap.appendChild(box);
    const sync = () => { ta.value = box.innerHTML; ta.dispatchEvent(new Event('input', { bubbles: true })); };
    box.addEventListener('input', sync);
    box.addEventListener('paste', (e) => { e.preventDefault(); document.execCommand('insertText', false, e.clipboardData?.getData('text/plain') ?? ''); });
    bar.querySelectorAll<HTMLButtonElement>('button[data-cmd]').forEach((btn) => btn.addEventListener('click', () => {
      box.focus();
      const cmd = btn.dataset.cmd;
      if (cmd === 'bold' || cmd === 'italic') document.execCommand(cmd);
      else if (cmd === 'clear') document.execCommand('removeFormat');
      else if (cmd === 'link') { const url = prompt('Link to (https://…)'); if (url) document.execCommand('createLink', false, url); }
      else if (cmd === 'highlight') {
        const sel = window.getSelection(); const text = sel?.toString();
        if (text) document.execCommand('insertHTML', false, `<span class="acc-t">${text.replace(/[&<>]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c] as string))}</span>`);
      }
      sync();
    }));
  });

  // Leaving with unsaved edits asks first; saving clears the flag.
  let dirty = false;
  document.querySelectorAll<HTMLFormElement>('form.cms-form').forEach((form) => {
    form.addEventListener('input', () => { dirty = true; });
    form.addEventListener('submit', () => { dirty = false; });
  });
  window.addEventListener('beforeunload', (e) => { if (dirty) { e.preventDefault(); e.returnValue = ''; } });

  // Replace-image: upload to R2 through the site, then point the field at the new URL.
  document.querySelectorAll<HTMLInputElement>('input[data-upload]').forEach((input) => {
    input.addEventListener('change', async () => {
      const file = input.files?.[0]; if (!file) return;
      const field = input.closest('.cms-field')!;
      const hidden = field.querySelector<HTMLInputElement>('input[type=hidden][name^="src:"]')!;
      const preview = field.querySelector<HTMLImageElement>('.cms-preview')!;
      const hint = field.querySelector<HTMLElement>('.cms-hint')!;
      hint.textContent = 'Uploading…';
      const body = new FormData(); body.append('file', file); body.append('page', input.dataset.page!); body.append('key', input.dataset.upload!);
      const res: { ok: boolean; url?: string; error?: string } = await fetch('/api/site-media', { method: 'POST', body }).then((r) => r.json() as Promise<{ ok: boolean; url?: string; error?: string }>).catch(() => ({ ok: false, error: 'Upload failed.' }));
      if (!res.ok) { hint.textContent = res.error || 'Upload failed.'; return; }
      hidden.value = res.url ?? ''; preview.src = res.url ?? ''; field.classList.add('is-changed');
      hint.textContent = 'Uploaded — save this section to make it live.';
    });
  });
</script>

<style>
  .cms-top { font-size: 13.5px; color: var(--ink-4); margin: 0 0 16px; }
  .cms-index { display: flex; flex-wrap: wrap; gap: 8px; align-items: center; padding: 14px 18px; margin-bottom: 16px; }
  .cms-index-title { font-family: var(--mono); font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--ink-5); margin-right: 6px; }
  .cms-index a { font-size: 13px; padding: 5px 11px; border: 1px solid var(--line-2); border-radius: 999px; color: var(--ink-3); text-decoration: none; }
  .cms-index a:hover { border-color: var(--champagne); color: var(--ink); }
  .cms-index a em { font-style: normal; margin-left: 6px; font-family: var(--mono); font-size: 10.5px; color: var(--champagne-3); }
  .cms-section { padding: 18px 22px 18px; margin-bottom: 16px; }
  .cms-section-title { font-family: var(--disp); font-size: 17px; font-weight: 700; margin: 0; padding: 4px 0; display: flex; align-items: baseline; gap: 10px; cursor: pointer; list-style: none; }
  .cms-section-title::-webkit-details-marker { display: none; }
  .cms-section-title::before { content: '▾'; font-size: 13px; color: var(--ink-5); }
  details:not([open]) > .cms-section-title::before { content: '▸'; }
  .cms-form { margin-top: 10px; }
  .cms-toolbar { display: flex; gap: 6px; margin-bottom: 6px; }
  .cms-toolbar button { border: 1px solid var(--line-2); background: var(--paper-3); border-radius: 8px; padding: 4px 10px; font-size: 12.5px; cursor: pointer; color: var(--ink-3); }
  .cms-toolbar button:hover { border-color: var(--champagne); color: var(--ink); }
  .cms-hl { color: var(--champagne-3); font-weight: 600; }
  .cms-rich { min-height: 44px; padding: 10px 12px; line-height: 1.5; }
  .cms-rich .acc-t { color: var(--champagne-3); font-weight: 600; }
  .cms-rich a { color: var(--champagne-3); text-decoration: underline; }
  .cms-count { font-family: var(--mono); font-size: 11px; letter-spacing: .08em; color: var(--ink-5); font-weight: 400; }
  .cms-field { padding: 12px 0; border-top: 1px solid var(--line); }
  .cms-field.is-changed { box-shadow: inset 3px 0 0 var(--champagne); padding-left: 12px; }
  .cms-field-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6px; }
  .cms-label { font-size: 12.5px; color: var(--ink-4); }
  .cms-label em { font-style: normal; margin-left: 8px; font-family: var(--mono); font-size: 10.5px; letter-spacing: .1em; text-transform: uppercase; color: var(--champagne-3); }
  .cms-reset { background: none; border: 1px solid var(--line-2); border-radius: 999px; padding: 3px 10px; font-size: 12px; color: var(--ink-4); cursor: pointer; }
  .cms-reset:hover { border-color: var(--champagne); color: var(--ink); }
  .cms-field .fi { width: 100%; }
  textarea.fi { resize: vertical; line-height: 1.5; }
  .cms-image { display: grid; grid-template-columns: 180px 1fr; gap: 16px; align-items: start; }
  .cms-preview { width: 180px; height: 120px; object-fit: contain; background: #fff; border: 1px solid var(--line-2); border-radius: 8px; }
  .cms-image-controls { display: grid; gap: 8px; }
  .cms-upload { display: inline-block; padding: 8px 14px; border: 1px solid var(--line-2); border-radius: 999px; font-size: 13px; cursor: pointer; width: max-content; }
  .cms-upload input { display: none; }
  .cms-alt { display: grid; gap: 4px; font-size: 12.5px; color: var(--ink-4); }
  .cms-hint { font-size: 12px; color: var(--ink-5); }
  .cms-actions { margin-top: 14px; }
  .cms-history { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .cms-history li { display: grid; grid-template-columns: 1fr auto; gap: 4px 14px; font-size: 13px; align-items: center; padding: 8px 0; border-top: 1px solid var(--line); }
  .cms-history li form { grid-row: 1 / 3; }
  .cms-diff { grid-column: 1; color: var(--ink-4); font-size: 12.5px; }
  @media (max-width: 640px) { .cms-image { grid-template-columns: 1fr; } }
</style>
