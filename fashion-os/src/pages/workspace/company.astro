---
/**
 * /workspace/company — saved specialists, projects, applicants and engagements
 * (plan §3). Every query is scoped to the caller's own company; there is no
 * path here that reads another company's records (§11).
 */
export const prerender = false;

import Night from '../../layouts/Night.astro';
import { all, db, one, run } from '../../server/db';
import { guard, requireCompany } from '../../server/guards';
import { newId, nowIso } from '../../server/ids';
import { audit, notify } from '../../server/audit';
import { getService } from '../../data/taxonomy';
import {
  applicationStatusLabel, engagementStatusLabel, hireStatusForCompany,
  projectStatusForCompany, statusTone,
} from '../../data/labels';

const gate = await guard(Astro, () => requireCompany(Astro));
if (gate.response) return gate.response;
const { user, companyId } = gate.value;

const database = db(Astro);
let flash: string | null = null;

/* Shortlist / hire actions on an application. Ownership is re-checked here. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const applicationId = String(form.get('applicationId') ?? '');
  const action = String(form.get('action') ?? '');

  const application = await one<{
    id: string; project_id: string; profile_id: string; title: string; owner_user: string;
  }>(
    database,
    `SELECT a.id, a.project_id, a.profile_id, p.title, u.id AS owner_user
       FROM applications a
       JOIN projects p ON p.id = a.project_id
       JOIN specialist_profiles sp ON sp.id = a.profile_id
       JOIN users u ON u.id = sp.user_id
      WHERE a.id = ? AND p.company_id = ?`,
    applicationId, companyId,
  );

  if (application) {
    const now = nowIso();
    if (action === 'shortlist') {
      await run(database, "UPDATE applications SET status = 'shortlisted', updated_at = ? WHERE id = ?", now, application.id);
      await run(database, "UPDATE projects SET status = 'shortlisted', updated_at = ? WHERE id = ?", now, application.project_id);
      await notify(database, {
        userId: application.owner_user, kind: 'shortlisted',
        title: `Shortlisted: ${application.title}`, link: '/workspace/freelancer',
      });
      flash = 'Shortlisted. The specialist has been told.';
    } else if (action === 'hire') {
      const engagementId = newId();
      await database.batch([
        database.prepare("UPDATE applications SET status = 'hired', updated_at = ? WHERE id = ?").bind(now, application.id),
        database.prepare("UPDATE projects SET status = 'hired', updated_at = ? WHERE id = ?").bind(now, application.project_id),
        database.prepare(
          `INSERT INTO engagements (id, company_id, profile_id, project_id, title, status, created_at, updated_at)
           VALUES (?, ?, ?, ?, ?, 'active', ?, ?)`,
        ).bind(engagementId, companyId, application.profile_id, application.project_id, application.title, now, now),
      ]);
      await notify(database, {
        userId: application.owner_user, kind: 'hired',
        title: `You were hired: ${application.title}`, link: '/workspace/freelancer',
      });
      await audit(database, {
        actorId: user.id, action: 'engagement.created', entityType: 'engagement', entityId: engagementId,
        request: Astro.request,
      });
      flash = 'Hired. They have been told, and the project is closed to everyone else.';
    } else if (action === 'decline') {
      await run(database, "UPDATE applications SET status = 'declined', updated_at = ? WHERE id = ?", now, application.id);
      flash = 'Reply declined.';
    }
  }

  // Answer a question the specialist asked on a hire request.
  if (String(form.get('action') ?? '') === 'reply') {
    const requestId = String(form.get('requestId') ?? '');
    const owned = await one<{ id: string; title: string; owner_user: string }>(
      database,
      `SELECT h.id, h.title, u.id AS owner_user
         FROM hire_requests h
         JOIN specialist_profiles p ON p.id = h.profile_id
         JOIN users u ON u.id = p.user_id
        WHERE h.id = ? AND h.company_id = ?`,
      requestId, companyId,
    );
    const body = String(form.get('body') ?? '').trim();
    if (owned && body.length >= 2) {
      await run(
        database,
        'INSERT INTO messages (id, hire_request_id, sender_id, body, created_at) VALUES (?, ?, ?, ?, ?)',
        newId(), owned.id, user.id, body.slice(0, 2000), nowIso(),
      );
      await notify(database, {
        userId: owned.owner_user, kind: 'hire_message',
        title: `Reply about: ${owned.title}`, link: '/workspace/freelancer',
      });
      flash = 'Sent.';
    }
  }
}

const [saved, projects, applications, hireRequests, messages, engagements] = await Promise.all([
  all<{ id: string; handle: string | null; name: string; headline: string | null; service_id: string | null }>(
    database,
    `SELECT p.id, p.handle, u.name, p.headline,
            (SELECT o.service_id FROM specialist_service_offerings o WHERE o.profile_id = p.id ORDER BY o.is_primary DESC LIMIT 1) AS service_id
       FROM saved_specialists s
       JOIN specialist_profiles p ON p.id = s.profile_id
       JOIN users u ON u.id = p.user_id
      WHERE s.company_id = ? AND p.status = 'approved'
      ORDER BY s.created_at DESC`,
    companyId,
  ),
  all<{ id: string; title: string; service_id: string; status: string; applicants: number; invited: number }>(
    database,
    `SELECT p.id, p.title, p.service_id, p.status,
            (SELECT COUNT(*) FROM applications a WHERE a.project_id = p.id) AS applicants,
            (SELECT COUNT(*) FROM project_invites i WHERE i.project_id = p.id) AS invited
       FROM projects p WHERE p.company_id = ? ORDER BY p.created_at DESC`,
    companyId,
  ),
  all<{
    id: string; pitch: string; price: number | null; currency: string | null; timeline: string | null;
    status: string; project_title: string; name: string; handle: string | null;
  }>(
    database,
    `SELECT a.id, a.pitch, a.price, a.currency, a.timeline, a.status,
            p.title AS project_title, u.name, sp.handle
       FROM applications a
       JOIN projects p ON p.id = a.project_id
       JOIN specialist_profiles sp ON sp.id = a.profile_id
       JOIN users u ON u.id = sp.user_id
      WHERE p.company_id = ? AND a.status != 'withdrawn'
      ORDER BY a.created_at DESC`,
    companyId,
  ),
  all<{ id: string; title: string; status: string; name: string; handle: string | null; service_id: string }>(
    database,
    `SELECT h.id, h.title, h.status, u.name, p.handle, h.service_id
       FROM hire_requests h
       JOIN specialist_profiles p ON p.id = h.profile_id
       JOIN users u ON u.id = p.user_id
      WHERE h.company_id = ? ORDER BY h.created_at DESC`,
    companyId,
  ),
  all<{ id: string; hire_request_id: string; body: string; created_at: string; sender_name: string; mine: number }>(
    database,
    `SELECT m.id, m.hire_request_id, m.body, m.created_at, u.name AS sender_name,
            CASE WHEN m.sender_id IN (SELECT user_id FROM company_members WHERE company_id = ?1)
                 THEN 1 ELSE 0 END AS mine
       FROM messages m
       JOIN users u ON u.id = m.sender_id
       JOIN hire_requests h ON h.id = m.hire_request_id
      WHERE h.company_id = ?1
      ORDER BY m.created_at`,
    companyId,
  ),
  all<{ id: string; title: string; status: string; name: string; handle: string | null }>(
    database,
    `SELECT e.id, e.title, e.status, u.name, p.handle
       FROM engagements e
       JOIN specialist_profiles p ON p.id = e.profile_id
       JOIN users u ON u.id = p.user_id
      WHERE e.company_id = ? ORDER BY e.created_at DESC`,
    companyId,
  ),
]);

const openApplications = applications.filter((a) => a.status === 'submitted' || a.status === 'shortlisted');
---

<Night title="Company workspace — Fashion Freelancing" noindex current="" quoteBot={false}>
  <section class="net-hero" style="padding-bottom:calc(var(--u) * 2);">
    <div class="wrap">
      <div class="ws-head">
        <div>
          <span class="kicker">Company workspace</span>
          <h1 style="margin-top:12px;">Your hiring.</h1>
        </div>
        <div class="row-sm">
          <a class="btn-glass btn-sm" href="/specialists">Find a specialist</a>
          <a class="btn-hot btn-sm" href="/projects/new">Post a project</a>
          <form method="post" action="/api/sign-out">
            <button type="submit" class="btn-glass btn-sm">Sign out</button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <section class="sec" style="padding-top:0;">
    <div class="wrap">
      {flash && <div class="notice ok" style="margin-bottom:22px;">{flash}</div>}

      <div class="ws-stats">
        <div class="ws-stat glass-p"><b>{saved.length}</b><span>Saved specialists</span></div>
        <div class="ws-stat glass-p"><b>{projects.length}</b><span>Projects posted</span></div>
        <div class="ws-stat glass-p"><b>{openApplications.length}</b><span>Replies to read</span></div>
        <div class="ws-stat glass-p"><b>{engagements.filter((e) => e.status === 'active').length}</b><span>Work in progress</span></div>
      </div>

      <!-- ---------- applications ---------- -->
      <div class="panel glass-p">
        <h2>Replies to your projects</h2>
        {applications.length === 0 ? (
          <p>No replies yet. They appear here as soon as a specialist answers one of your projects.</p>
        ) : (
          <div class="ws-list">
            {applications.map((application) => (
              <article class="ws-row" style="display:block;border:1px solid var(--line);border-radius:16px;">
                <div class="row-sm" style="justify-content:space-between;align-items:flex-start;">
                  <div>
                    <p class="spec-service">{application.project_title}</p>
                    <h3 style="margin-top:6px;">{application.name}</h3>
                  </div>
                  <span class={`pill-status ${statusTone(application.status)}`}>
                    {applicationStatusLabel(application.status)}
                  </span>
                </div>
                <p style="margin:12px 0 0;color:var(--ink-4);font-size:14px;line-height:1.6;white-space:pre-wrap;">{application.pitch}</p>
                <div class="line" style="margin-top:12px;">
                  {application.price !== null && <span>{application.currency ?? 'USD'} {application.price}</span>}
                  {application.timeline && <span>{application.timeline}</span>}
                </div>
                <p class="fh" style="margin:14px 0 0;">
                  Hiring tells them they have the job and closes this project to everyone else.
                </p>
                <div class="ws-row-actions" style="margin-top:10px;">
                  {application.handle && <a class="btn-glass btn-sm" href={`/specialists/${application.handle}`}>View profile</a>}
                  {(application.status === 'submitted' || application.status === 'shortlisted') && (
                    <>
                      {application.status === 'submitted' && (
                        <form method="post">
                          <input type="hidden" name="applicationId" value={application.id} />
                          <button class="btn-glass btn-sm" name="action" value="shortlist">Shortlist</button>
                        </form>
                      )}
                      <form method="post">
                        <input type="hidden" name="applicationId" value={application.id} />
                        <button class="btn-hot btn-sm" name="action" value="hire"
                                data-busy="Hiring…">Hire {application.name}</button>
                      </form>
                      <form method="post">
                        <input type="hidden" name="applicationId" value={application.id} />
                        <button class="btn-glass btn-sm" name="action" value="decline">Decline</button>
                      </form>
                    </>
                  )}
                </div>
              </article>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- projects ---------- -->
      <div class="panel glass-p">
        <h2>Your projects</h2>
        {projects.length === 0 ? (
          <p>Nothing posted yet. <a href="/projects/new" style="color:var(--champagne-2);">Post a project</a> and we will match it.</p>
        ) : (
          <div class="ws-list">
            {projects.map((project) => (
              <div class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <div>
                  <h3>{project.title}</h3>
                  <div class="line">
                    <span>{getService(project.service_id)?.name}</span>
                    <span>{project.invited} invited</span>
                    <span>{project.applicants} applied</span>
                  </div>
                </div>
                <span class={`pill-status ${statusTone(project.status)}`}>{projectStatusForCompany(project.status)}</span>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- direct requests ---------- -->
      <div class="panel glass-p">
        <h2>People you asked to work with</h2>
        {hireRequests.length === 0 ? (
          <p>You have not asked anyone directly yet. Open a profile and use <b>Request to hire</b>.</p>
        ) : (
          <div class="ws-list">
            {hireRequests.map((request) => (
              <div class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <div>
                  <h3>{request.title}</h3>
                  <div class="line">
                    <span>{request.name}</span>
                    <span>{getService(request.service_id)?.name}</span>
                  </div>
                </div>
                <div class="ws-row-actions">
                  <span class={`pill-status ${statusTone(request.status)}`}>
                    {hireStatusForCompany(request.status)}
                  </span>
                </div>

                {(() => {
                  const thread = messages.filter((m) => m.hire_request_id === request.id);
                  if (!thread.length && !['sent', 'viewed', 'question', 'accepted', 'active'].includes(request.status)) return null;
                  return (
                    <div style="grid-column:1/-1;margin-top:14px;">
                      {thread.length > 0 && (
                        <div class="thread" style="margin-bottom:12px;">
                          {thread.map((m) => (
                            <div class={`msg ${m.mine === 1 ? 'mine' : ''}`}>
                              <p class="who">{m.sender_name}</p>
                              <p>{m.body}</p>
                            </div>
                          ))}
                        </div>
                      )}
                      <form method="post" class="cform">
                        <input type="hidden" name="action" value="reply" />
                        <input type="hidden" name="requestId" value={request.id} />
                        <label>
                          <span class="fl">{thread.length ? 'Reply' : 'Send them a message'}</span>
                          <textarea class="fi" name="body" rows="2" required minlength="2"
                                    placeholder="Answer their question, or add anything they need."></textarea>
                        </label>
                        <button class="btn-glass btn-sm" style="justify-self:start;" data-busy="Sending…">Send</button>
                      </form>
                    </div>
                  );
                })()}
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- saved ---------- -->
      <div class="panel glass-p">
        <h2>Saved specialists</h2>
        {saved.length === 0 ? (
          <p>Nothing saved yet. Use <b>Save</b> on any profile to keep it here while you compare people.</p>
        ) : (
          <div class="ws-list">
            {saved.map((specialist) => (
              <div class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <div>
                  <h3>{specialist.name}</h3>
                  <div class="line">
                    <span>{getService(specialist.service_id ?? '')?.name}</span>
                    {specialist.headline && <span>{specialist.headline}</span>}
                  </div>
                </div>
                <div class="ws-row-actions">
                  {specialist.handle && <a class="btn-glass btn-sm" href={`/specialists/${specialist.handle}`}>View</a>}
                  {specialist.handle && <a class="btn-hot btn-sm" href={`/hire/${specialist.handle}`}>Request to hire</a>}
                </div>
              </div>
            ))}
          </div>
        )}
      </div>

      <!-- ---------- engagements ---------- -->
      <div class="panel glass-p">
        <h2>Work in progress</h2>
        {engagements.length === 0 ? (
          <p>Nothing under way yet. Work appears here as soon as you hire someone, or a specialist accepts your request.</p>
        ) : (
          <div class="ws-list">
            {engagements.map((engagement) => (
              <div class="ws-row" style="border:1px solid var(--line);border-radius:16px;">
                <div>
                  <h3>{engagement.title}</h3>
                  <div class="line"><span>{engagement.name}</span></div>
                </div>
                <span class={`pill-status ${statusTone(engagement.status)}`}>{engagementStatusLabel(engagement.status)}</span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>
  </section>
</Night>
