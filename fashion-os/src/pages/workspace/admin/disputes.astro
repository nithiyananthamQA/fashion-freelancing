---
/**
 * /workspace/admin/disputes — work where one side has raised an issue, and the
 * three ways operations can settle it.
 *
 * Either side can raise an issue on a piece of work; from then on it sits with
 * us, and both sides have been told our team will be in touch. Nothing moves it
 * on except a decision made here, so the page is ordered by who has waited
 * longest, and each card carries what a decision needs: who is involved, what
 * was said in the work's own conversation, what has happened to it so far and
 * what money is recorded against it.
 *
 * Settling takes a note, always. Both sides are sent it, so "closed" never
 * arrives without a reason, and it is kept in the activity log as the record of
 * why the work ended the way it did.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, inClause, one } from '../../../server/db';
import { guard, requireAdmin } from '../../../server/guards';
import { audit, notify } from '../../../server/audit';
import { parse } from '../../../server/validate';
import { moveEngagement } from '../../../server/repo/engagements';
import { activityLabel, paymentKindLabel, paymentStatusLabel, statusTone } from '../../../data/labels';
import { adminNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireAdmin(Astro));
if (gate.response) return gate.response;
const admin = gate.value;

const database = db(Astro);
const tenant = Astro.locals.tenant;
let flash: string | null = null;
let errors: Record<string, string> = {};
/* A note that failed validation is put back in its own card's box — a
   mistake must never cost the operator what they typed. */
let failedFor: string | null = null;
let keptNote = '';

/** The three ways out of a dispute, in the words both sides will read. */
const OUTCOMES = {
  active: {
    button: 'Back to work',
    title: 'The issue is settled — work carries on',
    done: 'is back in progress',
  },
  completed: {
    button: 'Mark it finished',
    title: 'The issue is settled — the work is finished',
    done: 'is marked finished',
  },
  closed: {
    button: 'Close it',
    title: 'The issue is settled — the work is closed',
    done: 'is closed',
  },
} as const;
type Outcome = keyof typeof OUTCOMES;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { f, errors: found } = parse(form);
  errors = found;

  if (String(form.get('action') ?? '') === 'resolve') {
    const engagementId = String(form.get('engagementId') ?? '');
    const outcome = f.choice('outcome', 'Outcome', Object.keys(OUTCOMES) as Outcome[], { required: true });
    const note = f.text('note', 'Your note to both sides', { required: true, min: 5, max: 2000 });

    /* The id arrives in a form and a form can be replayed, so the work is
       fetched back through a company in this workspace. Both people to tell
       come back with it: the specialist, and whoever asked for the work on the
       company side — falling back to the company's owner, as the work pages
       do. */
    const work = await one<{ id: string; title: string; specialist_user: string; company_user: string | null }>(
      database,
      `SELECT e.id, e.title, su.id AS specialist_user,
              COALESCE(h.created_by, p.created_by,
                (SELECT m.user_id FROM company_members m
                  WHERE m.company_id = e.company_id
                  ORDER BY CASE WHEN m.role = 'owner' THEN 0 ELSE 1 END
                  LIMIT 1)) AS company_user
         FROM engagements e
         JOIN companies c ON c.id = e.company_id
         JOIN specialist_profiles sp ON sp.id = e.profile_id
         JOIN users su ON su.id = sp.user_id
         LEFT JOIN hire_requests h ON h.id = e.hire_request_id
         LEFT JOIN projects p ON p.id = e.project_id
        WHERE e.id = ? AND e.status = 'disputed' AND c.tenant IN (?, 'public')`,
      engagementId, tenant,
    );

    if (!work) {
      flash = 'That work is no longer in dispute, so nothing was changed.';
    } else if (Object.keys(errors).length || !outcome) {
      failedFor = work.id;
      keptNote = String(form.get('note') ?? '');
    } else if (!(await moveEngagement(database, work.id, ['disputed'], outcome))) {
      // Somebody else settled it between this page loading and the press.
      flash = 'That work is no longer in dispute, so nothing was changed.';
    } else {
      const said = OUTCOMES[outcome];
      const body = `${work.title} ${said.done}.\n\nFrom our team: ${note}`;
      await notify(database, {
        userId: work.specialist_user, kind: 'dispute_resolved', title: `${said.title}: ${work.title}`,
        body, link: '/workspace/freelancer/work',
      });
      if (work.company_user) {
        await notify(database, {
          userId: work.company_user, kind: 'dispute_resolved', title: `${said.title}: ${work.title}`,
          body, link: '/workspace/company/work',
        });
      }
      await audit(database, {
        actorId: admin.id, action: 'engagement.dispute_resolved', entityType: 'engagement', entityId: work.id,
        detail: { outcome, note }, request: Astro.request,
      });
      flash = `"${work.title}" ${said.done}. Both sides have your note.`;
    }
  }
}

interface Dispute {
  id: string;
  title: string;
  created_at: string;
  updated_at: string;
  company_name: string;
  specialist_name: string;
  handle: string | null;
}

/* Longest-waiting first: updated_at is when it became a dispute, because
   nothing else can touch the work until we do. */
const disputes = await all<Dispute>(
  database,
  `SELECT e.id, e.title, e.created_at, e.updated_at, c.name AS company_name,
          u.name AS specialist_name, sp.handle
     FROM engagements e
     JOIN companies c ON c.id = e.company_id
     JOIN specialist_profiles sp ON sp.id = e.profile_id
     JOIN users u ON u.id = sp.user_id
    WHERE e.status = 'disputed' AND c.tenant IN (?, 'public')
    ORDER BY e.updated_at ASC
    LIMIT 50`,
  tenant,
);

interface Said { engagement_id: string; body: string; created_at: string; sender: string }
interface Happened { entity_id: string; action: string; detail: string | null; created_at: string; actor: string | null }
interface Money { engagement_id: string; kind: string; amount: number; currency: string; status: string }

/* Everything a decision needs, fetched for all the cards at once rather than
   one query per card. */
const ids = inClause(disputes.map((d) => d.id));
const [said, happened, money] = ids
  ? await Promise.all([
      all<Said>(
        database,
        `SELECT m.engagement_id, m.body, m.created_at, u.name AS sender
           FROM messages m JOIN users u ON u.id = m.sender_id
          WHERE m.engagement_id IN (${ids.sql})
          ORDER BY m.created_at DESC
          LIMIT 200`,
        ...ids.params,
      ),
      all<Happened>(
        database,
        `SELECT a.entity_id, a.action, a.detail, a.created_at, u.name AS actor
           FROM audit_logs a LEFT JOIN users u ON u.id = a.actor_id
          WHERE a.entity_type = 'engagement' AND a.entity_id IN (${ids.sql})
          ORDER BY a.created_at`,
        ...ids.params,
      ),
      all<Money>(
        database,
        `SELECT engagement_id, kind, amount, currency, status
           FROM payments WHERE engagement_id IN (${ids.sql})
          ORDER BY created_at`,
        ...ids.params,
      ),
    ])
  : [[], [], []];

/** The last few things said in the work's own conversation, oldest of them first. */
const lastSaid = (id: string) => said.filter((m) => m.engagement_id === id).slice(0, 5).reverse();
const historyOf = (id: string) => happened.filter((h) => h.entity_id === id);
const moneyOn = (id: string) => money.filter((m) => m.engagement_id === id);

/**
 * Whatever words an audit row carries — the issue somebody raised, the note
 * they left. The detail is JSON written by many different pages, so this takes
 * any text field rather than knowing each page's key, and skips ids.
 */
function words(detail: string | null): string | null {
  if (!detail) return null;
  try {
    const parsed: unknown = JSON.parse(detail);
    if (!parsed || typeof parsed !== 'object') return null;
    const text = Object.entries(parsed as Record<string, unknown>)
      .filter(([key, value]) => typeof value === 'string' && value.trim() && !/id$/i.test(key))
      .map(([, value]) => String(value).trim());
    return text.length ? text.join(' · ') : null;
  } catch {
    return null;
  }
}

const when = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/** pill-tone only paints warn, ok and bad — anything else stays neutral. */
const tone = (value: string) => {
  const t = statusTone(value);
  return t === 'info' ? 'pill-tone' : `pill-tone ${t}`;
};

const nav = adminNav({ disputes: disputes.length || undefined });
---

<Workspace
  title="Disputes"
  role="admin"
  current="/workspace/admin/disputes"
  items={nav}
  who={admin.name}
  heading="Disputes"
  lede={disputes.length
    ? `${disputes.length} ${disputes.length === 1 ? 'piece of work is' : 'pieces of work are'} waiting on a decision from us. Longest waiting first.`
    : 'Work where one side has raised an issue, and the decision that settles it.'}
  flash={flash}
>
  {disputes.length === 0 ? (
    <div class="ws-empty">
      <h3>No work is in dispute</h3>
      <p>
        When a company or a specialist raises an issue on a piece of work, it
        stops where it is and lands here, with the conversation, its history and
        any money recorded against it. You settle it by putting it back to work,
        marking it finished or closing it — with a note both sides receive.
      </p>
      <a class="btn-glass btn-sm" href="/workspace/admin/payments">See work and payments</a>
    </div>
  ) : (
    <div class="stack-sm">
      {disputes.map((d) => (
        <article class="panel glass-p">
          <div class="ws-row-head">
            <div>
              <h2 style="margin:0;">{d.title}</h2>
              <p class="ws-sub">
                {d.company_name} with {d.specialist_name} · started {when(d.created_at)} · in dispute since {when(d.updated_at)}
              </p>
              {moneyOn(d.id).length > 0 && (
                <p class="ws-sub">
                  {moneyOn(d.id).map((m) => `${paymentKindLabel(m.kind)} ${m.currency} ${m.amount.toLocaleString('en-GB')} — ${paymentStatusLabel(m.status)}`).join(' · ')}
                </p>
              )}
            </div>
            <span class={tone('disputed')}>Waiting on us</span>
          </div>

          {(historyOf(d.id).length > 0 || lastSaid(d.id).length > 0) && (
            <div class="thread">
              {historyOf(d.id).map((h) => (
                <div class="msg">
                  <p class="who">{h.actor ?? 'Somebody'} {activityLabel(h.action)} · {when(h.created_at)}</p>
                  {words(h.detail) && <p>{words(h.detail)}</p>}
                </div>
              ))}
              {lastSaid(d.id).map((m) => (
                <div class="msg">
                  <p class="who">{m.sender} wrote · {when(m.created_at)}</p>
                  <p>{m.body}</p>
                </div>
              ))}
            </div>
          )}

          <form method="post" class="cform" style="margin-top:14px;" novalidate>
            <input type="hidden" name="action" value="resolve" />
            <input type="hidden" name="engagementId" value={d.id} />
            <label>
              <span class="fl">Your note to both sides<span class="rq" aria-hidden="true">*</span></span>
              <textarea class="fi" name="note" rows="3" required minlength="5" maxlength="2000"
                        aria-invalid={failedFor === d.id && errors.note ? 'true' : undefined}
                        placeholder="What was decided, and why. Both the company and the specialist receive this.">{failedFor === d.id ? keptNote : ''}</textarea>
              {failedFor === d.id && errors.note && <span class="cform-err" role="alert">{errors.note}</span>}
            </label>
            <div style="display:flex;flex-wrap:wrap;gap:8px;">
              {(Object.keys(OUTCOMES) as Outcome[]).map((outcome) => (
                <button class={outcome === 'active' ? 'btn-hot btn-sm' : 'btn-glass btn-sm'} name="outcome" value={outcome}>
                  {OUTCOMES[outcome].button}
                </button>
              ))}
            </div>
            <p class="ws-sub" style="margin:0;">
              Back to work reopens it for both sides. Finished and closed end it,
              and take the project or request behind it with them. Any money
              still owed is settled on the payments page.
            </p>
          </form>
        </article>
      ))}
    </div>
  )}
</Workspace>
