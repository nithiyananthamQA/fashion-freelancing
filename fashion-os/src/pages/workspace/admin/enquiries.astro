---
/**
 * /workspace/admin/enquiries — the direct-service side of the business:
 * somebody filled in the contact form or finished the quote bot and is sitting
 * waiting to hear back from us.
 *
 * On the single admin page these shared a screen with the application review,
 * so the one queue with a real person waiting on a reply was read in the same
 * breath as a queue of profiles waiting on a decision. They are different work.
 * Here the unanswered ones come first, the settled ones sink to the bottom, and
 * the whole message sits on the card so nobody replies without reading what was
 * actually asked.
 *
 * More than one person answers these, so each card also carries the team's
 * own notes — who spoke to them, what was promised — and every change of stage
 * is written to the activity log. The reply buttons open the operator's own
 * mail client or WhatsApp with the greeting already typed; nothing is sent from
 * here, so the conversation stays in the inbox the team actually uses.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, inClause, run } from '../../../server/db';
import { guard, requireAdmin } from '../../../server/guards';
import { newId, nowIso } from '../../../server/ids';
import { audit } from '../../../server/audit';
import { parse } from '../../../server/validate';
import { ownedLead } from '../../../server/tenant';
import { getService } from '../../../data/taxonomy';
import { leadSourceLabel, leadStatusLabel, statusTone } from '../../../data/labels';
import { adminNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireAdmin(Astro));
if (gate.response) return gate.response;
const admin = gate.value;

const database = db(Astro);
const tenant = Astro.locals.tenant;
let flash: string | null = null;

/* The moves an operator can make, in the order the work actually happens.
   'new' is not among them — an enquiry arrives there and never goes back. */
const STAGES = ['contacted', 'quoted', 'won', 'lost'] as const;

/** Buttons say what the operator just did, not which enum value they store. */
const STAGE_ACTION: Record<(typeof STAGES)[number], string> = {
  contacted: 'I have replied',
  quoted: 'I sent a price',
  won: 'They said yes',
  lost: 'They went elsewhere',
};

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const { f } = parse(form);

  if (String(form.get('action') ?? '') === 'lead_update') {
    const leadId = String(form.get('leadId') ?? '');
    const next = String(form.get('status') ?? '');
    const note = f.text('note', 'Note', { max: 2000 }).slice(0, 2000);

    /* The id arrives in a form and a form can be replayed carrying somebody
       else's, so the enquiry is proved to be in this workspace before the
       write. The stage is checked against our own list too — the column has a
       CHECK constraint, and a rejected write would surface as a 500 rather
       than as a sentence anyone can read. An empty stage is "just save the
       note". */
    const lead = !next || (STAGES as readonly string[]).includes(next)
      ? await ownedLead<{ id: string; name: string; status: string }>(database, leadId, tenant, 'id, name, status')
      : null;

    if (!lead) {
      flash = 'That enquiry is not in your queue.';
    } else if (!note && (!next || next === lead.status)) {
      flash = 'Write a note, or choose where the conversation got to.';
    } else {
      const now = nowIso();
      if (next && next !== lead.status) {
        await run(database, 'UPDATE leads SET status = ? WHERE id = ?', next, lead.id);
        await audit(database, {
          actorId: admin.id, action: 'lead.updated', entityType: 'lead', entityId: lead.id,
          detail: { from: lead.status, to: next }, request: Astro.request,
        });
      }
      if (note) {
        await run(
          database,
          'INSERT INTO lead_notes (id, lead_id, author_id, body, created_at) VALUES (?, ?, ?, ?, ?)',
          newId(), lead.id, admin.id, note, now,
        );
        await audit(database, {
          actorId: admin.id, action: 'lead.note_added', entityType: 'lead', entityId: lead.id,
          request: Astro.request,
        });
      }
      flash = next && next !== lead.status
        ? `${lead.name} — ${leadStatusLabel(next)}${note ? ', and your note is saved' : ''}.`
        : `Note saved on ${lead.name}'s enquiry.`;
    }
  }
}

interface Enquiry {
  id: string;
  name: string;
  email: string;
  company: string | null;
  phone: string | null;
  service: string | null;
  message: string;
  timeline: string | null;
  source: string;
  page: string | null;
  status: string;
  created_at: string;
}

interface Note {
  lead_id: string;
  body: string;
  created_at: string;
  author: string | null;
}

const enquiries = await all<Enquiry>(
  database,
  `SELECT id, name, email, company, phone, service, message, timeline, source, page, status, created_at
     FROM leads
    WHERE tenant IN (?, 'public')
    -- a work queue: nobody-has-replied first, settled last, newest within each
    ORDER BY (status = 'new') DESC, (status IN ('won','lost')) ASC, created_at DESC
    LIMIT 100`,
  tenant,
);

/* Every note on the enquiries shown, in one query, oldest first so each card
   reads as the conversation happened. */
const ids = inClause(enquiries.map((e) => e.id));
const notes = ids
  ? await all<Note>(
      database,
      `SELECT n.lead_id, n.body, n.created_at, u.name AS author
         FROM lead_notes n LEFT JOIN users u ON u.id = n.author_id
        WHERE n.lead_id IN (${ids.sql})
        ORDER BY n.created_at`,
      ...ids.params,
    )
  : [];
const notesFor = (leadId: string) => notes.filter((n) => n.lead_id === leadId);

const unanswered = enquiries.filter((e) => e.status === 'new').length;

const when = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

const clock = (iso: string) =>
  new Date(iso).toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });

const serviceName = (e: Enquiry) =>
  e.service === 'multiple' ? 'More than one service' : (getService(e.service)?.name ?? e.service);

/**
 * A number WhatsApp can dial: the phone field when the form sent one, or else
 * an international number (one written with a leading +) somewhere in the
 * message. Only the + form is trusted from free text — a bare run of digits in
 * a brief is far more often a budget, a quantity or a date.
 */
function whatsappNumber(e: Enquiry): string | null {
  const raw = e.phone ?? e.message.match(/\+\d[\d\s().-]{6,}\d/)?.[0] ?? null;
  const digits = raw?.replace(/\D/g, '') ?? '';
  return digits.length >= 8 && digits.length <= 15 ? digits : null;
}

const firstName = (e: Enquiry) => e.name.split(/\s+/)[0] ?? e.name;

/** The reply, with the greeting and the subject already written — the operator only adds the answer. */
function mailtoFor(e: Enquiry): string {
  const about = serviceName(e);
  const subject = `Your ${about && e.service !== 'multiple' ? `${about} ` : ''}enquiry — Fashion Freelancing`;
  const body = `Hi ${firstName(e)},\n\nThank you for getting in touch with Fashion Freelancing.\n\n`;
  return `mailto:${e.email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
}

function whatsappFor(e: Enquiry, number: string): string {
  const text = `Hi ${firstName(e)}, this is Fashion Freelancing — thank you for your enquiry.`;
  return `https://wa.me/${number}?text=${encodeURIComponent(text)}`;
}

/** pill-tone only paints warn, ok and bad — anything else stays neutral. */
const tone = (value: string) => {
  const t = statusTone(value);
  return t === 'info' ? 'pill-tone' : `pill-tone ${t}`;
};

/** What they asked for and where it came from, minus the fields left blank. */
const context = (e: Enquiry): string[] => [
  serviceName(e),
  e.timeline ? `Timeline: ${e.timeline}` : null,
  leadSourceLabel(e.source),
  e.page ? `sent from ${e.page}` : null,
  `${when(e.created_at)} at ${clock(e.created_at)}`,
].filter((x): x is string => Boolean(x));

/** How to reach them. */
const reach = (e: Enquiry): string[] =>
  [e.email, e.phone].filter((x): x is string => Boolean(x));

const nav = adminNav({ enquiries: unanswered || undefined });
---

<Workspace
  title="Project enquiries"
  role="admin"
  current="/workspace/admin/enquiries"
  items={nav}
  who={admin.name}
  heading="Project enquiries"
  lede={unanswered
    ? `${unanswered} ${unanswered === 1 ? 'person has' : 'people have'} written in and nobody has replied yet.`
    : 'Everyone who asked us to do the work directly, and where each conversation got to.'}
  flash={flash}
>
  {enquiries.length === 0 ? (
    <div class="ws-empty">
      <h3>Nobody has written in yet</h3>
      <p>
        Every enquiry from the contact form, the service pages and the quote bot
        lands here with the whole message, so you can read what was asked, reply
        by email and record where the conversation got to. Send someone to a
        service page and the first one appears.
      </p>
      <a class="btn-glass btn-sm" href="/#contact">Open the contact form</a>
    </div>
  ) : (
    <div class="stack-sm">
      {enquiries.map((e) => (
        <article class="panel glass-p">
          <div class="ws-row-head">
            <div>
              <h2 style="margin:0;">{e.company ? `${e.name} · ${e.company}` : e.name}</h2>
              <p class="ws-sub">{reach(e).join(' · ')}</p>
              <p class="ws-sub">{context(e).join(' · ')}</p>
            </div>
            <span class={tone(e.status)}>{leadStatusLabel(e.status)}</span>
          </div>

          <div class="thread">
            <div class="msg">
              <p class="who">What they asked for</p>
              <p>{e.message}</p>
            </div>
            {notesFor(e.id).map((note) => (
              <div class="msg mine">
                <p class="who">{note.author ?? 'Someone on the team'} · {when(note.created_at)} at {clock(note.created_at)}</p>
                <p>{note.body}</p>
              </div>
            ))}
          </div>

          <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px;">
            <a class="btn-hot btn-sm" href={mailtoFor(e)}>Reply by email</a>
            {whatsappNumber(e) && (
              <a class="btn-glass btn-sm" href={whatsappFor(e, whatsappNumber(e)!)} target="_blank" rel="noopener">
                Reply on WhatsApp
              </a>
            )}
          </div>

          <form method="post" class="cform" style="margin-top:14px;">
            <input type="hidden" name="leadId" value={e.id} />
            <input type="hidden" name="action" value="lead_update" />
            <label>
              <span class="fl">Note for the team</span>
              <textarea class="fi" name="note" rows="2" maxlength="2000"
                        placeholder="What was said, what was promised, what happens next. Only the team sees this."></textarea>
            </label>
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
              {STAGES.filter((stage) => stage !== e.status).map((stage) => (
                <button class="btn-glass btn-sm" name="status" value={stage}>{STAGE_ACTION[stage]}</button>
              ))}
              <button class="btn-glass btn-sm" name="status" value="">Save the note only</button>
            </div>
            <p class="ws-sub" style="margin:0;">
              Sending the email does not move the enquiry on its own — mark where
              it got to, so whoever opens this next knows what is left to do. A
              note typed above is saved with whichever button you press.
            </p>
          </form>
        </article>
      ))}
    </div>
  )}
</Workspace>
