---
/**
 * /workspace/admin/people — every account in this workspace, and what each one
 * is allowed to be.
 *
 * One account can hold a specialist profile and a company seat at the same
 * time (§3), so the other admin pages each show a different slice of the same
 * people: the review queue shows applicants, the directory page shows the ones
 * who got through, the projects page shows whoever posted a brief. None of
 * them answers "who is actually here, and what can they do?" — which is the
 * question asked when an account behaves oddly, or when somebody says they
 * cannot get in.
 *
 * Read-only on purpose. Suspending an account, granting admin rights and
 * approving a profile all belong to the page that owns that decision; this one
 * is the roster that tells you which of those pages to open.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, run } from '../../../server/db';
import { guard, requireAdmin } from '../../../server/guards';
import { accountStatusLabel, companyRoleLabel, profileStatusLabel, statusTone } from '../../../data/labels';
import { adminNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireAdmin(Astro));
if (gate.response) return gate.response;
const admin = gate.value;

/* Content editors are made and unmade here. The role opens /workspace/content
   only; admin rights are never granted from a form. Sessions are cleared so
   the change takes effect on the next sign-in, not the next click. */
let flash: string | null = null;
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (String(form.get('action') ?? '') === 'role') {
    const userId = String(form.get('userId') ?? '');
    const role = String(form.get('role') ?? '') === 'editor' ? 'editor' : 'member';
    const target = await all<{ id: string; name: string; is_admin: number }>(
      db(Astro), "SELECT id, name, is_admin FROM users WHERE id = ? AND tenant IN (?, 'public')", userId, Astro.locals.tenant);
    const person = target[0];
    if (!person || person.is_admin === 1 || person.id === admin.id) {
      flash = 'That account cannot be changed here.';
    } else {
      await run(db(Astro), 'UPDATE users SET role = ?, updated_at = ? WHERE id = ?', role, new Date().toISOString(), person.id);
      await run(db(Astro), 'DELETE FROM sessions WHERE user_id = ?', person.id);
      flash = role === 'editor' ? `${person.name} can now edit the site content.` : `${person.name} no longer has content access.`;
    }
  }
}

const database = db(Astro);
const tenant = Astro.locals.tenant;

interface Person {
  id: string;
  name: string;
  email: string;
  status: string;
  is_admin: number;
  role: string;
  email_verified_at: string | null;
  created_at: string;
  profile_id: string | null;
  handle: string | null;
  profile_status: string | null;
}

/* A profile is one-to-one with an account (users.id is UNIQUE in
   specialist_profiles), so it joins straight on rather than being counted.
   Newest first: the account you are being asked about is almost always one
   that just signed up. */
const people = await all<Person>(
  database,
  `SELECT u.id, u.name, u.email, u.status, u.is_admin, u.role, u.email_verified_at, u.created_at,
          p.id AS profile_id, p.handle, p.status AS profile_status
     FROM users u
     LEFT JOIN specialist_profiles p ON p.user_id = u.id
    WHERE u.tenant IN (?1, 'public')
    ORDER BY u.created_at DESC
    LIMIT 200`,
  tenant,
);

/* Both sides scoped: an account in this workspace can only be shown sitting on
   a company that is also in it, so a shared seed account cannot leak the name
   of somebody else's company through its membership row. */
const seats = await all<{ user_id: string; company_name: string; role: string; job_title: string | null }>(
  database,
  `SELECT m.user_id, c.name AS company_name, m.role, m.job_title
     FROM company_members m
     JOIN companies c ON c.id = m.company_id
     JOIN users u ON u.id = m.user_id
    WHERE u.tenant IN (?1, 'public') AND c.tenant IN (?1, 'public')
    ORDER BY CASE WHEN m.role = 'owner' THEN 0 ELSE 1 END, c.name`,
  tenant,
);

const seatsFor = (userId: string) => seats.filter((seat) => seat.user_id === userId);

const specialists = people.filter((person) => person.profile_id).length;
const onCompany = new Set(seats.map((seat) => seat.user_id)).size;
const admins = people.filter((person) => person.is_admin === 1).length;

const day = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/** pill-tone only paints warn, ok and bad — anything else stays neutral. */
const tone = (value: string) => {
  const t = statusTone(value);
  return t === 'info' ? 'pill-tone' : `pill-tone ${t}`;
};

/** The line under the name: how to reach them, and how long they have been here. */
const facts = (person: Person): string[] => [
  person.email,
  `Joined ${day(person.created_at)}`,
  person.email_verified_at ? null : 'Email never confirmed',
].filter((x): x is string => Boolean(x));

/**
 * What the account can do, in a sentence. An account with no profile and no
 * company seat can still sign in and browse, and reads as an empty row unless
 * the page says that outright.
 */
function whatTheyCanDo(person: Person): string {
  const parts: string[] = [];
  if (person.profile_id) parts.push(`Specialist — ${profileStatusLabel(person.profile_status)}`);
  const seated = seatsFor(person.id);
  for (const seat of seated) {
    parts.push(`${seat.company_name} — ${companyRoleLabel(seat.role)}${seat.job_title ? `, ${seat.job_title}` : ''}`);
  }
  if (person.is_admin === 1) parts.push('Runs this workspace');
  if (person.role === 'editor') parts.push('Edits the site content');
  if (parts.length === 0) return 'Signed up, but has not applied as a specialist or joined a company yet.';
  return parts.join(' · ');
}

const nav = adminNav();
---

<Workspace
  title="People"
  role="admin"
  current="/workspace/admin/people"
  items={nav}
  who={admin.name}
  heading="People"
  lede={people.length
    ? `${people.length} ${people.length === 1 ? 'account' : 'accounts'} · ${specialists} with a specialist profile · ${onCompany} on a company · ${admins} with admin rights.`
    : 'Everyone who can sign in here, and what each account is allowed to be.'}
  flash={null} flash={flash}
>
  {people.length === 0 ? (
    <div class="ws-empty">
      <h3>No accounts in this workspace yet</h3>
      <p>
        Everyone who signs up appears here — freelancers who applied, the people
        who post projects for a company, and anyone with admin rights — with
        their email, when they joined, and which of those they are. The first
        person to create an account starts the list.
      </p>
      <a class="btn-glass btn-sm" href="/workspace/admin">Back to the overview</a>
    </div>
  ) : (
    <div class="stack-sm">
      {people.map((person) => (
        <article class="panel glass-p">
          <div class="ws-row-head" style="margin-bottom:0;">
            <div>
              <h2 style="margin:0;">{person.name}{person.id === admin.id ? ' — you' : ''}</h2>
              <p class="ws-sub">{facts(person).join(' · ')}</p>
              <p class="ws-sub">{whatTheyCanDo(person)}</p>
            </div>
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;">
              {person.status !== 'active' && (
                <span class="pill-tone bad">{accountStatusLabel(person.status)}</span>
              )}
              {person.is_admin === 1 && <span class="pill-tone ok">Admin rights</span>}
              {person.role === 'editor' && <span class="pill-tone">Content editor</span>}
              {person.is_admin !== 1 && person.id !== admin.id && (
                <form method="post" class="people-role">
                  <input type="hidden" name="action" value="role" />
                  <input type="hidden" name="userId" value={person.id} />
                  <input type="hidden" name="role" value={person.role === 'editor' ? 'member' : 'editor'} />
                  <button type="submit" class="link-t">{person.role === 'editor' ? 'Remove content access' : 'Make content editor'}</button>
                </form>
              )}
              {person.profile_status && (
                <span class={tone(person.profile_status)}>{profileStatusLabel(person.profile_status)}</span>
              )}
            </div>
          </div>

          {person.handle && person.profile_status === 'approved' && (
            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin-top:14px;">
              <a class="btn-glass btn-sm" href={`/specialists/${person.handle}`} target="_blank" rel="noopener">
                See their public page
              </a>
            </div>
          )}
        </article>
      ))}

      <p class="ws-sub">
        Nothing on this page changes an account. Profiles are approved and
        paused in the applications queue and the directory; admin rights and
        suspensions are set by us, outside the product.
      </p>
    </div>
  )}
</Workspace>
