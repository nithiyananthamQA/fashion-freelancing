---
/**
 * /workspace/company/messages — the company side of every conversation, and
 * the mirror of /workspace/freelancer/messages.
 *
 * On the old single-page workspace a thread lived inside whichever request
 * card it hung off, so "who is waiting on us?" meant scrolling the whole page
 * and reading every card. This gathers them and puts the ones where the
 * specialist spoke last at the top.
 *
 * A thread belongs to the company, not to the person who opened it, so
 * anything a teammate sent reads as ours — otherwise a colleague's answer
 * would look like it came from the other side.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, one, run } from '../../../server/db';
import { guard, requireCompany } from '../../../server/guards';
import { newId, nowIso } from '../../../server/ids';
import { notify } from '../../../server/audit';
import { hireStatusForCompany } from '../../../data/labels';
import { companyNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireCompany(Astro));
if (gate.response) return gate.response;
const { user, companyId } = gate.value;

const database = db(Astro);
let flash: string | null = null;

/* Reply into a thread. The thread is named by the hire request it belongs to,
   and that request must belong to this company — the id arrives in a form, and
   a form can be replayed with somebody else's. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const requestId = String(form.get('requestId') ?? '');
  const body = String(form.get('body') ?? '').trim();

  const owned = await one<{ id: string; title: string; owner_user: string }>(
    database,
    `SELECT h.id, h.title, u.id AS owner_user
       FROM hire_requests h
       JOIN specialist_profiles p ON p.id = h.profile_id
       JOIN users u ON u.id = p.user_id
      WHERE h.id = ? AND h.company_id = ?`,
    requestId, companyId,
  );

  if (owned && body.length >= 2) {
    await run(
      database,
      'INSERT INTO messages (id, hire_request_id, sender_id, body, created_at) VALUES (?, ?, ?, ?, ?)',
      newId(), owned.id, user.id, body.slice(0, 3000), nowIso(),
    );
    await notify(database, {
      userId: owned.owner_user,
      kind: 'message',
      title: `New message about ${owned.title}`,
      body: body.slice(0, 140),
      link: '/workspace/freelancer/messages',
    });
    flash = 'Message sent.';
  } else if (owned) {
    flash = 'Write a little more before sending.';
  }
}

interface Thread {
  request_id: string;
  title: string;
  specialist_name: string;
  status: string;
  last_at: string | null;
  total: number;
  /** 1 when the specialist spoke last, so the ball is with us. */
  theirs_last: number;
}

const threads = await all<Thread>(
  database,
  `SELECT h.id AS request_id, h.title, u.name AS specialist_name, h.status,
          MAX(m.created_at) AS last_at,
          COUNT(m.id) AS total,
          CASE WHEN (
            SELECT m2.sender_id FROM messages m2
             WHERE m2.hire_request_id = h.id
             ORDER BY m2.created_at DESC LIMIT 1
          ) IN (SELECT cm.user_id FROM company_members cm WHERE cm.company_id = ?1)
          THEN 0 ELSE 1 END AS theirs_last
     FROM hire_requests h
     JOIN specialist_profiles p ON p.id = h.profile_id
     JOIN users u ON u.id = p.user_id
     LEFT JOIN messages m ON m.hire_request_id = h.id
    WHERE h.company_id = ?1
    GROUP BY h.id
    HAVING total > 0
    -- waiting on us first, then most recently active
    ORDER BY theirs_last DESC, last_at DESC`,
  companyId,
);

const messages = await all<{
  hire_request_id: string; body: string; created_at: string; sender_name: string; mine: number;
}>(
  database,
  `SELECT m.hire_request_id, m.body, m.created_at, u.name AS sender_name,
          CASE WHEN m.sender_id IN (SELECT cm.user_id FROM company_members cm WHERE cm.company_id = ?1)
               THEN 1 ELSE 0 END AS mine
     FROM messages m
     JOIN users u ON u.id = m.sender_id
     JOIN hire_requests h ON h.id = m.hire_request_id
    WHERE h.company_id = ?1
    ORDER BY m.created_at`,
  companyId,
);

/* Which way the empty state points: someone already asked, so the thread
   starts on that request — or nobody has, so it starts with finding a person. */
const asked = await one<{ total: number }>(
  database,
  'SELECT COUNT(*) AS total FROM hire_requests WHERE company_id = ?',
  companyId,
);

const byThread = (id: string) => messages.filter((m) => m.hire_request_id === id);
const awaiting = threads.filter((t) => t.theirs_last === 1).length;

const when = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : '';

const nav = companyNav({ messages: awaiting || undefined });
---

<Workspace
  title="Messages"
  role="company"
  current="/workspace/company/messages"
  items={nav}
  who={user.name}
  heading="Messages"
  lede={awaiting
    ? `${awaiting} ${awaiting === 1 ? 'conversation is' : 'conversations are'} waiting on your reply.`
    : 'Every conversation about work you have asked someone to do.'}
  flash={flash}
>
  {threads.length === 0 ? (
    <div class="ws-empty">
      <h3>No conversations yet</h3>
      <p>
        When you ask a specialist to work with you, their questions and your
        answers appear here as one thread per request. You can reply without
        leaving this page.
      </p>
      {asked && asked.total > 0 ? (
        <a class="btn-glass btn-sm" href="/workspace/company/requests">Open a request and say hello</a>
      ) : (
        <a class="btn-hot btn-sm" href="/specialists">Find a specialist</a>
      )}
    </div>
  ) : (
    <div class="stack-sm">
      {threads.map((t) => (
        <article class="panel glass-p">
          <div class="ws-row-head">
            <div>
              <h2 style="margin:0;">{t.title}</h2>
              <p class="ws-sub">
                {t.specialist_name} · {t.total} {t.total === 1 ? 'message' : 'messages'} · {when(t.last_at)} · {hireStatusForCompany(t.status)}
              </p>
            </div>
            {t.theirs_last === 1 && <span class="pill-tone warn">Needs your reply</span>}
          </div>

          <div class="thread">
            {byThread(t.request_id).map((m) => (
              <div class={`msg ${m.mine === 1 ? 'mine' : ''}`}>
                <p class="who">{m.sender_name}</p>
                <p>{m.body}</p>
              </div>
            ))}
          </div>

          <form method="post" class="cform" style="margin-top:14px;">
            <input type="hidden" name="requestId" value={t.request_id} />
            <label>
              <span class="fl">Your reply</span>
              <textarea class="fi" name="body" rows="3" required minlength="2"
                        placeholder="Answer their question, or add anything they need to quote."></textarea>
            </label>
            <button class="btn-hot btn-sm" style="justify-self:start;" data-busy="Sending…">Send reply</button>
          </form>
        </article>
      ))}
    </div>
  )}
</Workspace>
