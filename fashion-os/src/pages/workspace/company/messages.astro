---
/**
 * /workspace/company/messages — the company side of every conversation, and
 * the mirror of /workspace/freelancer/messages.
 *
 * On the old single-page workspace a thread lived inside whichever request
 * card it hung off, so "who is waiting on us?" meant scrolling the whole page
 * and reading every card. This gathers them and puts the ones where the
 * specialist spoke last at the top.
 *
 * Three kinds of thread meet here: a request to hire, a reply to a project
 * this company posted (§15 — the question asked before deciding whom to hire),
 * and the work itself once it is under way. Each says which it is, because the
 * same specialist can be in all three at once.
 *
 * A thread belongs to the company, not to the person who opened it, so
 * anything a teammate sent reads as ours — otherwise a colleague's answer
 * would look like it came from the other side.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { db, one } from '../../../server/db';
import { guard, requireCompany } from '../../../server/guards';
import { parse } from '../../../server/validate';
import { limited, tooManyRequests } from '../../../server/rate-limit';
import { findThread, listThreads, sendMessage, type Side, type Thread } from '../../../server/repo/threads';
import { fileHref, fileSize } from '../../../server/repo/attachments';
import { threadKindForCompany, threadStatusForCompany } from '../../../data/labels';
import { companyNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireCompany(Astro));
if (gate.response) return gate.response;
const { user, companyId } = gate.value;

const database = db(Astro);
const side: Side = { as: 'company', companyId };
let flash: string | null = null;

/* Reply into a thread. The thread is named by what it hangs off, and that
   must belong to this company — the key arrives in a form, and a form can be
   replayed with somebody else's, so findThread proves it again on write. */
if (Astro.request.method === 'POST') {
  if (await limited(database, 'message', user.id)) return tooManyRequests();
  const form = await Astro.request.formData();
  const { f, errors } = parse(form);
  const body = f.text('body', 'Your reply', { required: true, min: 2, max: 3000 });
  const thread = await findThread(database, side, String(form.get('thread') ?? ''));

  if (!thread) {
    flash = 'That conversation could not be found.';
  } else if (!thread.open) {
    flash = 'That conversation is closed, so your message was not sent.';
  } else if (body) {
    await sendMessage(database, side, thread, user, body);
    flash = `Sent to ${thread.otherName}.`;
  } else {
    flash = errors.body ?? 'Write a little more before sending.';
  }
}

/* Only threads somebody has written in. Waiting on us first, then most
   recently active. */
const threads = (await listThreads(database, side))
  .filter((t) => t.messages.length > 0)
  .sort((a, b) =>
    Number(b.theirsLast) - Number(a.theirsLast) || (b.lastAt ?? '').localeCompare(a.lastAt ?? ''));

/* Which way the empty state points: someone already asked, so the thread
   starts on that request — or nobody has, so it starts with finding a person. */
const asked = await one<{ total: number }>(
  database,
  'SELECT COUNT(*) AS total FROM hire_requests WHERE company_id = ?',
  companyId,
);

// a closed thread owes nobody anything, whoever spoke last
const awaiting = threads.filter((t) => t.theirsLast && t.open).length;

/** The page where the thing a thread hangs off can be acted on, not just discussed. */
const home = (t: Thread): { href: string; label: string } =>
  t.kind === 'request' ? { href: '/workspace/company/requests', label: 'Open the request' }
    : t.kind === 'reply' ? { href: '/workspace/company/replies', label: 'Open their reply' }
    : { href: `/workspace/company/work#work-${t.id}`, label: 'Open the work' };

const when = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' }) : '';

const nav = companyNav({ messages: awaiting || undefined });
---

<Workspace
  title="Messages"
  role="company"
  current="/workspace/company/messages"
  items={nav}
  who={user.name}
  heading="Messages"
  lede={awaiting
    ? `${awaiting} ${awaiting === 1 ? 'conversation is' : 'conversations are'} waiting on your reply.`
    : 'Every conversation about work you have asked for, posted or hired someone to do.'}
  flash={flash}
>
  {threads.length === 0 ? (
    <div class="ws-empty">
      <h3>No conversations yet</h3>
      <p>
        When you ask a specialist to work with you, question someone who replied
        to your project, or talk through work under way, every thread appears
        here — one per request, reply or job. You can answer without leaving
        this page.
      </p>
      {asked && asked.total > 0 ? (
        <a class="btn-glass btn-sm" href="/workspace/company/requests">Open a request and say hello</a>
      ) : (
        <a class="btn-hot btn-sm" href="/specialists">Find a specialist</a>
      )}
    </div>
  ) : (
    <div class="stack-sm">
      {threads.map((t) => (
        <article class="panel glass-p">
          <div class="ws-row-head">
            <div>
              <h2 style="margin:0;">{t.title}</h2>
              <p class="ws-sub">
                {threadKindForCompany(t.kind)} · {t.otherName} · {t.messages.length} {t.messages.length === 1 ? 'message' : 'messages'} · {when(t.lastAt)} · {threadStatusForCompany(t.kind, t.status)}
              </p>
            </div>
            {t.theirsLast && t.open && <span class="pill-tone warn">Needs your reply</span>}
          </div>

          <div class="thread">
            {t.messages.map((m) => (
              <div class={`msg ${m.mine ? 'mine' : ''}`}>
                <p class="who">{m.sender_name}</p>
                <p>{m.body}</p>
                {m.files.length > 0 && (
                  <div class="row-sm" style="margin-top:10px;">
                    {m.files.map((file) => (
                      <a class="btn-glass btn-sm" href={fileHref(file)} target="_blank" rel="noopener">
                        {file.filename} · {fileSize(file.size_bytes)}
                      </a>
                    ))}
                  </div>
                )}
              </div>
            ))}
          </div>

          {t.open ? (
            <form method="post" class="cform" style="margin-top:14px;">
              <input type="hidden" name="thread" value={t.key} />
              <label>
                <span class="fl">Your reply</span>
                <textarea class="fi" name="body" rows="3" required minlength="2"
                          placeholder="Answer their question, or add anything they need to quote."></textarea>
              </label>
              <button class="btn-hot btn-sm" style="justify-self:start;" data-busy="Sending…">Send reply</button>
            </form>
          ) : (
            <p class="ws-sub" style="margin-top:12px;">
              This conversation is closed — what it was about has been settled.
            </p>
          )}

          <a class="btn-glass btn-sm" href={home(t).href} style="margin-top:12px;">{home(t).label}</a>
        </article>
      ))}
    </div>
  )}
</Workspace>
