---
/**
 * /workspace/company/work — everyone this company has actually hired, what
 * state their work is in, the conversation about it, and the money recorded
 * against it. The mirror of /workspace/freelancer/work.
 *
 * A specialist hands work over from their side, which leaves a decision owed
 * here: accept it, or ask for changes. On the old single-page workspace that
 * decision was a line of title and status with nothing to act on, so delivered
 * work sat unanswered and the specialist could not tell whether it had even
 * been looked at. The unfinished work comes first, and the delivered work
 * first of all, because that is the only row anyone is waiting on.
 *
 * Each job carries its own thread (§9, "private messaging"). A request for
 * changes used to travel only as a notification body no page ever showed, while
 * the flash promised "they have your notes" — so the notes, the hand-over and
 * anything either side writes now sit in that thread, in order.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, one } from '../../../server/db';
import { guard, requireCompany } from '../../../server/guards';
import { audit, notify, notifyAdmins } from '../../../server/audit';
import { parse } from '../../../server/validate';
import { limited, tooManyRequests } from '../../../server/rate-limit';
import { LIVE_WORK, moveEngagement } from '../../../server/repo/engagements';
import {
  excerpt, findThread, listThreads, postMessage, sendMessage, threadKey, threadOf, type Side, type Target,
} from '../../../server/repo/threads';
import {
  ATTACHMENT_COLUMNS, fileHref, fileSize, filesBy, type Attachment,
} from '../../../server/repo/attachments';
import { getService } from '../../../data/taxonomy';
import {
  engagementLabel, engagementStatusLabel,
  paymentKindForCompany, paymentStatusLabel, statusTone,
} from '../../../data/labels';
import { companyNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireCompany(Astro));
if (gate.response) return gate.response;
const { user, companyId } = gate.value;

const database = db(Astro);
const side: Side = { as: 'company', companyId };
let flash: string | null = null;

/** The specialist hears about every move of their work, on their own work page. */
async function tell(target: Target, kind: string, title: string, body: string): Promise<void> {
  if (!target.recipientId) return;
  await notify(database, { userId: target.recipientId, kind, title, body, link: '/workspace/freelancer/work' });
}

/* Accept the work, send it back for changes, close it, raise an issue, or
   write into its thread. The id arrives in a form and a form can be replayed
   with somebody else's, so the work is fetched back through this company
   (findThread) before anything is written — and every move is guarded on the
   states it may leave (moveEngagement), so a resubmitted form cannot finish a
   job twice, reopen one already signed off, or close one already finished. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');
  const thread = await findThread(database, side, threadKey('work', String(form.get('engagementId') ?? '')));
  const { f, errors } = parse(form);

  if (!thread) {
    flash = 'That work could not be found.';
  } else if (action === 'message') {
    if (await limited(database, 'message', user.id)) return tooManyRequests();
    const body = f.text('body', 'Your message', { required: true, min: 2, max: 3000 });
    if (body) {
      await sendMessage(database, side, thread, user, body);
      flash = `Sent to ${thread.otherName}.`;
    } else {
      flash = errors.body ?? 'Write a little more before sending.';
    }
  } else if (action === 'accept') {
    if (await moveEngagement(database, thread.id, ['delivered'], 'completed')) {
      await tell(thread, 'engagement_completed', `${user.name} accepted: ${thread.title}`,
        'The job is marked finished.');
      await audit(database, {
        actorId: user.id, action: 'engagement.completed', entityType: 'engagement', entityId: thread.id,
        request: Astro.request,
      });
      flash = 'Accepted. The work is marked finished and they have been told.';
    } else {
      flash = 'That work is not waiting on your review.';
    }
  } else if (action === 'changes') {
    /* A request for changes without a note reads as a rejection with no
       reason attached, and it is the only thing they will read when the job
       reopens — so it is required, and nothing moves until it is written. */
    const note = f.text('note', 'What still needs doing', { required: true, min: 10, max: 2000 });
    if (!note) {
      flash = `Nothing was sent back — ${errors.note ?? 'say what still needs doing.'}`;
    } else if (await moveEngagement(database, thread.id, ['delivered'], 'revision')) {
      await postMessage(database, thread, user.id, `Changes requested:\n\n${note}`);
      await tell(thread, 'engagement_revision', `Changes requested: ${thread.title}`, excerpt(note));
      flash = 'Sent back. Your notes are in the thread on this job, and it is open again.';
    } else {
      flash = 'That work is not waiting on your review.';
    }
  } else if (action === 'close') {
    const reason = f.text('reason', 'Reason', { max: 1000 });
    if (await moveEngagement(database, thread.id, LIVE_WORK, 'closed')) {
      if (reason) await postMessage(database, thread, user.id, `Closed before it was finished:\n\n${reason}`);
      await tell(thread, 'engagement_closed', `Closed: ${thread.title}`,
        reason ? excerpt(reason) : `${user.name} closed this work before it was finished.`);
      await audit(database, {
        actorId: user.id, action: 'engagement.closed', entityType: 'engagement', entityId: thread.id,
        detail: reason ? { reason } : undefined, request: Astro.request,
      });
      flash = 'Closed. They have been told, and the project or request it came from is closed with it.';
    } else {
      flash = 'That work is already finished, closed, or with our team as a dispute.';
    }
  } else if (action === 'issue') {
    if (await limited(database, 'message', user.id)) return tooManyRequests();
    const issue = f.text('issue', 'What has gone wrong', { required: true, min: 20, max: 2000 });
    if (!issue) {
      flash = `Nothing was raised — ${errors.issue ?? 'say what has gone wrong.'}`;
    } else if (await moveEngagement(database, thread.id, LIVE_WORK, 'disputed')) {
      await postMessage(database, thread, user.id, `Issue raised:\n\n${issue}`);
      await tell(thread, 'engagement_disputed', `Issue raised: ${thread.title}`, excerpt(issue));
      await audit(database, {
        actorId: user.id, action: 'engagement.disputed', entityType: 'engagement', entityId: thread.id,
        detail: { raisedBy: 'company' }, request: Astro.request,
      });
      await notifyAdmins(database, {
        kind: 'engagement_disputed',
        title: `Issue raised: ${thread.title}`,
        body: `${user.name}, on work with ${thread.otherName}: ${excerpt(issue)}`,
        link: '/workspace/admin/disputes',
      });
      flash = 'Raised. Our team has been told and will be in touch, and so has the specialist.';
    } else {
      flash = 'An issue can only be raised on work still under way.';
    }
  }
}

interface Job {
  id: string;
  title: string;
  status: string;
  created_at: string;
  updated_at: string;
  specialist_name: string;
  handle: string | null;
  headline: string | null;
  /** Null once the request or project behind the work has been deleted. */
  service_id: string | null;
  brief: string | null;
  deliverables: string | null;
  engagement: string | null;
  deadline: string | null;
  hire_request_id: string | null;
  from_project: number;
  /** What was agreed: the price they sent back, or the price on their reply. */
  agreed_amount: number | null;
  agreed_currency: string | null;
  agreed_timeline: string | null;
}

interface Payment {
  id: string;
  engagement_id: string;
  kind: string;
  amount: number;
  currency: string;
  status: string;
  reference: string | null;
  created_at: string;
}

/* Work starts two ways — a request someone accepted, or a reply this company
   picked — and the brief lives on whichever of the two started it. */
const jobs = await all<Job>(
  database,
  `SELECT e.id, e.title, e.status, e.created_at, e.updated_at, e.hire_request_id,
          u.name AS specialist_name, sp.handle, sp.headline,
          COALESCE(h.service_id, p.service_id)     AS service_id,
          COALESCE(h.brief, p.brief)               AS brief,
          COALESCE(h.deliverables, p.deliverables) AS deliverables,
          COALESCE(h.engagement, p.engagement)     AS engagement,
          COALESCE(h.deadline, p.deadline)         AS deadline,
          CASE WHEN e.project_id IS NULL THEN 0 ELSE 1 END AS from_project,
          COALESCE(h.proposal_amount, a.price)               AS agreed_amount,
          COALESCE(h.proposal_currency, h.currency, p.currency, a.currency) AS agreed_currency,
          COALESCE(h.proposal_timeline, a.timeline)          AS agreed_timeline
     FROM engagements e
     JOIN specialist_profiles sp ON sp.id = e.profile_id
     JOIN users u ON u.id = sp.user_id
     LEFT JOIN hire_requests h ON h.id = e.hire_request_id
     LEFT JOIN projects p ON p.id = e.project_id
     LEFT JOIN applications a ON a.project_id = e.project_id AND a.profile_id = e.profile_id
    WHERE e.company_id = ?
    -- waiting on us first, then the rest of the open work, then the finished
    ORDER BY CASE WHEN e.status = 'delivered' THEN 0
                  WHEN e.status IN ('completed', 'closed') THEN 2
                  ELSE 1 END,
             e.updated_at DESC`,
  companyId,
);

const payments = await all<Payment>(
  database,
  `SELECT y.id, y.engagement_id, y.kind, y.amount, y.currency, y.status,
          y.reference, y.created_at
     FROM payments y
     JOIN engagements e ON e.id = y.engagement_id
    -- a draft is our team's note to itself until it is raised
    WHERE e.company_id = ? AND y.status != 'draft'
    ORDER BY y.created_at DESC`,
  companyId,
);

const threads = await listThreads(database, side);

/* The files that came with the brief, filed under the work they became. Files
   handed over later sit in the thread, under the message they came with. */
const briefFiles = filesBy(
  await all<Attachment & { work_id: string }>(
    database,
    `SELECT ${ATTACHMENT_COLUMNS}, e.id AS work_id
       FROM attachments at
       JOIN engagements e ON at.hire_request_id = e.hire_request_id OR at.project_id = e.project_id
      WHERE e.company_id = ? AND at.message_id IS NULL AND at.scan_status = 'clean'`,
    companyId,
  ),
  'work_id',
);

/* Which way out of the empty state is the real one: a reply already sitting
   there beats being sent off to search the directory again. */
const undecided = await one<{ total: number }>(
  database,
  `SELECT COUNT(*) AS total
     FROM applications a
     JOIN projects p ON p.id = a.project_id
    WHERE p.company_id = ? AND a.status IN ('submitted', 'shortlisted')`,
  companyId,
);

const forJob = (id: string) => payments.filter((y) => y.engagement_id === id);
const messagesOf = (id: string) => threadOf(threads, 'work', id)?.messages ?? [];
const isLive = (j: Job) => (LIVE_WORK as readonly string[]).includes(j.status);

const open = jobs.filter((j) => !['completed', 'closed'].includes(j.status)).length;
const awaiting = jobs.filter((j) => j.status === 'delivered').length;

const money = (y: Payment) => `${y.currency} ${y.amount.toLocaleString('en-GB')}`;

const when = (iso: string) =>
  new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });

/** The handful of facts read before deciding whether to open the job again. */
const facts = (j: Job): string => {
  const parts: string[] = [j.specialist_name];
  const service = getService(j.service_id);
  if (service) parts.push(service.name);
  if (j.engagement) parts.push(engagementLabel(j.engagement));
  if (j.deadline) parts.push(`Due ${j.deadline}`);
  parts.push(j.from_project === 1 ? 'From a project you posted' : 'From a request to hire');
  parts.push(`Started ${when(j.created_at)}`);
  return parts.join(' · ');
};

/** The terms both sides agreed to, if a figure was ever put on them. */
const agreed = (j: Job): string | null => {
  if (j.agreed_amount === null) return null;
  const price = `${j.agreed_currency ?? 'USD'} ${j.agreed_amount.toLocaleString('en-GB')}`;
  return j.agreed_timeline ? `${price} · ${j.agreed_timeline}` : price;
};

const tone = (status: string) => {
  const t = statusTone(status);
  // pill-tone only paints warn, ok and bad — anything else stays neutral.
  return t === 'info' ? 'pill-tone' : `pill-tone ${t}`;
};

const nav = companyNav({ work: open || undefined });
---

<Workspace
  title="Work in progress"
  role="company"
  current="/workspace/company/work"
  items={nav}
  who={user.name}
  heading="Work in progress"
  lede={awaiting
    ? `${awaiting} ${awaiting === 1 ? 'job is' : 'jobs are'} waiting on your review.`
    : open
      ? `${open} ${open === 1 ? 'job is' : 'jobs are'} still under way.`
      : 'Everyone you have hired, what state their work is in, and the money recorded against it.'}
  flash={flash}
>
  {jobs.length === 0 ? (
    <div class="ws-empty">
      <h3>You have not hired anyone yet</h3>
      <p>
        Work appears here the moment you hire someone — either by picking a
        reply to a project you posted, or by a specialist accepting your request
        to work with them. The brief, the conversation, the state of the job and
        every payment recorded against it then stay on this page.
      </p>
      {undecided && undecided.total > 0 ? (
        <a class="btn-hot btn-sm" href="/workspace/company/replies">Decide on your replies</a>
      ) : (
        <a class="btn-hot btn-sm" href="/specialists">Find a specialist</a>
      )}
    </div>
  ) : (
    <div class="stack-sm">
      {jobs.map((j) => {
        const thread = messagesOf(j.id);
        const files = briefFiles(j.id);
        return (
          <article class="panel glass-p" id={`work-${j.id}`}>
            <div class="ws-row-head">
              <div>
                <h2 style="margin:0;">{j.title}</h2>
                <p class="ws-sub">{facts(j)}</p>
                {j.headline && <p class="ws-sub">{j.headline}</p>}
              </div>
              <span class={tone(j.status)}>{engagementStatusLabel(j.status)}</span>
            </div>

            {j.brief && (
              <div class="thread">
                <div class="msg">
                  <p class="who">What you asked for</p>
                  <p>{j.brief}</p>
                </div>
              </div>
            )}

            {j.deliverables && (
              <p class="ws-sub">What you asked to be delivered: {j.deliverables}</p>
            )}

            {agreed(j) && <p class="ws-sub">Agreed: {agreed(j)}</p>}

            {files.length > 0 && (
              <div class="row-sm" style="margin-top:10px;">
                {files.map((file) => (
                  <a class="btn-glass btn-sm" href={fileHref(file)} target="_blank" rel="noopener">
                    {file.filename} · {fileSize(file.size_bytes)}
                  </a>
                ))}
              </div>
            )}

            {j.status === 'active' && (
              <p class="ws-sub">
                Under way with {j.specialist_name}. They hand it over here when it
                is ready, and you will be told the moment they do.
              </p>
            )}

            {j.status === 'delivered' && (
              <p class="ws-sub">
                {j.specialist_name} handed this over on {when(j.updated_at)}. Check
                it, then accept it or tell them what still needs doing.
              </p>
            )}

            {j.status === 'revision' && (
              <p class="ws-sub">
                You asked for changes on {when(j.updated_at)}. It is back
                with {j.specialist_name}.
              </p>
            )}

            {j.status === 'completed' && (
              <p class="ws-sub">Finished on {when(j.updated_at)}.</p>
            )}

            {j.status === 'closed' && (
              <p class="ws-sub">Closed on {when(j.updated_at)}, before it was finished.</p>
            )}

            {j.status === 'disputed' && (
              <p class="ws-sub">
                This work is in dispute. Our team will be in touch — anything
                either side writes in the thread below becomes part of it.
              </p>
            )}

            <div class="stack-sm" style="margin-top:14px;">
              {forJob(j.id).length === 0 ? (
                <p class="ws-sub" style="margin:0;">
                  No money recorded against this work yet. Once an invoice is
                  recorded it — along with everything paid against it — shows up
                  on this line and under Invoices.
                </p>
              ) : forJob(j.id).map((y) => (
                <div class="ws-row-head" style="margin:0;">
                  <p class="ws-sub" style="margin:0;">
                    {paymentKindForCompany(y.kind)} · {money(y)}
                    {y.reference && <span> · {y.reference}</span>}
                    <span> · {when(y.created_at)}</span>
                  </p>
                  <span class={tone(y.status)}>{paymentStatusLabel(y.status)}</span>
                </div>
              ))}
            </div>

            {thread.length > 0 && (
              <div class="thread" style="margin-top:14px;">
                {thread.map((m) => (
                  <div class={`msg ${m.mine ? 'mine' : ''}`}>
                    <p class="who">{m.sender_name} · {when(m.created_at)}</p>
                    <p>{m.body}</p>
                    {m.files.length > 0 && (
                      <div class="row-sm" style="margin-top:10px;">
                        {m.files.map((file) => (
                          <a class="btn-glass btn-sm" href={fileHref(file)} target="_blank" rel="noopener">
                            {file.filename} · {fileSize(file.size_bytes)}
                          </a>
                        ))}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            )}

            {j.status === 'delivered' && (
              <form method="post" class="cform" style="margin-top:14px;">
                <input type="hidden" name="engagementId" value={j.id} />
                <label>
                  <span class="fl">What still needs doing</span>
                  <textarea class="fi" name="note" rows="2"
                            placeholder="Only needed if you are asking for changes. Be specific — this is what they read when the job reopens."></textarea>
                </label>
                <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:center;justify-self:start;">
                  <button class="btn-hot btn-sm" name="action" value="accept" data-busy="Accepting…">
                    Accept the work
                  </button>
                  <button class="btn-glass btn-sm" name="action" value="changes">Ask for changes</button>
                </div>
              </form>
            )}

            <form method="post" class="cform" style="margin-top:14px;">
              <input type="hidden" name="engagementId" value={j.id} />
              <label>
                <span class="fl">{thread.length ? 'Your reply' : `Message ${j.specialist_name}`}</span>
                <textarea class="fi" name="body" rows="2" required minlength="2"
                          placeholder="Anything about this piece of work — both of you see the whole thread here."></textarea>
              </label>
              <button class="btn-glass btn-sm" name="action" value="message"
                      style="justify-self:start;" data-busy="Sending…">Send</button>
            </form>

            <div style="display:flex;flex-wrap:wrap;gap:8px;align-items:flex-start;margin-top:14px;">
              {j.handle && <a class="btn-glass btn-sm" href={`/specialists/${j.handle}`}>View profile</a>}

              {isLive(j) && (
                <details>
                  <summary class="btn-glass btn-sm" style="display:inline-flex;list-style:none;">Raise an issue</summary>
                  <form method="post" class="cform" style="margin-top:12px;">
                    <input type="hidden" name="engagementId" value={j.id} />
                    <label>
                      <span class="fl">What has gone wrong</span>
                      <textarea class="fi" name="issue" rows="3" required minlength="20"
                                placeholder="What was agreed, what has happened instead, and what you have tried."></textarea>
                      <span class="fh">
                        Our team is told straight away and steps in. The work is paused as disputed until it is settled.
                      </span>
                    </label>
                    <button class="btn-hot btn-sm" name="action" value="issue" style="justify-self:start;">Raise it with our team</button>
                  </form>
                </details>
              )}

              {isLive(j) && (
                <details>
                  <summary class="btn-glass btn-sm" style="display:inline-flex;list-style:none;">Close without finishing</summary>
                  <form method="post" class="cform" style="margin-top:12px;">
                    <input type="hidden" name="engagementId" value={j.id} />
                    <label>
                      <span class="fl">Why, in a line</span>
                      <textarea class="fi" name="reason" rows="2"
                                placeholder="Optional — it goes into the thread, so they know where they stand."></textarea>
                      <span class="fh">
                        This ends the work without marking it finished, and closes the
                        {j.from_project === 1 ? ' project' : ' request'} it came from. It cannot be reopened.
                      </span>
                    </label>
                    <button class="btn-glass btn-sm" name="action" value="close" style="justify-self:start;">Close this work</button>
                  </form>
                </details>
              )}
            </div>
          </article>
        );
      })}
    </div>
  )}
</Workspace>
