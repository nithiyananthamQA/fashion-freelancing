---
/**
 * /workspace/freelancer/requests — every company that has asked to hire this
 * specialist, with the answer they are waiting for.
 *
 * On the old single-page workspace these sat below the profile card, so a
 * request that needed an answer today looked exactly like one settled a month
 * ago. Here the ones waiting on the specialist sort to the top, and the
 * accept / decline / ask-a-question / send-a-price actions (§6.4) live on the
 * same card as the brief they refer to.
 */
export const prerender = false;

import Workspace from '../../../layouts/Workspace.astro';
import { all, db, one, run } from '../../../server/db';
import { guard, requireSpecialist } from '../../../server/guards';
import { nowIso } from '../../../server/ids';
import { audit, notify } from '../../../server/audit';
import { parse } from '../../../server/validate';
import { limited, tooManyRequests } from '../../../server/rate-limit';
import { OPEN_REQUEST, startFromRequest } from '../../../server/repo/engagements';
import {
  findThread, listThreads, postMessage, sendMessage, threadKey, threadOf, type Side,
} from '../../../server/repo/threads';
import {
  ATTACHMENT_COLUMNS, fileHref, fileSize, filesBy, type Attachment,
} from '../../../server/repo/attachments';
import { getService } from '../../../data/taxonomy';
import {
  engagementLabel, hireStatusForSpecialist, statusTone, workLocationLabel,
} from '../../../data/labels';
import { freelancerNav } from '../../../data/workspace-nav';

const gate = await guard(Astro, () => requireSpecialist(Astro));
if (gate.response) return gate.response;
const { user, profileId } = gate.value;

const database = db(Astro);
const side: Side = { as: 'specialist', profileId, userId: user.id };
let flash: string | null = null;

/*
 * What this side may do from each state. Accepting is only for a brief still
 * waiting on an answer: once a price has gone back, the next move is the
 * company's, and a specialist "accepting" their own price would be agreeing
 * with nobody. A price can be revised, and the request declined, from any
 * open state.
 */
const ACCEPTABLE = ['sent', 'viewed', 'question'] as const;

const money = (amount: number, currency: string | null) =>
  `${currency ?? 'USD'} ${amount.toLocaleString('en-GB')}`;

/* Answer a request. The id arrives in a form and a form can be replayed, so
   the request is re-fetched scoped to this specialist before anything is
   written — and every write below is guarded on the state it may leave, so a
   replayed accept cannot open a second engagement and a decline cannot land on
   work that has already started. */
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const requestId = String(form.get('requestId') ?? '');
  const action = String(form.get('action') ?? '');

  const request = await one<{ id: string; title: string; created_by: string; status: string; currency: string | null }>(
    database,
    "SELECT id, title, created_by, status, currency FROM hire_requests WHERE id = ? AND profile_id = ? AND status != 'draft'",
    requestId, profileId,
  );

  if (!request) {
    flash = 'That request could not be found.';
  } else if (action === 'accept') {
    const { engagementId, created } = await startFromRequest(database, request.id, ACCEPTABLE);
    if (created) {
      await notify(database, {
        userId: request.created_by, kind: 'hire_accepted',
        title: `${user.name} accepted: ${request.title}`, link: '/workspace/company/work',
      });
      await audit(database, {
        actorId: user.id, action: 'hire_request.answered', entityType: 'hire_request', entityId: request.id,
        detail: { answer: 'accepted' }, request: Astro.request,
      });
      await audit(database, {
        actorId: user.id, action: 'engagement.created', entityType: 'engagement', entityId: engagementId,
        request: Astro.request,
      });
      flash = 'Accepted. The work is now in progress, and the company has been told.';
    } else if (['accepted', 'active', 'completed'].includes(request.status)) {
      flash = 'You have already accepted this one — it is under Work in progress.';
    } else if (request.status === 'proposal') {
      flash = 'You sent this company a price, so the next answer is theirs. Send a different price if it has changed.';
    } else {
      flash = 'This request is no longer open, so it cannot be accepted.';
    }
  } else if (action === 'decline') {
    const result = await run(
      database,
      `UPDATE hire_requests SET status = 'declined', updated_at = ?
        WHERE id = ? AND status IN (${OPEN_REQUEST.map(() => '?').join(',')})`,
      nowIso(), request.id, ...OPEN_REQUEST,
    );
    if (result.meta.changes > 0) {
      await notify(database, {
        userId: request.created_by, kind: 'hire_declined',
        title: `${user.name} declined: ${request.title}`, link: '/workspace/company/requests',
      });
      await audit(database, {
        actorId: user.id, action: 'hire_request.answered', entityType: 'hire_request', entityId: request.id,
        detail: { answer: 'declined' }, request: Astro.request,
      });
      flash = 'Declined. The company has been told.';
    } else {
      flash = 'This request has already been settled, so there is nothing to decline.';
    }
  } else if (action === 'question' || action === 'proposal') {
    if (await limited(database, 'message', user.id)) return tooManyRequests();
    const thread = await findThread(database, side, threadKey('request', request.id));
    const { f, errors } = parse(form);

    if (!thread || !(OPEN_REQUEST as readonly string[]).includes(request.status)) {
      flash = 'This request has already been settled. Anything else goes in Messages.';
    } else if (action === 'question') {
      const body = f.text('body', 'Your question', { required: true, min: 5, max: 2000 });
      if (!body) {
        flash = errors.body ?? 'Write a little more before sending.';
      } else {
        await sendMessage(database, side, thread, user, body);
        // A note after a price leaves the price standing: the company still owes the answer.
        await run(
          database,
          "UPDATE hire_requests SET status = 'question', updated_at = ? WHERE id = ? AND status IN ('sent', 'viewed', 'question')",
          nowIso(), request.id,
        );
        flash = request.status === 'proposal'
          ? 'Sent. Your price still stands until the company answers it.'
          : 'Question sent. It is in your messages too, so you can follow it up there.';
      }
    } else {
      const amount = f.int('amount', 'Your price', { required: true, min: 1, max: 10_000_000 });
      const timeline = f.text('timeline', 'Timeline', { required: true, max: 200 });
      const note = f.text('note', 'What the price covers', { required: true, min: 20, max: 2000 });
      const firstError = Object.values(errors)[0];

      if (firstError || amount === null) {
        flash = `Nothing was sent — ${firstError ?? 'Your price is required.'}`;
      } else {
        const now = nowIso();
        const currency = request.currency ?? 'USD';
        const result = await run(
          database,
          `UPDATE hire_requests
              SET status = 'proposal', proposal_amount = ?, proposal_currency = ?, proposal_timeline = ?,
                  proposed_at = ?, updated_at = ?
            WHERE id = ? AND status IN (${OPEN_REQUEST.map(() => '?').join(',')})`,
          amount, currency, timeline, now, now, request.id, ...OPEN_REQUEST,
        );
        if (result.meta.changes > 0) {
          /* The figure lives on the request so it can be accepted as a figure;
             the thread gets it in words, so the conversation reads in order. */
          await postMessage(database, thread, user.id, `Price: ${money(amount, currency)} · ${timeline}\n\n${note}`);
          await notify(database, {
            userId: request.created_by, kind: 'hire_proposal',
            title: `${user.name} sent a price`,
            body: `${request.title}: ${money(amount, currency)}, ${timeline}.`,
            link: '/workspace/company/requests',
          });
          await audit(database, {
            actorId: user.id, action: 'hire_request.answered', entityType: 'hire_request', entityId: request.id,
            detail: { answer: 'proposal', amount, currency }, request: Astro.request,
          });
          flash = 'Price sent. The company can accept it from their side, and the work starts the moment they do.';
        } else {
          flash = 'This request has already been settled, so the price was not sent.';
        }
      }
    }
  }
}

interface Request {
  id: string;
  title: string;
  brief: string;
  deliverables: string | null;
  status: string;
  service_id: string;
  company_name: string;
  budget_min: number | null;
  budget_max: number | null;
  currency: string | null;
  engagement: string | null;
  work_location: string | null;
  start_date: string | null;
  deadline: string | null;
  nda_required: number;
  created_at: string;
  proposal_amount: number | null;
  proposal_currency: string | null;
  proposal_timeline: string | null;
  proposed_at: string | null;
  /** 0 = the specialist owes an answer, 1 = the company does, 2 = settled. */
  turn: number;
}

const requests = await all<Request>(
  database,
  `SELECT h.id, h.title, h.brief, h.deliverables, h.status, h.service_id, c.name AS company_name,
          h.budget_min, h.budget_max, h.currency, h.engagement, h.work_location,
          h.start_date, h.deadline, h.nda_required, h.created_at,
          h.proposal_amount, h.proposal_currency, h.proposal_timeline, h.proposed_at,
          CASE h.status
            WHEN 'sent'   THEN 0
            WHEN 'viewed' THEN 0
            WHEN 'question' THEN 1
            WHEN 'proposal' THEN 1
            ELSE 2
          END AS turn
     FROM hire_requests h
     JOIN companies c ON c.id = h.company_id
    WHERE h.profile_id = ? AND h.status != 'draft'
    -- your turn first, then anything still open, then the settled ones
    ORDER BY turn, h.created_at DESC`,
  profileId,
);

/* Opening this page is reading the brief, so every request still marked
   'sent' is now 'viewed' — the company's "They have read it" (§9). Written
   after the listing, as project invitations are, so a request that arrived a
   moment ago still counts as new on the render that first shows it. */
await run(
  database,
  "UPDATE hire_requests SET status = 'viewed', updated_at = ? WHERE profile_id = ? AND status = 'sent'",
  nowIso(), profileId,
);

const threads = await listThreads(database, side);

/* Files the company sent with the brief. Ones sent later, in the thread, show
   under the message they came with. */
const briefFiles = filesBy(
  await all<Attachment>(
    database,
    `SELECT ${ATTACHMENT_COLUMNS} FROM attachments at
      WHERE at.scan_status = 'clean' AND at.message_id IS NULL
        AND at.hire_request_id IN (SELECT h.id FROM hire_requests h WHERE h.profile_id = ?)`,
    profileId,
  ),
  'hire_request_id',
);

const messagesOf = (id: string) => threadOf(threads, 'request', id)?.messages ?? [];
const waiting = requests.filter((r) => r.turn === 0).length;

const isOpen = (r: Request) => (OPEN_REQUEST as readonly string[]).includes(r.status);
const canAccept = (r: Request) => (ACCEPTABLE as readonly string[]).includes(r.status);
const isWork = (r: Request) => ['accepted', 'active', 'completed'].includes(r.status);

const day = (iso: string | null) =>
  iso ? new Date(iso).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' }) : '';

/** The money line, in whatever shape the company actually filled in. */
function budget(r: Request): string | null {
  if (r.budget_min === null && r.budget_max === null) return null;
  const unit = r.currency ?? 'USD';
  if (r.budget_min !== null && r.budget_max !== null) return `${unit} ${r.budget_min}–${r.budget_max}`;
  if (r.budget_min !== null) return `${unit} ${r.budget_min} and up`;
  return `Up to ${unit} ${r.budget_max}`;
}

/** Everything worth knowing at a glance, minus the fields left blank. */
function facts(r: Request): string[] {
  return [
    budget(r),
    engagementLabel(r.engagement) || null,
    workLocationLabel(r.work_location) || null,
    r.start_date ? `Starts ${day(r.start_date)}` : null,
    r.deadline ? `Due ${day(r.deadline)}` : null,
    r.nda_required === 1 ? 'NDA required' : null,
  ].filter((x): x is string => Boolean(x));
}

const nav = freelancerNav({ requests: waiting || undefined });
---

<Workspace
  title="Requests to hire you"
  role="freelancer"
  current="/workspace/freelancer/requests"
  items={nav}
  who={user.name}
  heading="Requests to hire you"
  lede={waiting
    ? `${waiting} ${waiting === 1 ? 'request is' : 'requests are'} waiting on your answer.`
    : 'Companies that have asked to work with you, newest first.'}
  flash={flash}
>
  {requests.length === 0 ? (
    <div class="ws-empty">
      <h3>No requests yet</h3>
      <p>
        When a company finds you and asks you to take on a piece of work, their
        brief, budget and dates land here — and you can accept, decline, ask
        them a question or send your own price without leaving the page.
        Listing the services you take on is what puts you in front of them.
      </p>
      <a class="btn-hot btn-sm" href="/workspace/freelancer/services">List your services</a>
    </div>
  ) : (
    <div class="stack-sm">
      {requests.map((request) => {
        const thread = messagesOf(request.id);
        const files = briefFiles(request.id);
        return (
          <article class="panel glass-p">
            <div class="ws-row-head">
              <div>
                <h2 style="margin:0;">{request.title}</h2>
                <p class="ws-sub">
                  {request.company_name} · {getService(request.service_id)?.name} · Asked {day(request.created_at)}
                </p>
              </div>
              <span class={`pill-tone ${statusTone(request.status)}`}>
                {hireStatusForSpecialist(request.status)}
              </span>
            </div>

            <p class="ws-sub" style="white-space:pre-wrap;">{request.brief}</p>

            {request.deliverables && (
              <p class="ws-sub">What they need delivered: {request.deliverables}</p>
            )}

            {facts(request).length > 0 && (
              <p class="ws-sub">{facts(request).join(' · ')}</p>
            )}

            {files.length > 0 && (
              <div class="row-sm" style="margin-top:10px;">
                {files.map((file) => (
                  <a class="btn-glass btn-sm" href={fileHref(file)} target="_blank" rel="noopener">
                    {file.filename} · {fileSize(file.size_bytes)}
                  </a>
                ))}
              </div>
            )}

            {thread.length > 0 && (
              <div class="thread" style="margin-top:14px;">
                {thread.map((m) => (
                  <div class={`msg ${m.mine ? 'mine' : ''}`}>
                    <p class="who">{m.sender_name}</p>
                    <p>{m.body}</p>
                  </div>
                ))}
              </div>
            )}

            {request.status === 'proposal' && request.proposal_amount !== null && (
              <p class="ws-sub" style="margin-top:12px;">
                You offered {money(request.proposal_amount, request.proposal_currency)}
                {request.proposal_timeline && <span> · {request.proposal_timeline}</span>}
                {request.proposed_at && <span> · sent {day(request.proposed_at)}</span>}.
                It is with {request.company_name} to accept — the work starts the moment they do.
              </p>
            )}

            {isOpen(request) && (
              <div class="stack-sm" style="margin-top:16px;">
                <div style="display:flex;gap:10px;flex-wrap:wrap;">
                  {canAccept(request) && (
                    <form method="post">
                      <input type="hidden" name="requestId" value={request.id} />
                      <button class="btn-hot btn-sm" name="action" value="accept" data-busy="Accepting…">Accept</button>
                    </form>
                  )}
                  <form method="post">
                    <input type="hidden" name="requestId" value={request.id} />
                    <button class="btn-glass btn-sm" name="action" value="decline">Decline</button>
                  </form>
                </div>

                <details>
                  <summary class="btn-glass btn-sm" style="display:inline-flex;list-style:none;">
                    {request.status === 'proposal' ? 'Send a different price' : 'Send a price'}
                  </summary>
                  <form method="post" class="cform" style="margin-top:12px;" novalidate>
                    <input type="hidden" name="requestId" value={request.id} />
                    <div class="row2">
                      <label>
                        <span class="fl">Your price ({request.currency ?? 'USD'})<span class="rq" aria-hidden="true">*</span></span>
                        <input class="fi" type="number" name="amount" min="1" step="1" required />
                      </label>
                      <label>
                        <span class="fl">Timeline you can commit to<span class="rq" aria-hidden="true">*</span></span>
                        <input class="fi" type="text" name="timeline" maxlength="200" required placeholder="e.g. 10 working days" />
                      </label>
                    </div>
                    <label>
                      <span class="fl">What the price covers<span class="rq" aria-hidden="true">*</span></span>
                      <textarea class="fi" name="note" rows="3" required minlength="20"
                                placeholder="What is included, what is not, and anything you need from them to start."></textarea>
                    </label>
                    <span class="fh">
                      If they accept, the work starts straight away — so only send a price you are ready to work to.
                    </span>
                    <button class="btn-hot btn-sm" name="action" value="proposal" style="justify-self:start;" data-busy="Sending…">
                      Send price
                    </button>
                  </form>
                </details>

                <details>
                  <summary class="btn-glass btn-sm" style="display:inline-flex;list-style:none;">
                    {request.status === 'proposal' ? 'Add a note' : 'Ask a question'}
                  </summary>
                  <form method="post" class="cform" style="margin-top:12px;">
                    <input type="hidden" name="requestId" value={request.id} />
                    <label>
                      <span class="fl">{request.status === 'proposal' ? 'Your note' : 'Your question'}</span>
                      <textarea class="fi" name="body" rows="3" required minlength="5"
                                placeholder="What do you still need to know before you can quote?"></textarea>
                    </label>
                    <button class="btn-hot btn-sm" name="action" value="question" style="justify-self:start;" data-busy="Sending…">
                      {request.status === 'proposal' ? 'Send note' : 'Send question'}
                    </button>
                  </form>
                </details>
              </div>
            )}

            {isWork(request) && (
              <div style="margin-top:14px;">
                <a class="btn-glass btn-sm" href="/workspace/freelancer/work">See the work</a>
              </div>
            )}
          </article>
        );
      })}
    </div>
  )}
</Workspace>
