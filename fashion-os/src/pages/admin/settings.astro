---
import Admin from '@/layouts/Admin.astro';
---
<Admin title="Settings" pageTitle="Admin settings" current="set">

  <div class="grid grid-cols-12 gap-8">
    <aside class="col-span-12 lg:col-span-3">
      <div class="card p-2 sticky top-24">
        <a href="#policies" class="flex justify-between px-3 py-2.5 rounded-lg text-sm bg-ink text-paper">Policies</a>
        <a href="#auto" class="flex justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">Automation rules</a>
        <a href="#staff" class="flex justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">Staff &amp; roles</a>
        <a href="#audit" class="flex justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">Audit log</a>
      </div>
    </aside>

    <div class="col-span-12 lg:col-span-9 space-y-6">
      <section id="policies" class="card p-6">
        <h2 class="display text-xl">Trust &amp; safety policies</h2>
        <p class="text-sm text-ink-5 mt-1">Thresholds for automated actions.</p>
        <div class="mt-6 space-y-4">
          <div class="flex items-center justify-between p-4 border border-line rounded-xl">
            <div><div class="font-medium text-sm">Auto-pause threshold</div><div class="text-xs text-ink-5">Risk score above which accounts are paused for manual review</div></div>
            <div class="display text-2xl">85</div>
          </div>
          <div class="flex items-center justify-between p-4 border border-line rounded-xl">
            <div><div class="font-medium text-sm">Dispute SLA</div><div class="text-xs text-ink-5">Target resolution time for disputes</div></div>
            <div class="display text-2xl">48h</div>
          </div>
          <div class="flex items-center justify-between p-4 border border-line rounded-xl">
            <div><div class="font-medium text-sm">Verification SLA</div><div class="text-xs text-ink-5">Max wait for new creator review</div></div>
            <div class="display text-2xl">48h</div>
          </div>
        </div>
      </section>

      <section id="staff" class="card p-6">
        <h2 class="display text-xl">Staff</h2>
        <div class="mt-4 space-y-2">
          {[
            ['Sara Lindqvist','Editor-in-chief','Full access'],
            ['Marc Olivier','CTO','Full access'],
            ['Layla Khan','Trust &amp; safety','Moderation, disputes, fraud'],
            ['Tom Henderson','Support','Disputes, reports'],
          ].map(p => (
            <div class="flex items-center justify-between p-4 border border-line rounded-xl">
              <div><div class="font-medium text-sm" set:html={p[0]}></div><div class="text-xs text-ink-5" set:html={p[1]}></div></div>
              <div class="text-xs text-ink-5">{p[2]}</div>
              <button class="btn btn-ghost btn-sm">Edit</button>
            </div>
          ))}
        </div>
      </section>

      <section id="audit" class="card p-6">
        <h2 class="display text-xl">Audit log · last 24h</h2>
        <div class="mt-4 space-y-2 font-mono text-xs">
          <div class="p-2 border-l-2 border-line"><span class="text-ink-5">12:42</span> · Layla approved verification ver-128 (@yuna_aoki)</div>
          <div class="p-2 border-l-2 border-rose-200"><span class="text-ink-5">11:38</span> · System suspended @rapid_buyer_91 (fraud · score 92)</div>
          <div class="p-2 border-l-2 border-line"><span class="text-ink-5">10:14</span> · Marc updated dispute SLA: 36h → 48h</div>
          <div class="p-2 border-l-2 border-line"><span class="text-ink-5">09:02</span> · Tom resolved dispute dsp-019 (refund issued)</div>
          <div class="p-2 border-l-2 border-line"><span class="text-ink-5">08:00</span> · System processed 47 verification submissions</div>
        </div>
      </section>
    </div>
  </div>

</Admin>
