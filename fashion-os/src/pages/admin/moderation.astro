---
import Admin from '@/layouts/Admin.astro';
const items = [
  { id:'mod-001', type:'gig', reason:'IP / copied work', target:'Tech pack template - knockoff', user:'@designer_482', flags:7, age:'2h', risk:'high' },
  { id:'mod-002', type:'review', reason:'Spam', target:'5★ fake review burst', user:'@buyer_19', flags:3, age:'5h', risk:'med' },
  { id:'mod-003', type:'gig', reason:'NSFW imagery', target:'Lingerie editorial gig', user:'@stylist_alpha', flags:2, age:'12h', risk:'low' },
  { id:'mod-004', type:'message', reason:'Off-platform payment', target:'Buyer requested Wise transfer', user:'@buyer_44', flags:1, age:'1d', risk:'high' },
  { id:'mod-005', type:'profile', reason:'Misrepresentation', target:'Claimed Vogue cover · unverified', user:'@stylist_zara', flags:4, age:'1d', risk:'med' },
];
const riskClass = (r: string) => ({ high: 'pill-rose', med: 'pill-champagne', low: 'pill-gray' }[r] ?? 'pill-gray');
---
<Admin title="Moderation" pageTitle="Moderation queue · 24" current="mod">

  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div class="flex gap-2">
      <button class="chip chip-active">All · 24</button>
      <button class="chip">Services · 12</button>
      <button class="chip">Reviews · 4</button>
      <button class="chip">Messages · 5</button>
      <button class="chip">Profiles · 3</button>
    </div>
    <div class="flex gap-2">
      <select class="input !py-1.5 !text-xs !w-auto"><option>Highest risk</option><option>Newest</option></select>
      <button class="btn btn-ghost btn-sm">Bulk approve</button>
    </div>
  </div>

  <div class="card overflow-hidden">
    <div class="overflow-x-auto -mx-px"><table class="w-full">
      <thead>
        <tr class="bg-paper text-[11px] mono uppercase tracking-wider text-ink-5">
          <th class="text-left px-6 py-3 font-medium">ID</th>
          <th class="text-left px-6 py-3 font-medium">Type</th>
          <th class="text-left px-6 py-3 font-medium">Target</th>
          <th class="text-left px-6 py-3 font-medium">Reason</th>
          <th class="text-left px-6 py-3 font-medium">User</th>
          <th class="text-left px-6 py-3 font-medium">Flags</th>
          <th class="text-left px-6 py-3 font-medium">Risk</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {items.map(i => (
          <tr class="border-t border-line hover:bg-paper-2/50 transition" data-mod-id={i.id}>
            <td class="px-6 py-4 mono text-xs text-ink-5">{i.id}</td>
            <td class="px-6 py-4 text-sm capitalize">{i.type}</td>
            <td class="px-6 py-4 text-sm font-medium">{i.target}</td>
            <td class="px-6 py-4 text-sm text-ink-3">{i.reason}</td>
            <td class="px-6 py-4 text-sm mono">{i.user}</td>
            <td class="px-6 py-4 text-sm tabular-nums">{i.flags}</td>
            <td class="px-6 py-4"><span class={riskClass(i.risk)}>{i.risk}</span></td>
            <td class="px-6 py-4 text-right">
              <div class="flex gap-1.5 justify-end">
                <button type="button" class="btn btn-ghost btn-sm" data-act="approve">Approve</button>
                <button type="button" class="btn btn-ghost btn-sm border-rose-200 text-rose-700" data-act="remove">Remove</button>
              </div>
            </td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </div>

  <div id="mod-empty" class="card p-10 text-center text-ink-500 hidden">
    <div class="text-4xl mb-3">✓</div>
    <div class="font-medium text-ink mb-1">Queue cleared</div>
    <div class="text-sm">All flagged items have been resolved.</div>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const UI = window.UI;
        const rows = document.querySelectorAll('[data-mod-id]');
        const empty = document.getElementById('mod-empty');
        rows.forEach(row => {
          row.querySelectorAll('[data-act]').forEach(btn => {
            btn.addEventListener('click', () => {
              const act = btn.getAttribute('data-act');
              const msg = act === 'approve' ? 'Approved — kept on platform.' : 'Removed — content taken down.';
              row.style.transition = 'opacity .25s, transform .25s';
              row.style.opacity = '0';
              row.style.transform = 'translateX(8px)';
              setTimeout(() => {
                row.remove();
                if (!document.querySelectorAll('[data-mod-id]').length && empty) {
                  empty.classList.remove('hidden');
                }
              }, 250);
              UI && UI.toast(msg, { kind: act === 'approve' ? 'success' : 'info' });
            });
          });
        });
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Admin>
