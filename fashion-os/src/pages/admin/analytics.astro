---
import Admin from '@/layouts/Admin.astro';
---
<Admin title="Analytics" pageTitle="Analytics" current="an">

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">DAU</div><div class="display text-2xl mt-1">3,420</div><div class="text-xs text-emerald-700 mt-1">↗ +18%</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">Signup → first order</div><div class="display text-2xl mt-1">42%</div><div class="text-xs text-ink-5 mt-1">7-day cohort</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">Order completion</div><div class="display text-2xl mt-1">88%</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">D30 retention</div><div class="display text-2xl mt-1">71%</div></div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8 card p-6">
      <h2 class="display text-xl mb-4">Funnel · last 30d</h2>
      <div class="space-y-3">
        {[
          ['Visited homepage', 142_840, 100],
          ['Browsed marketplace', 84_210, 59],
          ['Viewed a freelancer', 38_420, 27],
          ['Started checkout', 12_840, 9],
          ['Completed order', 9_120, 6.4],
        ].map(([label, n, pct]) => (
          <div>
            <div class="flex items-center justify-between text-sm">
              <span>{label}</span>
              <span class="tabular-nums"><strong>{n.toLocaleString()}</strong> <span class="text-ink-5">· {pct}%</span></span>
            </div>
            <div class="mt-2 h-2 bg-paper-2 rounded-full overflow-hidden">
              <div class="h-full bg-gradient-to-r from-champagne to-champagne-2" style={`width: ${pct}%`}></div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 space-y-4">
      <div class="card p-6">
        <h3 class="display text-lg">Top traffic sources</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="flex justify-between"><span>Direct</span><strong>32%</strong></li>
          <li class="flex justify-between"><span>Google organic</span><strong>28%</strong></li>
          <li class="flex justify-between"><span>Instagram</span><strong>14%</strong></li>
          <li class="flex justify-between"><span>Pinterest</span><strong>9%</strong></li>
          <li class="flex justify-between"><span>Newsletter</span><strong>7%</strong></li>
        </ul>
      </div>
      <div class="card p-6">
        <h3 class="display text-lg">Top countries</h3>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="flex justify-between"><span>🇺🇸 US</span><strong>22%</strong></li>
          <li class="flex justify-between"><span>🇫🇷 FR</span><strong>14%</strong></li>
          <li class="flex justify-between"><span>🇮🇹 IT</span><strong>12%</strong></li>
          <li class="flex justify-between"><span>🇯🇵 JP</span><strong>10%</strong></li>
          <li class="flex justify-between"><span>🇮🇳 IN</span><strong>9%</strong></li>
        </ul>
      </div>
    </div>
  </div>

</Admin>
