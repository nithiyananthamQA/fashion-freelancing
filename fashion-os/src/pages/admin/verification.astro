---
import Admin from '@/layouts/Admin.astro';
---
<Admin title="Verifications" pageTitle="Verifications" current="ver">

  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div class="flex gap-2">
      <button class="chip chip-active" data-filter="pending">Pending · <span id="cnt-pending">0</span></button>
      <button class="chip" data-filter="approved">Approved · <span id="cnt-approved">0</span></button>
      <button class="chip" data-filter="rejected">Rejected · <span id="cnt-rejected">0</span></button>
    </div>
  </div>

  <div id="vq-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    <div class="card p-10 text-center text-ink-500 col-span-full">Loading queue…</div>
  </div>

  <!-- Wired to api.freelancers.list / approve / reject -->
  <script is:inline>
    (function () {
      function init() {
        var api = window.api, UI = window.UI;
        if (!api) return;
        var grid = document.getElementById('vq-grid');
        var filter = 'pending';

        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) {
            return { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c];
          });
        }

        async function refresh() {
          // Pull all three buckets so the counts stay live, and render the
          // current filter into the grid.
          var [pending, approved, rejected] = await Promise.all([
            api.freelancers.list({ approvalStatus: 'pending', perPage: 100 }),
            api.freelancers.list({ approvalStatus: 'approved', perPage: 100 }),
            api.freelancers.list({ approvalStatus: 'rejected', perPage: 100 }),
          ]);
          document.getElementById('cnt-pending').textContent = pending.items.length;
          document.getElementById('cnt-approved').textContent = approved.items.length;
          document.getElementById('cnt-rejected').textContent = rejected.items.length;

          var items = filter === 'approved' ? approved.items : filter === 'rejected' ? rejected.items : pending.items;
          if (!items.length) {
            grid.innerHTML = '<div class="card p-10 text-center text-ink-500 col-span-full">' +
              (filter === 'pending' ? 'Queue empty — nothing pending right now.' : 'No freelancers in this bucket.') +
              '</div>';
            return;
          }
          grid.innerHTML = items.map(function (f) {
            var portfolioCount = (f.portfolio && f.portfolio.length) || 0;
            var coverImg = f.cover || (f.portfolio && f.portfolio[0] && f.portfolio[0].imageUrl) || 'https://images.unsplash.com/photo-1488161628813-04466f872be2?w=800&auto=format&fit=crop';
            var statusPill = f.approvalStatus === 'approved' ? 'pill-green'
                             : f.approvalStatus === 'rejected' ? 'pill-rose' : 'pill-champagne';
            var actions = f.approvalStatus === 'pending'
              ? '<button class="btn btn-primary btn-sm flex-1" data-act="approve" data-id="' + esc(f.id) + '">Approve</button>' +
                '<button class="btn btn-ghost btn-sm border-rose-200 text-rose-700" data-act="reject" data-id="' + esc(f.id) + '">Reject</button>'
              : f.approvalStatus === 'approved'
                ? '<button class="btn btn-ghost btn-sm" data-act="reject" data-id="' + esc(f.id) + '">Move to rejected</button>'
                : '<button class="btn btn-primary btn-sm" data-act="approve" data-id="' + esc(f.id) + '">Approve anyway</button>';
            return '' +
              '<div class="card overflow-hidden">' +
                '<div class="aspect-[5/3] bg-paper-2 relative">' +
                  '<img src="' + esc(coverImg) + '" alt="" class="w-full h-full object-cover"/>' +
                  '<span class="pill absolute top-3 right-3 ' + statusPill + '">' + esc(f.approvalStatus) + '</span>' +
                '</div>' +
                '<div class="p-5">' +
                  '<div class="flex items-center gap-3">' +
                    '<img src="' + esc(f.avatar) + '" class="w-10 h-10 rounded-full object-cover -mt-9 ring-2 ring-white" alt=""/>' +
                    '<div class="flex-1 min-w-0">' +
                      '<div class="font-medium text-sm">' + esc(f.name) + '</div>' +
                      '<div class="text-xs text-ink-500">' + esc((f.serviceSlug || '').replace(/-/g, ' ')) + ' · ' + esc(f.city || '') + '</div>' +
                    '</div>' +
                  '</div>' +
                  '<div class="mt-3 grid grid-cols-3 gap-2 text-xs">' +
                    '<div class="text-center"><div class="text-ink-500">Portfolio</div><div class="font-medium mt-0.5">' + portfolioCount + ' items</div></div>' +
                    '<div class="text-center"><div class="text-ink-500">Headline</div><div class="font-medium mt-0.5">' + (f.headline ? '✓' : '—') + '</div></div>' +
                    '<div class="text-center"><div class="text-ink-500">Submitted</div><div class="font-medium mt-0.5">' + esc(api.fmt.timeAgo(f.createdAt)) + '</div></div>' +
                  '</div>' +
                  (f.bio ? '<div class="mt-3 text-xs text-ink-500 line-clamp-2">' + esc(f.bio) + '</div>' : '') +
                  (f.approvalStatus === 'rejected' && f.approvalReason
                    ? '<div class="mt-3 text-xs text-rose-700 bg-rose-50 border border-rose-100 rounded-lg p-2"><strong>Reason:</strong> ' + esc(f.approvalReason) + '</div>'
                    : '') +
                  '<div class="mt-4 flex gap-1.5">' + actions + '</div>' +
                '</div>' +
              '</div>';
          }).join('');

          // Wire approve/reject buttons
          grid.querySelectorAll('[data-act]').forEach(function (btn) {
            btn.addEventListener('click', async function () {
              var id = btn.dataset.id;
              var act = btn.dataset.act;
              btn.disabled = true; btn.textContent = '…';
              try {
                if (act === 'approve') {
                  await api.freelancers.approve(id);
                  UI && UI.toast('Approved.', { kind: 'success' });
                } else {
                  var reason = prompt('Why are you rejecting this profile? (Shown to the freelancer.)');
                  if (!reason) { btn.disabled = false; btn.textContent = 'Reject'; return; }
                  await api.freelancers.reject(id, reason);
                  UI && UI.toast('Rejected.', { kind: 'success' });
                }
                refresh();
              } catch (err) {
                UI && UI.toast(err.message || 'Action failed', { kind: 'error' });
                btn.disabled = false;
              }
            });
          });
        }

        // Filter tabs
        document.querySelectorAll('[data-filter]').forEach(function (b) {
          b.addEventListener('click', function () {
            document.querySelectorAll('[data-filter]').forEach(function (x) { x.classList.remove('chip-active'); });
            b.classList.add('chip-active');
            filter = b.dataset.filter;
            refresh();
          });
        });

        refresh();
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Admin>
