---
import Admin from '@/layouts/Admin.astro';
import { creators } from '@/data/mock';
const queue = creators.slice(0, 6).map((c, i) => ({
  ...c,
  submittedAgo: ['12m','1h','3h','6h','1d','1d'][i],
  status: ['new','reviewing','reviewing','holding','reviewing','new'][i],
  score: [94, 88, 92, 65, 86, 91][i],
}));
---
<Admin title="Verifications" pageTitle="Verifications · 47" current="ver">

  <div class="flex items-center justify-between mb-6 flex-wrap gap-3">
    <div class="flex gap-2">
      <button class="chip chip-active">All · 47</button>
      <button class="chip">New · 14</button>
      <button class="chip">Reviewing · 22</button>
      <button class="chip">Holding · 8</button>
      <button class="chip">Approved today · 12</button>
    </div>
    <div class="flex gap-2">
      <select class="input !py-1.5 !text-xs !w-auto"><option>Auto-score: high → low</option><option>Submitted: newest</option></select>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
    {queue.map(q => (
      <div class="card overflow-hidden">
        <div class="aspect-[5/3] bg-paper-2 relative">
          <img src={q.cover} alt="" class="w-full h-full object-cover"/>
          <span class={`pill absolute top-3 right-3 ${q.score >= 85 ? 'pill-green' : q.score >= 70 ? 'pill-champagne' : 'pill-rose'}`}>AI score · {q.score}</span>
        </div>
        <div class="p-5">
          <div class="flex items-center gap-3">
            <img src={q.avatar} class="w-10 h-10 rounded-full object-cover -mt-9 ring-2 ring-white" alt=""/>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm">{q.name}</div>
              <div class="text-xs text-ink-5">{q.specialty} · {q.location.split(',')[0]}</div>
            </div>
            <span class={`pill ${q.status === 'reviewing' ? 'pill-champagne' : q.status === 'holding' ? 'pill-rose' : 'pill-blue'}`}>{q.status}</span>
          </div>
          <div class="mt-3 grid grid-cols-3 gap-2 text-xs">
            <div class="text-center"><div class="text-ink-5">Portfolio</div><div class="font-medium mt-0.5">{q.portfolio.length} items</div></div>
            <div class="text-center"><div class="text-ink-5">Bio</div><div class="font-medium mt-0.5">{q.bio ? '✓' : '—'}</div></div>
            <div class="text-center"><div class="text-ink-5">Submitted</div><div class="font-medium mt-0.5">{q.submittedAgo}</div></div>
          </div>
          <div class="mt-4 flex gap-1.5">
            <button class="btn btn-primary btn-sm flex-1">Approve</button>
            <button class="btn btn-ghost btn-sm flex-1">Hold</button>
            <button class="btn btn-ghost btn-sm border-rose-200 text-rose-700">Reject</button>
          </div>
        </div>
      </div>
    ))}
  </div>

</Admin>
