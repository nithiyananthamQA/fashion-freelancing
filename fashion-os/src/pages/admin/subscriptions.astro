---
import Admin from '@/layouts/Admin.astro';
---
<Admin title="Subscriptions" pageTitle="Subscriptions" current="subs">

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 mb-6">
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">MRR</div><div class="display gold-text text-2xl mt-1">$84,200</div><div class="text-xs text-emerald-700 mt-1">↗ +12%</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">Pro Creator</div><div class="display text-2xl mt-1">2,142</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">Studio (brand)</div><div class="display text-2xl mt-1">187</div></div>
    <div class="card p-4"><div class="text-[11px] mono uppercase text-ink-5">Enterprise</div><div class="display text-2xl mt-1">42</div></div>
  </div>

  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-line flex items-center gap-2 flex-wrap">
      <button class="chip chip-active">All plans</button>
      <button class="chip">Active</button>
      <button class="chip">Past due</button>
      <button class="chip">Cancelled</button>
      <button class="chip">Refunded</button>
    </div>
    <div class="overflow-x-auto -mx-px"><table class="w-full">
      <thead>
        <tr class="bg-paper text-[11px] mono uppercase tracking-wider text-ink-5">
          <th class="text-left px-6 py-3 font-medium">User</th>
          <th class="text-left px-6 py-3 font-medium">Plan</th>
          <th class="text-left px-6 py-3 font-medium">Started</th>
          <th class="text-left px-6 py-3 font-medium">Renews</th>
          <th class="text-left px-6 py-3 font-medium">Amount</th>
          <th class="text-left px-6 py-3 font-medium">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody>
        {[
          ['Yuna Aoki','Pro Creator','Apr 2024','May 28','$24/mo','active'],
          ['Auriga','Enterprise','Jan 2025','Annual','$2,880/yr','active'],
          ['Marco Reyes','Pro Creator','Feb 2025','May 28','$24/mo','past_due'],
          ['Vestra','Studio','Sep 2024','Jun 14','$199/mo','active'],
          ['Sofia Rosso','Pro Creator','Mar 2024','—','—','cancelled'],
        ].map(r => (
          <tr class="border-t border-line hover:bg-paper-2/50 transition">
            <td class="px-6 py-4 text-sm font-medium">{r[0]}</td>
            <td class="px-6 py-4 text-sm">{r[1]}</td>
            <td class="px-6 py-4 text-sm text-ink-5">{r[2]}</td>
            <td class="px-6 py-4 text-sm text-ink-5">{r[3]}</td>
            <td class="px-6 py-4 text-sm tabular-nums">{r[4]}</td>
            <td class="px-6 py-4"><span class={r[5] === 'active' ? 'pill-green' : r[5] === 'past_due' ? 'pill-rose' : 'pill-gray'}>{r[5].replace('_',' ')}</span></td>
            <td class="px-6 py-4 text-right"><button class="btn btn-ghost btn-sm">Manage</button></td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </div>

</Admin>
