---
import Admin from '@/layouts/Admin.astro';
---
<Admin title="Dashboard" pageTitle="Admin · Overview" current="dash">

  <!-- Top KPIs (live from the store; static demo numbers shown until ff:ready) -->
  <div class="grid grid-cols-2 lg:grid-cols-5 gap-4 mb-8">
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Active users</div>
      <div id="kpi-users" class="display text-3xl mt-1 tabular-nums">—</div>
      <div class="text-xs text-emerald-700 mt-1">live count from store</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">GMV · MTD</div>
      <div id="kpi-gmv" class="display text-3xl mt-1 gold-text tabular-nums">—</div>
      <div class="text-xs text-emerald-700 mt-1">summed from orders</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Active orders</div>
      <div id="kpi-orders" class="display text-3xl mt-1 tabular-nums">—</div>
      <div class="text-xs text-ink-5 mt-1">ordered + in-progress + delivered</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Pending review</div>
      <div id="kpi-pending" class="display text-3xl mt-1 tabular-nums text-rose-700">—</div>
      <div class="text-xs text-rose-700 mt-1"><span id="kpi-pending-detail">freelancers awaiting approval</span></div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Trust &amp; safety score</div>
      <div id="kpi-trust" class="display text-3xl mt-1 tabular-nums">—</div>
      <div class="text-xs text-emerald-700 mt-1">% of orders without dispute</div>
    </div>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const api = window.api;
        if (!api || !api._store) return;
        const state = api._store.getState();
        const $ = id => document.getElementById(id);
        const fmt = n => (n | 0).toLocaleString();

        const users = state.users || [];
        const orders = state.orders || [];
        const freelancers = state.freelancers || [];

        // 1. Active users
        if ($('kpi-users')) $('kpi-users').textContent = fmt(users.length);

        // 2. GMV — sum amounts (cents) on completed and in-progress orders
        const gmvCents = orders.reduce((s, o) => s + ((o.amount && o.amount.amount) || 0), 0);
        if ($('kpi-gmv')) {
          const gmv = gmvCents / 100;
          $('kpi-gmv').textContent = gmv >= 1000000 ? '$' + (gmv / 1000000).toFixed(1) + 'M'
            : gmv >= 1000 ? '$' + (gmv / 1000).toFixed(1) + 'k'
            : '$' + (gmv | 0).toLocaleString();
        }

        // 3. Active orders — anything not closed/cancelled
        const activeStatuses = new Set(['ordered','in_progress','delivered']);
        const active = orders.filter(o => activeStatuses.has(o.status));
        if ($('kpi-orders')) $('kpi-orders').textContent = fmt(active.length);

        // 4. Pending review — freelancers waiting on admin
        const pending = freelancers.filter(f => f.approvalStatus === 'pending');
        if ($('kpi-pending')) $('kpi-pending').textContent = fmt(pending.length);
        if ($('kpi-pending-detail')) {
          $('kpi-pending-detail').textContent = pending.length === 1
            ? 'freelancer awaiting approval'
            : 'freelancers awaiting approval';
        }

        // 5. Trust score — % of orders without a dispute marker
        const disputed = orders.filter(o => o.status === 'disputed').length;
        const trust = orders.length ? (100 * (1 - disputed / orders.length)) : 100;
        if ($('kpi-trust')) $('kpi-trust').textContent = trust.toFixed(1);
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

  <div class="grid grid-cols-12 gap-6">

    <!-- Queues -->
    <div class="col-span-12 lg:col-span-8 space-y-6">
      <div class="card p-6">
        <h2 class="display text-xl mb-4">Action queues</h2>
        <div class="grid grid-cols-2 lg:grid-cols-4 gap-4">
          <a href="/admin/moderation" class="p-4 border border-line rounded-xl hover:border-ink-7 transition">
            <div class="text-xs text-ink-5 uppercase tracking-wider">Moderation</div>
            <div class="display text-2xl mt-1 text-rose-700">24</div>
            <div class="text-xs text-ink-5 mt-1">flagged content</div>
          </a>
          <a href="/admin/verification" class="p-4 border border-line rounded-xl hover:border-ink-7 transition">
            <div class="text-xs text-ink-5 uppercase tracking-wider">Verifications</div>
            <div class="display text-2xl mt-1 text-rose-700">47</div>
            <div class="text-xs text-ink-5 mt-1">pending review</div>
          </a>
          <a href="/admin/disputes" class="p-4 border border-line rounded-xl hover:border-ink-7 transition">
            <div class="text-xs text-ink-5 uppercase tracking-wider">Disputes</div>
            <div class="display text-2xl mt-1 text-rose-700">8</div>
            <div class="text-xs text-ink-5 mt-1">open · &lt;48h SLA</div>
          </a>
          <a href="/admin/fraud" class="p-4 border border-line rounded-xl hover:border-ink-7 transition">
            <div class="text-xs text-ink-5 uppercase tracking-wider">Fraud signals</div>
            <div class="display text-2xl mt-1 text-rose-700">3</div>
            <div class="text-xs text-ink-5 mt-1">high-risk accounts</div>
          </a>
        </div>
      </div>

      <!-- GMV chart -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="display text-xl">GMV · last 12 months</h2>
          <select class="input !py-1.5 !text-xs !w-auto"><option>All time</option></select>
        </div>
        <div class="flex items-end gap-2 h-48">
          {[42, 48, 52, 58, 64, 68, 72, 78, 86, 91, 102, 124].map((h, i) => (
            <div class="flex-1 flex flex-col items-center gap-2">
              <div class="w-full rounded-t-md transition-all" style={`height: ${h}%; background: linear-gradient(180deg, #6E56F0, #5468F5);`}></div>
              <div class="text-[10px] mono text-ink-5 uppercase">{['Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr','May'][i]}</div>
            </div>
          ))}
        </div>
      </div>

      <!-- Recent activity -->
      <div class="card p-6">
        <h2 class="display text-xl mb-4">Recent activity</h2>
        <div class="space-y-3 text-sm">
          <div class="flex gap-3"><span class="w-2 h-2 rounded-full bg-rose-500 mt-2 flex-shrink-0"></span><div><strong>Dispute opened</strong> · order #o4 (Vestra) · escalated to senior agent<div class="text-xs text-ink-5">2 min ago</div></div></div>
          <div class="flex gap-3"><span class="w-2 h-2 rounded-full bg-emerald-500 mt-2 flex-shrink-0"></span><div><strong>47 portfolios verified</strong> · weekly batch processed<div class="text-xs text-ink-5">1 hour ago</div></div></div>
          <div class="flex gap-3"><span class="w-2 h-2 rounded-full bg-champagne mt-2 flex-shrink-0"></span><div><strong>Account suspended</strong> · @fakeuser_191 · fraud · auto-flagged<div class="text-xs text-ink-5">3 hours ago</div></div></div>
          <div class="flex gap-3"><span class="w-2 h-2 rounded-full bg-sky-500 mt-2 flex-shrink-0"></span><div><strong>New service category</strong> · "AI fashion prompting" · 184 creators in 48h<div class="text-xs text-ink-5">Yesterday</div></div></div>
        </div>
      </div>
    </div>

    <aside class="col-span-12 lg:col-span-4 space-y-6">
      <div class="card p-6 bg-rose-50 border-rose-100">
        <div class="text-rose-700 text-xs uppercase tracking-wider font-medium">High priority</div>
        <div class="display text-lg mt-2 text-rose-900">3 fraud signals need review</div>
        <p class="text-sm text-rose-700/80 mt-1">Auto-flagged accounts with payment-velocity anomalies.</p>
        <a href="/admin/fraud" class="btn btn-primary w-full mt-4">Review now</a>
      </div>

      <div class="card p-6">
        <h3 class="display text-lg">Top services this week</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex justify-between"><span>Tech pack designer</span><strong class="tabular-nums">312</strong></li>
          <li class="flex justify-between"><span>Fashion photography</span><strong class="tabular-nums">248</strong></li>
          <li class="flex justify-between"><span>Pattern maker</span><strong class="tabular-nums">196</strong></li>
          <li class="flex justify-between"><span>AI fashion prompting</span><strong class="tabular-nums text-emerald-700">184 ↗</strong></li>
          <li class="flex justify-between"><span>UI/UX (Figma)</span><strong class="tabular-nums">142</strong></li>
        </ul>
      </div>

      <div class="card p-6">
        <h3 class="display text-lg">System health</h3>
        <ul class="mt-4 space-y-3 text-sm">
          <li class="flex justify-between"><span class="text-ink-5">API uptime · 30d</span><span class="text-emerald-700">99.99%</span></li>
          <li class="flex justify-between"><span class="text-ink-5">P95 latency</span><span class="tabular-nums">142ms</span></li>
          <li class="flex justify-between"><span class="text-ink-5">Error rate</span><span class="tabular-nums">0.04%</span></li>
          <li class="flex justify-between"><span class="text-ink-5">Stripe webhooks</span><span class="text-emerald-700">healthy</span></li>
        </ul>
      </div>
    </aside>
  </div>

</Admin>
