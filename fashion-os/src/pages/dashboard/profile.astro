---
import Dashboard from '@/layouts/Dashboard.astro';
---
<Dashboard title="Edit profile" pageTitle="Edit profile" current="profile" role="creator">

  <div class="grid grid-cols-12 gap-6">
    <!-- Form -->
    <div class="col-span-12 lg:col-span-8 space-y-6">

      <div class="card p-6">
        <h2 class="editorial text-xl mb-1">Identity</h2>
        <p class="text-sm text-ink-500 mb-5">How you appear across the platform.</p>

        <div class="flex items-center gap-5 mb-6">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200&auto=format&fit=crop" class="w-20 h-20 rounded-full object-cover" alt=""/>
          <div>
            <button class="btn btn-ghost !py-2">Replace photo</button>
            <div class="text-xs text-ink-500 mt-2">JPG or PNG · max 5MB · 400×400+</div>
          </div>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div><label class="label">Display name</label><input class="input" value="Yuna Aoki"/></div>
          <div><label class="label">Handle</label><input class="input" value="@yunaaoki"/></div>
          <div class="col-span-2"><label class="label">Headline</label><input class="input" value="Couture-trained womenswear designer · Tokyo · Available for SS27 capsules"/></div>
          <div><label class="label">City</label><input class="input" value="Tokyo"/></div>
          <div><label class="label">Country</label><input class="input" value="Japan"/></div>
          <div class="col-span-2"><label class="label">Bio</label>
            <textarea class="input" rows="4">Trained at Bunka Fashion College in Tokyo and Atelier Versace in Milan. I work mostly with indie luxury houses on capsule womenswear collections — silk drape, hand-embroidery and constructed tailoring.</textarea>
          </div>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="editorial text-xl mb-1">Skills &amp; specialties</h2>
        <p class="text-sm text-ink-500 mb-5">Pick 3–10. Power matching, search and AI proposals.</p>
        <div class="flex flex-wrap gap-2">
          <span class="chip chip-gold">Couture ✕</span>
          <span class="chip chip-gold">Drape ✕</span>
          <span class="chip chip-gold">Silk ✕</span>
          <span class="chip chip-gold">Hand-embroidery ✕</span>
          <span class="chip chip-gold">Tailoring ✕</span>
          <span class="chip">+ Add skill</span>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="editorial text-xl mb-1">Services &amp; pricing</h2>
        <p class="text-sm text-ink-500 mb-5">Standard packages clients can book directly.</p>

        <div class="space-y-3">
          <div class="border border-line rounded-xl p-4 flex items-center gap-4">
            <div class="flex-1">
              <div class="font-medium">Capsule design (4–8 pieces)</div>
              <div class="text-xs text-ink-500">From concept to spec sheets · 6–8 weeks</div>
            </div>
            <div class="text-right">
              <div class="font-medium">$2,400</div>
              <div class="text-xs text-ink-500">starting</div>
            </div>
            <button class="chip">Edit</button>
          </div>
          <div class="border border-line rounded-xl p-4 flex items-center gap-4">
            <div class="flex-1">
              <div class="font-medium">Single-piece custom</div>
              <div class="text-xs text-ink-500">One garment with sketches &amp; tech pack · 3 weeks</div>
            </div>
            <div class="text-right">
              <div class="font-medium">$680</div>
              <div class="text-xs text-ink-500">fixed</div>
            </div>
            <button class="chip">Edit</button>
          </div>
          <button class="w-full p-4 border-2 border-dashed border-line rounded-xl text-sm text-ink-500 hover:border-ink-300 hover:bg-ink-50 transition">+ Add a service</button>
        </div>
      </div>

      <div class="card p-6">
        <h2 class="editorial text-xl mb-1">Social &amp; verification</h2>
        <p class="text-sm text-ink-500 mb-5">Verified accounts boost your match score.</p>
        <div class="space-y-2">
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-lg bg-ink-100 flex items-center justify-center">IG</span><span class="text-sm">Instagram · @yunaaoki</span></div>
            <span class="pill pill-green">Verified</span>
          </div>
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-lg bg-ink-100 flex items-center justify-center">In</span><span class="text-sm text-ink-500">LinkedIn — not connected</span></div>
            <button class="chip">Connect</button>
          </div>
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-8 h-8 rounded-lg bg-ink-100 flex items-center justify-center">Be</span><span class="text-sm text-ink-500">Behance — not connected</span></div>
            <button class="chip">Connect</button>
          </div>
        </div>
      </div>

      <div class="flex justify-end gap-3 sticky bottom-4">
        <button class="btn btn-ghost">Cancel</button>
        <button class="btn-gold">Save changes</button>
      </div>
    </div>

    <!-- Side preview -->
    <div class="col-span-12 lg:col-span-4">
      <div class="card overflow-hidden sticky top-24">
        <div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-500 px-5 pt-5">Live preview</div>
        <div class="plate aspect-[4/3] m-4 mt-3"><img src="https://images.unsplash.com/photo-1488161628813-04466f872be2?w=900&auto=format&fit=crop" alt="cover"/></div>
        <div class="px-5 -mt-10 relative z-10">
          <img src="https://images.unsplash.com/photo-1494790108377-be9c29b29330?w=200" class="w-16 h-16 rounded-full ring-4 ring-white object-cover" alt=""/>
          <div class="mt-2 flex items-center gap-2">
            <div class="editorial text-xl">Yuna Aoki</div>
            <span class="pill pill-gold">Top 1%</span>
          </div>
          <div class="text-xs text-ink-500">@yunaaoki · Tokyo</div>
          <div class="text-sm text-ink-700 mt-3">Couture-trained womenswear designer · Tokyo · Available for SS27 capsules</div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            <span class="chip">Couture</span><span class="chip">Drape</span><span class="chip">Silk</span>
          </div>
        </div>
        <div class="px-5 py-4 mt-4 border-t border-line flex items-center justify-between">
          <div><div class="text-[10px] mono uppercase tracking-[0.18em] text-ink-500">Starts at</div><div class="font-semibold">$2,400</div></div>
          <span class="pill pill-green">Available</span>
        </div>
      </div>
    </div>
  </div>

</Dashboard>
