---
import Dashboard from '@/layouts/Dashboard.astro';

const notifs = [
  { type:'order', icon:'📦', title:'New order from Auriga · Standard tier', time:'2m', unread:true, color:'champagne' },
  { type:'msg',   icon:'💬', title:'Sara replied to your tech pack thread', time:'12m', unread:true, color:'blue' },
  { type:'paid',  icon:'💸', title:'$840 released to your Stripe account', time:'2h', unread:true, color:'green' },
  { type:'rev',   icon:'★',  title:'Hanako Studio left you a 5★ review', time:'5h', unread:false, color:'champagne' },
  { type:'order', icon:'📦', title:'Order #o3 marked reviewed', time:'1d', unread:false, color:'gray' },
  { type:'sys',   icon:'✦',  title:'Profile boosting unlocked — your profile gets 2× visibility for 7 days', time:'2d', unread:false, color:'champagne' },
  { type:'rev',   icon:'★',  title:'Léon &amp; Co. left you a 5★ review', time:'3d', unread:false, color:'champagne' },
];
---
<Dashboard title="Notifications" pageTitle="Notifications" current="overview" role="creator">

  <div class="flex items-center justify-between mb-6">
    <div class="flex gap-2">
      <button class="chip chip-active">All</button>
      <button class="chip">Unread (3)</button>
      <button class="chip">Orders</button>
      <button class="chip">Messages</button>
      <button class="chip">Reviews</button>
      <button class="chip">System</button>
    </div>
    <button class="btn btn-ghost btn-sm">Mark all read</button>
  </div>

  <div class="card p-0 overflow-hidden">
    {notifs.map((n) => (
      <a href="#" class={`flex items-start gap-4 px-6 py-4 border-b border-line last:border-b-0 hover:bg-paper-2/40 transition ${n.unread ? 'bg-champagne-50/30' : ''}`}>
        <span class="w-9 h-9 rounded-full bg-paper-2 flex items-center justify-center text-base flex-shrink-0">{n.icon}</span>
        <div class="flex-1 min-w-0">
          <div class={`text-sm ${n.unread ? 'font-medium' : ''}`} set:html={n.title}></div>
          <div class="text-xs text-ink-5 mt-0.5">{n.time} ago</div>
        </div>
        {n.unread && <span class="w-2 h-2 rounded-full bg-champagne mt-2 flex-shrink-0"></span>}
      </a>
    ))}
  </div>

</Dashboard>
