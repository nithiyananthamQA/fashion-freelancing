---
import Dashboard from '@/layouts/Dashboard.astro';
// Client-rendered order detail. Static route — works for ANY order id
// (mock, seeded, or one created at runtime) because it reads ?id= and
// hydrates from the live store. Reached as /dashboard/orders/view?id=<id>.
---
<Dashboard title="Order" pageTitle="Order" current="orders" role="creator">

  <div id="order-detail" class="grid grid-cols-12 gap-6">
    <div class="col-span-12">
      <div class="card p-10 text-center text-ink-5">Loading order…</div>
    </div>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const api = window.api;
        if (!api) return;
        const root = document.getElementById('order-detail');
        const id = new URLSearchParams(location.search).get('id');

        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c => (
          { '&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;' }[c]));

        api.orders.get(id).then(function (order) {
          if (!order) {
            root.innerHTML = '<div class="col-span-12"><div class="card p-12 text-center">'
              + '<div style="font-size:40px">🔍</div>'
              + '<div class="font-medium mt-2">Order not found</div>'
              + '<div class="text-sm text-ink-5 mt-1">It may have been removed.</div>'
              + '<a href="/dashboard/orders" class="btn btn-primary btn-sm mt-4 inline-flex">Back to orders</a>'
              + '</div></div>';
            return;
          }
          const st = api._store.getState();
          const seller = st.users.find(u => u.id === order.sellerId) || {};
          const buyer  = st.users.find(u => u.id === order.buyerId) || {};
          const money  = api.fmt.money(order.amount.amount, order.amount.currency);
          const steps  = ['ordered','in_progress','delivered','reviewed'];
          const cur    = steps.indexOf(order.status);
          const pill   = { ordered:'pill-blue', in_progress:'pill-champagne',
                           delivered:'pill-green', reviewed:'pill-gray',
                           cancelled:'pill-rose' }[order.status] || 'pill-gray';

          root.innerHTML = `
            <div class="col-span-12 lg:col-span-8 space-y-6">
              <div class="card p-6">
                <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
                  <div>
                    <div class="text-xs text-ink-5 mono uppercase tracking-wider">Order ${esc(order.id.slice(-6).toUpperCase())}</div>
                    <h1 class="editorial text-2xl mt-1">${esc(order.title)}</h1>
                    <div class="text-sm text-ink-5 mt-1">${money} · ordered ${esc(api.fmt.timeAgo(order.orderedAt))}</div>
                  </div>
                  <span class="${pill}">${esc(order.status.replace('_',' '))}</span>
                </div>
                <div class="grid grid-cols-4 gap-0 mt-4">
                  ${steps.map((s,i) => `
                    <div class="px-3 py-3 border border-line text-xs flex items-center gap-2
                      ${i===0?'rounded-l-lg':''} ${i===3?'rounded-r-lg':''} ${i>0?'border-l-0':''}
                      ${i<cur?'bg-ink text-paper border-ink':i===cur?'bg-champagne-50 border-champagne-100 text-champagne-3 font-medium':'bg-paper-2 text-ink-5'}">
                      <span class="w-1.5 h-1.5 rounded-full bg-current opacity-70"></span>
                      <span>${s.replace('_',' ')}</span>
                    </div>`).join('')}
                </div>
              </div>

              <div class="card p-6">
                <h2 class="editorial text-lg mb-3">Description</h2>
                <p class="text-sm text-ink-4" style="white-space:pre-line">${esc(order.description || 'No description.')}</p>
              </div>
            </div>

            <aside class="col-span-12 lg:col-span-4 space-y-4">
              <div class="card p-5">
                <div class="text-xs text-ink-5 uppercase tracking-wider">Freelancer</div>
                <div class="flex items-center gap-3 mt-2">
                  <img src="${esc(seller.avatar)}" class="w-9 h-9 rounded-full object-cover" alt=""/>
                  <div class="font-medium text-sm">${esc(seller.name || '—')}</div>
                </div>
                <div class="text-xs text-ink-5 uppercase tracking-wider mt-4">Buyer</div>
                <div class="font-medium text-sm mt-1">${esc(buyer.name || '—')}</div>
              </div>
              <div class="card p-5">
                <h3 class="editorial text-lg">Order summary</h3>
                <div class="mt-4 space-y-2 text-sm">
                  <div class="flex justify-between"><span class="text-ink-5">Amount</span><span class="font-medium">${money}</span></div>
                  <div class="flex justify-between"><span class="text-ink-5">Ordered</span><span>${esc(new Date(order.orderedAt).toLocaleDateString())}</span></div>
                  <div class="flex justify-between"><span class="text-ink-5">Due</span><span>${order.dueAt ? esc(new Date(order.dueAt).toLocaleDateString()) : '—'}</span></div>
                </div>
                <div class="mt-4 pt-4 border-t border-line">
                  <div class="flex justify-between text-sm"><span class="text-ink-5">In escrow</span><span class="font-medium text-champagne-3">${money}</span></div>
                  <div class="text-xs text-ink-5 mt-1">Held safely until the work is delivered and approved.</div>
                </div>
                <a href="/dashboard/orders" class="btn btn-ghost w-full mt-4">Back to all orders</a>
              </div>
            </aside>`;
        }).catch(function () {
          root.innerHTML = '<div class="col-span-12"><div class="card p-12 text-center text-ink-5">Could not load this order.</div></div>';
        });
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Dashboard>
