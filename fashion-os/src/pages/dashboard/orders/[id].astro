---
import Dashboard from '@/layouts/Dashboard.astro';
import { myOrders } from '@/data/mock';
export function getStaticPaths() {
  return myOrders.map(o => ({ params: { id: o.id }, props: { order: o } }));
}
const { order } = Astro.props as { order: typeof myOrders[number] };

const steps = ['ordered','in_progress','delivered','reviewed'] as const;
const currentIdx = steps.indexOf(order.status as any);
---
<Dashboard title={`Order ${order.id}`} pageTitle={`Order · ${order.id.toUpperCase()}`} current="orders" role="creator">

  <div class="grid grid-cols-12 gap-6">
    <!-- LEFT: thread + details -->
    <div class="col-span-12 lg:col-span-8 space-y-6">
      <!-- Order header -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4 flex-wrap gap-3">
          <div>
            <div class="text-xs text-ink-5 mono uppercase tracking-wider">Order</div>
            <h1 class="display text-2xl mt-1">{order.gigTitle}</h1>
            <div class="text-sm text-ink-5 mt-1">{order.tier} tier · {order.amount} · ordered {order.orderedAt}</div>
          </div>
          <span class={`pill ${order.status === 'in_progress' ? 'pill-champagne' : order.status === 'delivered' ? 'pill-green' : order.status === 'reviewed' ? 'pill-gray' : order.status === 'cancelled' ? 'pill-rose' : 'pill-blue'}`}>{order.status.replace('_',' ')}</span>
        </div>

        <!-- Pipeline -->
        <div class="grid grid-cols-4 gap-0 mt-4">
          {steps.map((s, i) => (
            <div class={`px-3 py-3 border border-line text-xs flex items-center gap-2 ${i === 0 ? 'rounded-l-lg' : ''} ${i === steps.length-1 ? 'rounded-r-lg' : ''} ${i > 0 ? 'border-l-0' : ''} ${i < currentIdx ? 'bg-ink text-paper border-ink' : i === currentIdx ? 'bg-champagne-50 border-champagne-100 text-champagne-3 font-medium' : 'bg-paper-2 text-ink-5'}`}>
              <span class="w-1.5 h-1.5 rounded-full bg-current opacity-70"></span>
              <span>{s.replace('_',' ')}</span>
            </div>
          ))}
        </div>
      </div>

      <!-- Conversation / activity -->
      <div class="card p-0">
        <div class="px-6 py-4 border-b border-line flex items-center justify-between">
          <h2 class="display text-lg">Activity &amp; messages</h2>
          <button class="chip">Files (3)</button>
        </div>
        <div class="p-6 space-y-5">
          <div class="flex gap-3">
            <img src={order.sellerAvatar} class="w-8 h-8 rounded-full object-cover flex-shrink-0" alt=""/>
            <div>
              <div class="text-xs text-ink-5">Yuna · 2h ago</div>
              <div class="card !rounded-2xl !rounded-tl-sm p-3 px-4 text-sm mt-1 max-w-md">v1 tech pack attached. Take a look — I've flagged 2 measurements I'd like to confirm before we send to factory.</div>
              <div class="mt-2 flex items-center gap-2 text-xs text-ink-5">📎 wide-leg-trouser-v1.pdf · 1.4 MB</div>
            </div>
          </div>
          <div class="flex gap-3 justify-end">
            <div class="text-right">
              <div class="text-xs text-ink-5">{order.buyer.split('·')[1]} · 1h ago</div>
              <div class="bg-ink text-paper !rounded-2xl !rounded-tr-sm p-3 px-4 text-sm mt-1 max-w-md inline-block">Looks great. Confirmed both measurements. Push v2 with grading and we're done.</div>
            </div>
          </div>
          <div class="flex justify-center">
            <span class="text-[11px] mono uppercase tracking-wider text-ink-5 bg-paper border border-line rounded-full px-3 py-1">Order moved to In progress</span>
          </div>
        </div>
        <div class="border-t border-line p-4">
          <div class="card !rounded-xl p-3 flex items-end gap-2">
            <button class="text-ink-5 hover:text-ink p-1">📎</button>
            <textarea class="flex-1 bg-transparent border-0 resize-none focus:outline-none text-sm" placeholder="Type a message…" rows="1"></textarea>
            <button class="btn btn-primary btn-sm">Send</button>
          </div>
        </div>
      </div>

      <!-- Deliverables -->
      <div class="card p-6">
        <h2 class="display text-lg mb-4">Requirements</h2>
        <ul class="space-y-3 text-sm">
          <li class="flex gap-3"><span class="text-emerald-700">✓</span>Sketches uploaded · 4 angles</li>
          <li class="flex gap-3"><span class="text-emerald-700">✓</span>Material list confirmed</li>
          <li class="flex gap-3"><span class="text-emerald-700">✓</span>Sizing range agreed (XS–XL)</li>
          <li class="flex gap-3"><span class="text-ink-5">○</span><span class="text-ink-5">Final sign-off pending buyer review</span></li>
        </ul>
      </div>
    </div>

    <!-- RIGHT: order summary -->
    <aside class="col-span-12 lg:col-span-4 space-y-4">
      <div class="card p-5">
        <div class="text-xs text-ink-5 uppercase tracking-wider">Buyer</div>
        <div class="font-medium mt-1">{order.buyer}</div>
        <a href="#" class="btn btn-ghost w-full mt-4">Message buyer</a>
      </div>

      <div class="card p-5">
        <h3 class="display text-lg">Order summary</h3>
        <div class="mt-4 space-y-2 text-sm">
          <div class="flex justify-between"><span class="text-ink-5">Tier</span><span>{order.tier}</span></div>
          <div class="flex justify-between"><span class="text-ink-5">Amount</span><span class="font-medium">{order.amount}</span></div>
          <div class="flex justify-between"><span class="text-ink-5">Ordered</span><span>{order.orderedAt}</span></div>
          <div class="flex justify-between"><span class="text-ink-5">Due</span><span>{order.due}</span></div>
        </div>
        <div class="mt-4 pt-4 border-t border-line">
          <div class="flex justify-between text-sm"><span class="text-ink-5">In escrow</span><span class="font-medium text-champagne-3">{order.amount}</span></div>
          <div class="text-xs text-ink-5 mt-1">Released to you on delivery sign-off.</div>
        </div>
        <button class="btn btn-champagne w-full mt-4">Deliver order</button>
        <button class="btn btn-ghost w-full mt-2">Request extension</button>
      </div>

      <!-- Dispute -->
      <div class="card p-5 border-rose-100 bg-rose-50/30">
        <div class="text-sm font-medium text-rose-700">Need help?</div>
        <p class="text-xs text-rose-700/80 mt-1">If something's off, raise a dispute and our team reviews within 48 hours.</p>
        <button class="btn btn-ghost border-rose-200 text-rose-700 hover:bg-rose-50 hover:border-rose-300 mt-3 w-full">Raise dispute</button>
      </div>
    </aside>
  </div>

</Dashboard>
