---
import Dashboard from '@/layouts/Dashboard.astro';
import { myOrders, myGigs, messages } from '@/data/mock';
---
<Dashboard title="Search" pageTitle="Search" current="overview" role="creator">

  <div class="card p-2 flex items-center gap-2 mb-6">
    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" class="text-ink-5 ml-3"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
    <input class="flex-1 bg-transparent border-0 outline-none px-2 py-3 text-base" placeholder="Search across your orders, gigs, messages and contacts…" value="tech pack"/>
    <button class="btn btn-primary mr-2">Search</button>
  </div>

  <p class="text-sm text-ink-5 mb-6">Showing results for <strong class="text-ink">"tech pack"</strong> · 12 results</p>

  <div class="space-y-8">
    <!-- Gigs -->
    <section>
      <div class="text-xs uppercase tracking-wider text-ink-5 mb-3 mono">Gigs · 2</div>
      <div class="space-y-2">
        {myGigs.map(g => (
          <a href={`/dashboard/gigs/${g.slug}`} class="flex items-center gap-4 p-4 card hover:border-ink-7 transition">
            <img src={g.img} class="w-14 h-14 rounded-lg object-cover" alt=""/>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm">{g.title}</div>
              <div class="text-xs text-ink-5 mt-1">★ {g.rating} ({g.reviews}) · From ${g.from}</div>
            </div>
            <span class="text-ink-5">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Orders -->
    <section>
      <div class="text-xs uppercase tracking-wider text-ink-5 mb-3 mono">Orders · 4</div>
      <div class="space-y-2">
        {myOrders.slice(0, 4).map(o => (
          <a href={`/dashboard/orders/view?id=${o.id}`} class="flex items-center gap-4 p-4 card hover:border-ink-7 transition">
            <span class="w-10 h-10 rounded-lg bg-paper-2 flex items-center justify-center mono text-[10px] font-semibold">{o.id.toUpperCase()}</span>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm">{o.gigTitle}</div>
              <div class="text-xs text-ink-5 mt-0.5">{o.buyer} · {o.amount} · {o.status.replace('_',' ')}</div>
            </div>
            <span class="text-ink-5">→</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Messages -->
    <section>
      <div class="text-xs uppercase tracking-wider text-ink-5 mb-3 mono">Messages · 3</div>
      <div class="space-y-2">
        {messages.slice(0, 3).map(m => (
          <a href="/dashboard/messages" class="flex items-center gap-4 p-4 card hover:border-ink-7 transition">
            <img src={m.avatar} class="w-10 h-10 rounded-full object-cover" alt=""/>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm">{m.from}</div>
              <div class="text-xs text-ink-5 mt-0.5 truncate">{m.preview}</div>
            </div>
            <span class="text-xs text-ink-5">{m.time}</span>
          </a>
        ))}
      </div>
    </section>
  </div>

</Dashboard>
