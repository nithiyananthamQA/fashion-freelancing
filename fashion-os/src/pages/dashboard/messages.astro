---
import Dashboard from '@/layouts/Dashboard.astro';
---
<Dashboard title="Messages" pageTitle="Messages" current="messages" role="creator">

  <div class="card overflow-hidden h-[calc(100vh-180px)] flex">

    <!-- Conversation list -->
    <aside class="w-80 border-r border-line flex flex-col">
      <div class="p-4 border-b border-line">
        <input id="conv-search" class="input !py-2 text-sm" placeholder="Search conversations…"/>
      </div>
      <div id="conv-list" class="flex-1 overflow-y-auto">
        <div class="p-4 text-sm text-ink-400">Loading conversations…</div>
      </div>
    </aside>

    <!-- Conversation -->
    <section class="flex-1 flex flex-col">
      <header id="conv-header" class="px-6 py-4 border-b border-line flex items-center gap-3">
        <div class="text-sm text-ink-400">Select a conversation</div>
      </header>

      <div id="msg-thread" class="flex-1 overflow-y-auto p-6 space-y-4 bg-surface">
        <div class="flex justify-center"><span class="text-[10px] mono uppercase tracking-[0.18em] text-ink-400">No conversation open</span></div>
      </div>

      <footer class="border-t border-line p-4">
        <form id="msg-form" class="card !rounded-2xl p-3 flex items-end gap-2">
          <button type="button" class="text-ink-500 hover:text-ink-900 p-1" aria-label="Attach">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"><path d="M21.4 11.05L12.2 20.27a6 6 0 0 1-8.49-8.49L13 2.5a4 4 0 0 1 5.66 5.66l-9.2 9.19a2 2 0 0 1-2.83-2.83l8.49-8.48"/></svg>
          </button>
          <textarea id="msg-input" class="flex-1 bg-transparent border-0 resize-none focus:outline-none text-sm placeholder:text-ink-400 max-h-32 py-1" placeholder="Type a message…" rows="1"></textarea>
          <button type="submit" id="msg-send" class="btn-gold" disabled>Send</button>
        </form>
      </footer>
    </section>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const api = window.api;
        if (!api) return;
        const session = api.users.sessionSync();
        if (!session) return; // Dashboard layout will sign in a demo user and reload

        const me = session.userId;
        const store = api._store;
        const listEl   = document.getElementById('conv-list');
        const headerEl = document.getElementById('conv-header');
        const threadEl = document.getElementById('msg-thread');
        const form     = document.getElementById('msg-form');
        const input    = document.getElementById('msg-input');
        const sendBtn  = document.getElementById('msg-send');
        const searchEl = document.getElementById('conv-search');

        let conversations = [];
        let activeId = null;

        const userById = (id) => store.getState().users.find(u => u.id === id) || {};
        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c => (
          { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]
        ));
        const otherUser = (c) => userById((c.participantIds || []).find(p => p !== me));

        function renderList(filter) {
          const q = (filter || '').toLowerCase().trim();
          const rows = conversations.filter(c => {
            if (!q) return true;
            const u = otherUser(c);
            return (u.name || '').toLowerCase().includes(q) ||
                   (c.lastMessagePreview || '').toLowerCase().includes(q);
          });
          if (!rows.length) {
            listEl.innerHTML = '<div class="p-4 text-sm text-ink-400">No conversations yet.</div>';
            return;
          }
          listEl.innerHTML = rows.map(c => {
            const u = otherUser(c);
            const unread = (c.unreadCountByUser || {})[me] || 0;
            return `
              <a href="#" data-conv="${c.id}" class="flex items-center gap-3 p-4 border-b border-line/70 hover:bg-ink-50 transition ${c.id === activeId ? 'bg-ink-50/60' : ''}">
                <img src="${esc(u.avatar)}" class="w-11 h-11 rounded-full object-cover flex-shrink-0" alt=""/>
                <div class="flex-1 min-w-0">
                  <div class="flex items-baseline justify-between">
                    <div class="text-sm font-medium truncate">${esc(u.name || 'Unknown')}</div>
                    <div class="text-[10px] mono text-ink-400 ml-2">${c.lastMessageAt ? esc(api.fmt.timeAgo(c.lastMessageAt)) : ''}</div>
                  </div>
                  <div class="text-xs text-ink-500 truncate">${esc(c.lastMessagePreview || 'No messages yet')}</div>
                </div>
                ${unread ? '<span class="w-2 h-2 rounded-full bg-gold flex-shrink-0"></span>' : ''}
              </a>`;
          }).join('');
          listEl.querySelectorAll('[data-conv]').forEach(a => {
            a.addEventListener('click', (e) => {
              e.preventDefault();
              openConversation(a.getAttribute('data-conv'));
            });
          });
        }

        function renderHeader(c) {
          const u = otherUser(c);
          headerEl.innerHTML = `
            <img src="${esc(u.avatar)}" class="w-10 h-10 rounded-full object-cover" alt=""/>
            <div class="flex-1">
              <div class="font-medium">${esc(u.name || 'Unknown')}</div>
              <div class="text-xs text-ink-500 flex items-center gap-1.5"><span class="w-1.5 h-1.5 rounded-full bg-emerald-500"></span>Active now</div>
            </div>`;
        }

        async function renderThread(conversationId) {
          const msgs = await api.messages.getMessages(conversationId);
          if (!msgs.length) {
            threadEl.innerHTML = '<div class="flex justify-center"><span class="text-[10px] mono uppercase tracking-[0.18em] text-ink-400">Say hello — no messages yet</span></div>';
            return;
          }
          threadEl.innerHTML = msgs.map(m => {
            const mine = m.senderId === me;
            const u = userById(m.senderId);
            const time = esc(api.fmt.timeAgo(m.sentAt));
            if (mine) {
              return `
                <div class="flex justify-end max-w-[70%] ml-auto">
                  <div>
                    <div class="bg-ink-900 text-white !rounded-2xl !rounded-tr-sm p-3 px-4 text-sm">${esc(m.body)}</div>
                    <div class="text-[10px] mono text-ink-400 mt-1 mr-3 text-right">${time}${m.delivered ? ' · ✓' : ''}</div>
                  </div>
                </div>`;
            }
            return `
              <div class="flex gap-3 max-w-[70%]">
                <img src="${esc(u.avatar)}" class="w-8 h-8 rounded-full object-cover flex-shrink-0" alt=""/>
                <div>
                  <div class="card !rounded-2xl !rounded-tl-sm p-3 px-4 text-sm">${esc(m.body)}</div>
                  <div class="text-[10px] mono text-ink-400 mt-1 ml-3">${time}</div>
                </div>
              </div>`;
          }).join('');
          threadEl.scrollTop = threadEl.scrollHeight;
        }

        async function openConversation(id) {
          activeId = id;
          const c = conversations.find(x => x.id === id);
          if (!c) return;
          renderHeader(c);
          await renderThread(id);
          renderList(searchEl.value);
          sendBtn.disabled = false;
          input.focus();
        }

        async function loadConversations() {
          conversations = await api.messages.listConversations(me);
          renderList('');
          if (conversations.length) {
            // Deep link: /dashboard/messages?c=<conversationId> opens that thread
            const wanted = new URLSearchParams(location.search).get('c');
            const match = wanted && conversations.find(c => c.id === wanted);
            openConversation(match ? match.id : conversations[0].id);
          } else {
            headerEl.innerHTML = '<div class="text-sm text-ink-400">No conversations yet</div>';
            threadEl.innerHTML = '<div class="flex justify-center"><span class="text-[10px] mono uppercase tracking-[0.18em] text-ink-400">Your messages will appear here</span></div>';
          }
        }

        // Send a message
        form.addEventListener('submit', async (e) => {
          e.preventDefault();
          const body = input.value.trim();
          if (!body || !activeId) return;
          sendBtn.disabled = true;
          try {
            await api.messages.send({ conversationId: activeId, body });
            input.value = '';
            input.style.height = 'auto';
            // refresh thread + list (preview/time updated by api.messages.send)
            conversations = await api.messages.listConversations(me);
            await renderThread(activeId);
            renderList(searchEl.value);
          } catch (err) {
            if (window.UI) UI.toast(err.message || 'Could not send message', { kind: 'error' });
            console.error(err);
          } finally {
            sendBtn.disabled = false;
            input.focus();
          }
        });

        // Enter to send, Shift+Enter for newline
        input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey) {
            e.preventDefault();
            form.requestSubmit();
          }
        });
        // Auto-grow textarea
        input.addEventListener('input', () => {
          input.style.height = 'auto';
          input.style.height = Math.min(input.scrollHeight, 128) + 'px';
        });

        searchEl.addEventListener('input', () => renderList(searchEl.value));

        loadConversations();
      }

      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Dashboard>
