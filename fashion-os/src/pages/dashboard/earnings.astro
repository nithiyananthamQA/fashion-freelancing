---
import Dashboard from '@/layouts/Dashboard.astro';
const transactions = [
  { id:'tx1', date:'May 06', project:'SS27 silk capsule · Auriga', type:'Milestone 2', amount:'+$3,200', status:'paid' },
  { id:'tx2', date:'May 02', project:'Cover styling · Numéro', type:'Final', amount:'+€6,800', status:'paid' },
  { id:'tx3', date:'Apr 28', project:'SS27 silk capsule · Auriga', type:'Milestone 1', amount:'+$2,400', status:'paid' },
  { id:'tx4', date:'Apr 22', project:'Resort 26 · Maison Kirei', type:'Final', amount:'+€4,200', status:'paid' },
  { id:'tx5', date:'Apr 15', project:'Hanako Studio', type:'Sample', amount:'+¥180,000', status:'pending' },
  { id:'tx6', date:'Apr 12', project:'Stripe payout', type:'Payout', amount:'−$11,400', status:'paid' },
];
---
<Dashboard title="Earnings" pageTitle="Earnings" current="earnings" role="creator">

  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-6">
    <div class="card p-5"><div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-500">This month</div><div class="editorial gold-text text-3xl mt-1">$8,420</div><div class="text-xs text-emerald-700 mono mt-2">↗ +24%</div></div>
    <div class="card p-5"><div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-500">Year to date</div><div class="editorial text-3xl mt-1">$48,210</div><div class="text-xs text-ink-500 mono mt-2">5 projects</div></div>
    <div class="card p-5"><div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-500">In escrow</div><div class="editorial text-3xl mt-1">$5,200</div><div class="text-xs text-ink-500 mono mt-2">2 milestones</div></div>
    <div class="card p-5"><div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-500">Available</div><div class="editorial text-3xl mt-1">$2,840</div><button class="btn-gold !py-1.5 !px-3 text-xs mt-2">Withdraw</button></div>
  </div>

  <div class="grid grid-cols-12 gap-6">
    <div class="col-span-12 lg:col-span-8">
      <div class="card p-6">
        <div class="flex items-center justify-between mb-6">
          <h2 class="editorial text-xl">Earnings · last 12 months</h2>
          <select class="input !py-1.5 !text-xs w-auto">
            <option>All projects</option><option>Auriga</option><option>Maison Kirei</option>
          </select>
        </div>
        <div class="flex items-end gap-2 h-48">
          {[24, 32, 28, 42, 38, 56, 44, 62, 64, 72, 84, 92].map((h, i) => (
            <div class="flex-1 flex flex-col items-center gap-2">
              <div class="w-full rounded-t-md transition-all hover:opacity-80" style={`height: ${h}%; background: linear-gradient(180deg, #E8C547 0%, #A88732 100%);`}></div>
              <div class="text-[10px] mono text-ink-500 uppercase">{['Jun','Jul','Aug','Sep','Oct','Nov','Dec','Jan','Feb','Mar','Apr','May'][i]}</div>
            </div>
          ))}
        </div>
      </div>

      <div class="card overflow-hidden mt-6">
        <div class="px-6 py-4 border-b border-line flex items-center justify-between">
          <h2 class="editorial text-xl">Transactions</h2>
          <button class="chip">Export CSV</button>
        </div>
        <div class="divide-y divide-line">
          {transactions.map((tx) => (
            <div class="px-6 py-4 grid grid-cols-12 gap-4 items-center hover:bg-ink-50/50 transition">
              <div class="col-span-2 text-xs mono text-ink-500">{tx.date}</div>
              <div class="col-span-5">
                <div class="text-sm font-medium">{tx.project}</div>
                <div class="text-xs text-ink-500">{tx.type}</div>
              </div>
              <div class={`col-span-3 font-medium text-sm ${tx.amount.startsWith('+') ? 'text-emerald-700' : 'text-ink-700'}`}>{tx.amount}</div>
              <div class="col-span-2 text-right">
                <span class={`pill ${tx.status === 'paid' ? 'pill-green' : 'pill-gold'}`}>{tx.status}</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="col-span-12 lg:col-span-4 space-y-6">
      <div class="card p-6">
        <h3 class="editorial text-lg">Payout method</h3>
        <div class="mt-4 p-4 border border-line rounded-xl flex items-center gap-3">
          <span class="w-10 h-10 rounded-lg bg-ink-900 text-white flex items-center justify-center font-bold mono text-xs">SE</span>
          <div class="flex-1">
            <div class="text-sm font-medium">Stripe Connect</div>
            <div class="text-xs text-ink-500">USD · ending in •• 4729</div>
          </div>
          <span class="pill pill-green">Active</span>
        </div>
        <button class="btn btn-ghost w-full mt-4">Add bank account</button>
      </div>

      <div class="card p-6">
        <h3 class="editorial text-lg">Tax documents</h3>
        <p class="text-sm text-ink-500 mt-2">Generated automatically each quarter.</p>
        <div class="mt-4 space-y-2">
          <a href="#" class="flex items-center justify-between p-3 rounded-lg hover:bg-ink-50 transition">
            <span class="text-sm">Q1 2026 statement</span><span class="text-xs text-gold">Download →</span>
          </a>
          <a href="#" class="flex items-center justify-between p-3 rounded-lg hover:bg-ink-50 transition">
            <span class="text-sm">2025 annual summary</span><span class="text-xs text-gold">Download →</span>
          </a>
        </div>
      </div>
    </div>
  </div>

</Dashboard>
