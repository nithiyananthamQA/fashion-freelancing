---
import Dashboard from '@/layouts/Dashboard.astro';
import { myOrders, myGigs, messages } from '@/data/mock';

const statusPill = (s: string) => ({
  ordered: 'pill-blue',
  in_progress: 'pill-champagne',
  delivered: 'pill-green',
  reviewed: 'pill-gray',
  cancelled: 'pill-rose',
}[s] ?? 'pill-gray');
---
<Dashboard title="Overview" pageTitle="Welcome back, Yuna" current="overview" role="creator">

  <!-- Top stats -->
  <div class="grid grid-cols-2 lg:grid-cols-4 gap-4 mb-8">
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-5">Active orders</div>
      <div class="display text-3xl mt-1">3</div>
      <div class="text-xs text-emerald-700 mt-2">↗ 1 delivered today</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-5">This month earnings</div>
      <div class="display text-3xl mt-1 gold-text">$8,420</div>
      <div class="text-xs text-emerald-700 mt-2">↗ +24% vs last</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-5">Profile views</div>
      <div class="display text-3xl mt-1">1,284</div>
      <div class="text-xs text-emerald-700 mt-2">↗ +18%</div>
    </div>
    <div class="card p-5">
      <div class="text-[11px] mono uppercase tracking-[0.18em] text-ink-5">Avg rating</div>
      <div class="display text-3xl mt-1">★ 4.97</div>
      <div class="text-xs text-ink-5 mt-2">142 reviews</div>
    </div>
  </div>

  <div class="grid grid-cols-12 gap-6">

    <!-- Active orders -->
    <div class="col-span-12 lg:col-span-8 space-y-6">

      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="display text-xl">Active orders</h2>
          <a href="/dashboard/orders" class="text-sm text-champagne-2 underline-offset-2 hover:underline">All orders →</a>
        </div>

        <div class="space-y-3">
          {myOrders.filter(o => o.status === 'in_progress' || o.status === 'ordered' || o.status === 'delivered').map((o) => (
            <a href={`/dashboard/orders/${o.id}`} class="flex items-center gap-4 p-3 rounded-xl border border-line hover:border-ink-7 hover:bg-paper-2/50 transition">
              <span class="w-10 h-10 rounded-lg bg-paper-2 text-ink mono text-[10px] flex items-center justify-center font-semibold flex-shrink-0">{o.id.toUpperCase()}</span>
              <div class="flex-1 min-w-0">
                <div class="font-medium text-sm truncate">{o.gigTitle}</div>
                <div class="text-xs text-ink-5 mt-0.5">{o.buyer} · {o.tier} · {o.amount} · due {o.due}</div>
              </div>
              <span class={statusPill(o.status)}>{o.status.replace('_',' ')}</span>
            </a>
          ))}
        </div>
      </div>

      <!-- Top gigs -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="display text-xl">Your gigs</h2>
          <a href="/dashboard/gigs" class="text-sm text-champagne-2 underline-offset-2 hover:underline">Manage →</a>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          {myGigs.map((g) => (
            <a href={`/dashboard/gigs/${g.slug}`} class="border border-line rounded-xl overflow-hidden hover:border-ink-7 transition">
              <div class="aspect-[4/3] bg-paper-2"><img src={g.img} alt="" class="w-full h-full object-cover"/></div>
              <div class="p-3">
                <div class="text-sm font-medium leading-snug line-clamp-2">{g.title}</div>
                <div class="mt-2 flex items-center justify-between text-xs">
                  <span class="text-champagne-2">★ {g.rating} <span class="text-ink-5">({g.reviews})</span></span>
                  <span class="text-ink-5">From <strong class="text-ink">${g.from}</strong></span>
                </div>
              </div>
            </a>
          ))}
          <a href="/dashboard/gigs/new" class="border-2 border-dashed border-line rounded-xl p-6 flex flex-col items-center justify-center gap-2 text-ink-5 hover:border-ink hover:text-ink transition">
            <span class="w-10 h-10 rounded-full bg-paper-2 flex items-center justify-center text-xl">+</span>
            <span class="text-sm font-medium">Add a service</span>
          </a>
        </div>
      </div>

      <!-- Earnings chart -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-4">
          <h2 class="display text-xl">Earnings · last 6 months</h2>
          <a href="/dashboard/earnings" class="text-sm text-champagne-2 underline-offset-2 hover:underline">Details →</a>
        </div>
        <div class="flex items-end gap-3 h-40">
          {[42, 38, 56, 64, 72, 84].map((h, i) => (
            <div class="flex-1 flex flex-col items-center gap-2">
              <div class="w-full rounded-t-md transition-all" style={`height: ${h}%; background: linear-gradient(180deg, #6E56F0 0%, #5468F5 100%);`}></div>
              <div class="text-[10px] mono text-ink-5 uppercase">{['Dec','Jan','Feb','Mar','Apr','May'][i]}</div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <!-- Sidebar column -->
    <div class="col-span-12 lg:col-span-4 space-y-6">

      <!-- Profile strength -->
      <div class="card p-6">
        <h3 class="display text-lg">Profile strength</h3>
        <div class="mt-4 flex items-end gap-3">
          <div class="display gold-text text-5xl leading-none">87</div>
          <div class="text-sm text-ink-5 mb-1">/ 100</div>
        </div>
        <div class="mt-4 h-2 bg-paper-2 rounded-full overflow-hidden">
          <div class="h-full bg-gradient-to-r from-champagne to-champagne-2 w-[87%]"></div>
        </div>
        <ul class="mt-4 space-y-2 text-sm">
          <li class="flex items-start gap-2"><span class="text-emerald-700 mt-0.5">✓</span><span>Bio &amp; skills complete</span></li>
          <li class="flex items-start gap-2"><span class="text-emerald-700 mt-0.5">✓</span><span>2 gigs published</span></li>
          <li class="flex items-start gap-2"><span class="text-ink-5 mt-0.5">○</span><span class="text-ink-5">Add a video intro</span></li>
          <li class="flex items-start gap-2"><span class="text-ink-5 mt-0.5">○</span><span class="text-ink-5">Connect Instagram</span></li>
        </ul>
      </div>

      <!-- Recent messages -->
      <div class="card p-6">
        <div class="flex items-center justify-between mb-3">
          <h3 class="display text-lg">Messages</h3>
          <a href="/dashboard/messages" class="text-sm text-champagne-2 underline-offset-2 hover:underline">All →</a>
        </div>
        <div class="space-y-1 -mx-2">
          {messages.slice(0,4).map((m) => (
            <a href="/dashboard/messages" class="flex items-center gap-3 p-2 rounded-lg hover:bg-paper-2 transition">
              <img src={m.avatar} class="w-9 h-9 rounded-full object-cover" alt=""/>
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between">
                  <div class="text-sm font-medium truncate">{m.from}</div>
                  <div class="text-[10px] mono text-ink-5 ml-2">{m.time}</div>
                </div>
                <div class="text-xs text-ink-5 truncate">{m.preview}</div>
              </div>
              {m.unread && <span class="w-2 h-2 rounded-full bg-champagne flex-shrink-0"></span>}
            </a>
          ))}
        </div>
      </div>

      <!-- Tips -->
      <div class="card p-6 bg-gradient-to-br from-champagne-50 to-white border-champagne-100">
        <div class="text-[11px] mono uppercase tracking-[0.16em] text-champagne-3">AI tip</div>
        <h3 class="display text-lg mt-2">Add a Premium package to your tech-pack service</h3>
        <p class="text-sm text-ink-4 mt-2">Sellers with 3 tiers earn 2.4× more on average. Your current Premium tier could be priced at $1,200 based on your reviews.</p>
        <a href="/dashboard/ai" class="btn btn-champagne mt-4 inline-flex">Open AI Studio →</a>
      </div>
    </div>
  </div>

</Dashboard>
