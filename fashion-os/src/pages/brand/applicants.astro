---
import Dashboard from '@/layouts/Dashboard.astro';
---
<Dashboard title="Applicants" pageTitle="Applicants" current="applicants" role="brand">

  <!-- Brief picker — defaults to the most-recent open brief by the signed-in brand -->
  <div class="card p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
    <div class="flex-1 min-w-0">
      <h2 id="ap-brief-title" class="editorial text-lg truncate">Loading…</h2>
      <div id="ap-brief-meta" class="text-xs text-ink-500 mt-1">—</div>
    </div>
    <div class="flex items-center gap-2 flex-wrap">
      <select id="ap-brief-picker" class="input !py-1.5 !text-xs !w-auto"></select>
      <a href="/brand/post" class="btn btn-ghost btn-sm">+ Post a new job</a>
    </div>
  </div>

  <!-- Pipeline kanban — fills client-side from api.applications.list -->
  <div id="ap-pipeline" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    <div class="col-span-full card p-10 text-center text-ink-500">Loading applicants…</div>
  </div>

  <div id="ap-empty" class="hidden card p-10 text-center text-ink-500">
    <div class="text-4xl mb-3">📬</div>
    <div class="font-medium text-ink mb-1">No applicants yet</div>
    <div class="text-sm">When freelancers apply to this job, they'll show up here.</div>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const api = window.api;
        const UI = window.UI;
        if (!api) return;
        const session = api.users.sessionSync();
        if (!session) return;

        const titleEl = document.getElementById('ap-brief-title');
        const metaEl  = document.getElementById('ap-brief-meta');
        const picker  = document.getElementById('ap-brief-picker');
        const board   = document.getElementById('ap-pipeline');
        const empty   = document.getElementById('ap-empty');

        // Columns (display label → list of application.status values)
        const COLS = [
          { key: 'sent',        label: 'New',         pill: 'pill-blue' },
          { key: 'shortlisted', label: 'Shortlisted', pill: 'pill-champagne' },
          { key: 'accepted',    label: 'Hired',       pill: 'pill-green' },
          { key: 'rejected',    label: 'Declined',    pill: 'pill-rose' },
          { key: 'withdrawn',   label: 'Withdrew',    pill: 'pill-gray' },
        ];

        const esc = (s) => String(s == null ? '' : s).replace(/[&<>"]/g, c => (
          { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]
        ));

        let currentBrief = null;
        let briefs = [];

        async function loadBriefs() {
          // Brand's own briefs — newest first
          briefs = await api.briefs.list({ brandId: session.userId });
          if (!briefs.length) {
            titleEl.textContent = "No jobs posted yet";
            metaEl.textContent = "Post a job and applicants will appear here.";
            picker.style.display = 'none';
            board.innerHTML = '';
            empty.classList.remove('hidden');
            empty.innerHTML =
              '<div class="text-4xl mb-3">📨</div>' +
              '<div class="font-medium text-ink mb-1">No briefs posted yet</div>' +
              '<div class="text-sm mb-4">Post your first job to start receiving applications.</div>' +
              '<a href="/brand/post" class="btn btn-primary btn-sm inline-flex">Post a job →</a>';
            return;
          }
          picker.innerHTML = briefs.map((b, i) =>
            '<option value="' + esc(b.id) + '"' + (i === 0 ? ' selected' : '') + '>' +
              esc(b.title) +
            '</option>').join('');
          await pickBrief(briefs[0].id);
        }

        async function pickBrief(briefId) {
          currentBrief = briefs.find(b => b.id === briefId) || briefs[0];
          titleEl.textContent = currentBrief.title;
          metaEl.textContent =
            currentBrief.applicantCount + ' applicant' +
            (currentBrief.applicantCount === 1 ? '' : 's') +
            ' · Posted ' + api.fmt.timeAgo(currentBrief.postedAt);
          await loadApplicants();
        }

        async function loadApplicants() {
          const apps = await api.applications.list({ briefId: currentBrief.id });
          if (!apps.length) {
            board.innerHTML = '';
            empty.classList.remove('hidden');
            empty.innerHTML =
              '<div class="text-4xl mb-3">📬</div>' +
              '<div class="font-medium text-ink mb-1">No applicants yet</div>' +
              '<div class="text-sm">When freelancers apply to this job, they\'ll show up here.</div>';
            return;
          }
          empty.classList.add('hidden');

          const state = api._store.getState();
          const byUser = new Map((state.users || []).map(u => [u.id, u]));
          const byFreelancer = new Map((state.freelancers || []).map(f => [f.id, f]));

          const grouped = COLS.reduce((acc, c) => (acc[c.key] = [], acc), {});
          apps.forEach(a => { (grouped[a.status] = grouped[a.status] || []).push(a); });

          board.innerHTML = COLS.map(col => {
            const items = grouped[col.key] || [];
            return '' +
              '<div>' +
                '<div class="flex items-center justify-between mb-3">' +
                  '<span class="text-xs uppercase tracking-[0.16em] text-ink-500 font-medium">' + esc(col.label) + '</span>' +
                  '<span class="mono text-[11px] text-ink-400">' + items.length + '</span>' +
                '</div>' +
                '<div class="space-y-3 min-h-[200px] p-2 bg-surface rounded-xl border border-dashed border-line">' +
                  items.map(a => {
                    const u = byUser.get(a.freelancerId) || {};
                    const f = byFreelancer.get(a.freelancerId) || {};
                    const fromPrice = f.fromPrice ? '$' + f.fromPrice : '';
                    const amount = a.proposedAmount && a.proposedAmount.amount
                      ? api.fmt.money(a.proposedAmount.amount, a.proposedAmount.currency || 'USD')
                      : '—';
                    return '' +
                      '<div class="card p-3" data-app-id="' + esc(a.id) + '" data-freelancer-id="' + esc(a.freelancerId) + '">' +
                        '<a href="/pages/profile.html?id=' + esc(a.freelancerId) + '" class="flex items-center gap-2.5 no-underline">' +
                          '<img src="' + esc(u.avatar) + '" class="w-9 h-9 rounded-full object-cover" alt=""/>' +
                          '<div class="flex-1 min-w-0">' +
                            '<div class="text-sm font-medium truncate text-ink">' + esc(u.name || a.freelancerId) + '</div>' +
                            '<div class="text-[11px] text-ink-500 truncate">' + esc(f.headline || (f.serviceSlug || '').replace(/-/g,' ')) + '</div>' +
                          '</div>' +
                        '</a>' +
                        '<div class="mt-2 text-[11px] text-ink-500">★ ' + esc(f.rating || 0) + (fromPrice ? ' · From ' + fromPrice : '') + '</div>' +
                        '<div class="mt-2 text-[12px] text-ink-700 line-clamp-2">' + esc(a.pitch || '') + '</div>' +
                        '<div class="mt-2 text-[11px] text-ink-500">Proposed: ' + amount + (a.proposedDurationDays ? ' · ' + a.proposedDurationDays + ' days' : '') + '</div>' +
                        (col.key === 'sent' || col.key === 'shortlisted'
                          ? '<div class="mt-3 flex gap-1.5">' +
                              (col.key === 'sent' ? '<button type="button" class="btn btn-ghost btn-sm flex-1 text-xs" data-act="shortlist">Shortlist</button>' : '') +
                              '<button type="button" class="btn btn-primary btn-sm flex-1 text-xs" data-act="hire">Hire</button>' +
                              '<button type="button" class="btn btn-ghost btn-sm text-xs" data-act="reject" style="border-color:var(--rose-100);color:var(--rose-700);">Decline</button>' +
                            '</div>'
                          : ''
                        ) +
                      '</div>';
                  }).join('') +
                  (items.length === 0 ? '<div class="text-center py-8 text-xs text-ink-400">Empty</div>' : '') +
                '</div>' +
              '</div>';
          }).join('');

          // Wire the action buttons (Shortlist / Hire / Decline)
          board.querySelectorAll('[data-act]').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              e.preventDefault();
              const card = btn.closest('[data-app-id]');
              const appId = card && card.getAttribute('data-app-id');
              const fid   = card && card.getAttribute('data-freelancer-id');
              const act   = btn.getAttribute('data-act');
              if (!appId) return;
              const statusMap = { shortlist: 'shortlisted', hire: 'accepted', reject: 'rejected' };
              const newStatus = statusMap[act];
              if (!newStatus) return;
              btn.disabled = true;
              try {
                // Update status directly in store (api.applications doesn't expose update yet).
                api._store.setState(s => {
                  s.applications = (s.applications || []).map(a =>
                    a.id === appId ? { ...a, status: newStatus, updatedAt: new Date().toISOString() } : a
                  );
                  return s;
                });
                if (act === 'hire') {
                  // Also start a conversation so the brand can message — gives the
                  // "Hire" action something real to land into.
                  try { await api.messages.startWith(fid); } catch (_) {}
                  UI && UI.toast('Hired — say hi in messages.', { kind: 'success' });
                } else if (act === 'shortlist') {
                  UI && UI.toast('Moved to shortlist.', { kind: 'success' });
                } else {
                  UI && UI.toast('Application declined.', { kind: 'success' });
                }
                await loadApplicants();
              } catch (err) {
                UI && UI.toast(err.message || 'Action failed', { kind: 'error' });
                btn.disabled = false;
              }
            });
          });
        }

        picker.addEventListener('change', () => pickBrief(picker.value));
        loadBriefs();
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Dashboard>
