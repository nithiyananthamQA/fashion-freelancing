---
import Dashboard from '@/layouts/Dashboard.astro';
import { creators } from '@/data/mock';

const stages = ['Inbox', 'Reviewing', 'Interview', 'Hired', 'Declined'];
const cols: Record<string, typeof creators> = {
  Inbox: creators.slice(0, 3) as any,
  Reviewing: creators.slice(3, 5) as any,
  Interview: creators.slice(5, 6) as any,
  Hired: creators.slice(6, 7) as any,
  Declined: [] as any,
};
---
<Dashboard title="Applicants" pageTitle="Applicants" current="applicants" role="brand">

  <div class="card p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
    <div>
      <h2 class="editorial text-lg">Senior womenswear designer · SS27 capsule</h2>
      <div class="text-xs text-ink-500">Maison Kirei job · 12 applicants · Posted 2d ago</div>
    </div>
    <div class="flex items-center gap-2">
      <button class="chip">All briefs</button>
      <button class="chip">Sort: AI match</button>
      <button class="chip chip-active">Pipeline</button>
      <button class="chip">List</button>
    </div>
  </div>

  <!-- Pipeline kanban -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-5 gap-4">
    {stages.map((stage) => (
      <div>
        <div class="flex items-center justify-between mb-3">
          <span class="text-xs uppercase tracking-[0.16em] text-ink-500 font-medium">{stage}</span>
          <span class="mono text-[11px] text-ink-400">{cols[stage].length}</span>
        </div>
        <div class="space-y-3 min-h-[200px] p-2 bg-surface rounded-xl border border-dashed border-line">
          {cols[stage].map((c) => (
            <div class="card p-3 cursor-grab hover:shadow-soft transition">
              <div class="flex items-center gap-2.5">
                <img src={c.avatar} class="w-9 h-9 rounded-full object-cover" alt=""/>
                <div class="flex-1 min-w-0">
                  <div class="text-sm font-medium truncate">{c.name}</div>
                  <div class="text-[11px] text-ink-500 truncate">{c.specialty}</div>
                </div>
              </div>
              <div class="mt-3 flex items-center justify-between">
                <span class="pill pill-gold">{Math.round(80 + c.rating * 3)}%</span>
                <span class="text-[11px] text-ink-500">{c.location.split(',')[0]}</span>
              </div>
              <div class="mt-2 text-[11px] text-ink-500">★ {c.rating} · From {c.currency === 'USD' ? '$' : c.currency === 'EUR' ? '€' : '£'}{c.from}</div>
            </div>
          ))}
          {cols[stage].length === 0 && (
            <div class="text-center py-8 text-xs text-ink-400">No applicants yet</div>
          )}
        </div>
      </div>
    ))}
  </div>

</Dashboard>
