---
import Dashboard from '@/layouts/Dashboard.astro';
import { brandOrders } from '@/data/mock';

const statusPill = (s: string) => ({
  ordered: 'pill-blue',
  in_progress: 'pill-champagne',
  delivered: 'pill-green',
  reviewed: 'pill-gray',
  cancelled: 'pill-rose',
}[s] ?? 'pill-gray');
---
<Dashboard title="My orders" pageTitle="My orders" current="orders" role="brand">

  <div class="grid grid-cols-2 lg:grid-cols-5 gap-3 mb-6">
    <div class="card p-4 text-center"><div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Total spent</div><div class="display gold-text text-2xl mt-1">$11,800</div></div>
    <div class="card p-4 text-center"><div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Active</div><div class="display text-2xl mt-1 text-champagne-3">2</div></div>
    <div class="card p-4 text-center"><div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Delivered</div><div class="display text-2xl mt-1 text-emerald-700">1</div></div>
    <div class="card p-4 text-center"><div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Avg time</div><div class="display text-2xl mt-1">3.2d</div></div>
    <div class="card p-4 text-center"><div class="text-[11px] mono uppercase tracking-[0.16em] text-ink-5">Hires</div><div class="display text-2xl mt-1">5</div></div>
  </div>

  <div class="card overflow-hidden">
    <div class="px-6 py-4 border-b border-line flex items-center justify-between flex-wrap gap-3">
      <div class="flex gap-2 flex-wrap">
        <button class="chip chip-active">All</button>
        <button class="chip">Active</button>
        <button class="chip">Awaiting review</button>
        <button class="chip">Completed</button>
      </div>
      <a href="/brand/talent" class="btn btn-champagne">+ Hire someone new</a>
    </div>

    <div class="overflow-x-auto -mx-px"><table class="w-full">
      <thead>
        <tr class="bg-paper text-[11px] mono uppercase tracking-[0.12em] text-ink-5">
          <th class="text-left px-6 py-3 font-medium">Order</th>
          <th class="text-left px-6 py-3 font-medium">Seller</th>
          <th class="text-left px-6 py-3 font-medium">Tier</th>
          <th class="text-left px-6 py-3 font-medium">Amount</th>
          <th class="text-left px-6 py-3 font-medium">Due</th>
          <th class="text-left px-6 py-3 font-medium">Status</th>
          <th class="px-6 py-3"></th>
        </tr>
      </thead>
      <tbody id="ff-brand-orders-body">
        {brandOrders.map((o) => (
          <tr class="border-t border-line hover:bg-paper-2/50 transition">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-lg bg-paper-2 mono text-[10px] flex items-center justify-center font-semibold">{o.id.toUpperCase()}</span>
                <div>
                  <div class="font-medium text-sm">{o.gigTitle}</div>
                  <div class="text-xs text-ink-5">Ordered {o.orderedAt}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2"><img src={o.sellerAvatar} class="w-7 h-7 rounded-full object-cover" alt=""/><span class="text-sm">{o.seller}</span></div>
            </td>
            <td class="px-6 py-4 text-sm">{o.tier}</td>
            <td class="px-6 py-4 text-sm font-medium">{o.amount}</td>
            <td class="px-6 py-4 text-sm">{o.due}</td>
            <td class="px-6 py-4"><span class={statusPill(o.status)}>{o.status.replace('_',' ')}</span></td>
            <td class="px-6 py-4 text-right"><a href={`/dashboard/orders/${o.id}`} class="text-sm text-champagne-2 hover:underline">Open →</a></td>
          </tr>
        ))}
      </tbody>
    </table></div>
  </div>

  <script is:inline>
    window.addEventListener('ff:ready', async () => {
      const session = api.users.sessionSync(); if (!session) return;
      const orders = await api.orders.list({ buyerId: session.userId });
      const tbody = document.getElementById('ff-brand-orders-body');
      if (!tbody) return;
      const pillFor = (s) => ({ ordered:'pill-blue', in_progress:'pill-champagne', delivered:'pill-green', reviewed:'pill-gray', cancelled:'pill-rose' }[s] || 'pill-gray');
      if (!orders.length) {
        tbody.innerHTML = `<tr><td colspan="7" class="px-6 py-16 text-center"><div style="font-size:36px;margin-bottom:8px;">📭</div><div class="font-medium">No orders yet.</div><div class="text-sm muted mt-1">When you hire a freelancer, your orders show up here.</div></td></tr>`;
        return;
      }
      tbody.innerHTML = orders.map(o => {
        const seller = api._store.getState().users.find(u => u.id === o.sellerId);
        return `
          <tr class="border-t border-line hover:bg-paper-2/50 transition fade-in-up">
            <td class="px-6 py-4">
              <div class="flex items-center gap-3">
                <span class="w-9 h-9 rounded-lg bg-paper-2 mono text-[10px] flex items-center justify-center font-semibold">${o.id.slice(-6).toUpperCase()}</span>
                <div>
                  <div class="font-medium text-sm">${o.title}</div>
                  <div class="text-xs text-ink-5">Ordered ${api.fmt.timeAgo(o.orderedAt)}</div>
                </div>
              </div>
            </td>
            <td class="px-6 py-4">
              <div class="flex items-center gap-2">
                <img src="${seller ? seller.avatar : ''}" class="w-7 h-7 rounded-full object-cover" alt=""/>
                <span class="text-sm">${seller ? seller.name : '—'}</span>
              </div>
            </td>
            <td class="px-6 py-4 text-sm capitalize">${o.tier || '—'}</td>
            <td class="px-6 py-4 text-sm font-medium">${api.fmt.money(o.amount.amount, o.amount.currency)}</td>
            <td class="px-6 py-4 text-sm">${new Date(o.dueAt).toLocaleDateString()}</td>
            <td class="px-6 py-4"><span class="${pillFor(o.status)}">${o.status.replace(/_/g,' ')}</span></td>
            <td class="px-6 py-4 text-right"><a href="/dashboard/orders/${o.id}" class="text-sm text-champagne-2 hover:underline">Open →</a></td>
          </tr>`;
      }).join('');
    });
  </script>

</Dashboard>
