---
import Dashboard from '@/layouts/Dashboard.astro';
const team = [
  { name:'Sara Lindqvist', role:'Founder · Owner', email:'sara@auriga.world', avatar:'https://images.unsplash.com/photo-1573496359142-b8d87734a5a2?w=200', status:'active' },
  { name:'Akira Sato', role:'Production Lead', email:'akira@auriga.world', avatar:'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200', status:'active' },
  { name:'Emma DuBois', role:'Design Director', email:'emma@auriga.world', avatar:'https://images.unsplash.com/photo-1502823403499-6ccfcf4fb453?w=200', status:'active' },
  { name:'Lucas Mendez', role:'Operations', email:'lucas@auriga.world', avatar:'https://images.unsplash.com/photo-1463453091185-61582044d556?w=200', status:'invited' },
  { name:'Hana Choi', role:'Marketing', email:'hana@auriga.world', avatar:'https://images.unsplash.com/photo-1531123897727-8f129e1688ce?w=200', status:'active' },
];
---
<Dashboard title="Team" pageTitle="Team" current="team" role="brand">

  <div class="card p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
    <div>
      <h2 class="editorial text-lg">Workspace members</h2>
      <div class="text-xs text-ink-500">5 of 8 seats used · Enterprise plan</div>
    </div>
    <button class="btn-gold">+ Invite member</button>
  </div>

  <div class="card overflow-hidden">
    <div class="px-6 py-3 grid grid-cols-12 gap-4 text-[11px] mono uppercase tracking-[0.18em] text-ink-500 border-b border-line">
      <div class="col-span-5">Member</div><div class="col-span-3">Role</div><div class="col-span-2">Status</div><div class="col-span-2 text-right">Actions</div>
    </div>
    <div class="divide-y divide-line">
      {team.map((m) => (
        <div class="px-6 py-4 grid grid-cols-12 gap-4 items-center hover:bg-ink-50/50 transition">
          <div class="col-span-5 flex items-center gap-3">
            <img src={m.avatar} class="w-10 h-10 rounded-full object-cover" alt=""/>
            <div><div class="font-medium text-sm">{m.name}</div><div class="text-xs text-ink-500">{m.email}</div></div>
          </div>
          <div class="col-span-3 text-sm text-ink-700">{m.role}</div>
          <div class="col-span-2"><span class={`pill ${m.status === 'active' ? 'pill-green' : 'pill-gold'}`}>{m.status}</span></div>
          <div class="col-span-2 text-right"><button class="chip">Manage</button></div>
        </div>
      ))}
    </div>
  </div>

</Dashboard>
