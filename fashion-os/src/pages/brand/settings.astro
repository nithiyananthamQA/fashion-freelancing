---
import Dashboard from '@/layouts/Dashboard.astro';
---
<Dashboard title="Settings" pageTitle="Settings" current="settings" role="brand">

  <div class="grid grid-cols-12 gap-8">
    <aside class="col-span-12 lg:col-span-3">
      <div class="card p-2 sticky top-24">
        <a href="#account" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm bg-ink text-paper">Brand profile</a>
        <a href="#notifications" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">Notifications</a>
        <a href="#security" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">Security</a>
        <a href="#sso" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">SSO</a>
        <a href="#api" class="flex items-center justify-between px-3 py-2.5 rounded-lg text-sm text-ink-3 hover:bg-paper-2">API &amp; integrations</a>
      </div>
    </aside>

    <div class="col-span-12 lg:col-span-9 space-y-6">

      <section id="account" class="card p-6">
        <h2 class="display text-xl">Brand profile</h2>
        <p class="text-sm text-ink-5 mt-1">How creators see your brand.</p>
        <div class="grid grid-cols-2 gap-4 mt-6">
          <div><label class="label">Brand name</label><input class="input" value="Auriga"/></div>
          <div><label class="label">Website</label><input class="input" value="auriga.world"/></div>
          <div class="col-span-2"><label class="label">About</label><textarea class="input" rows="3">Indie luxury womenswear · Stockholm · ready-to-wear and capsules.</textarea></div>
          <div><label class="label">HQ city</label><input class="input" value="Stockholm"/></div>
          <div><label class="label">Country</label><input class="input" value="Sweden"/></div>
        </div>
        <button class="btn btn-primary mt-6">Save changes</button>
      </section>

      <section id="security" class="card p-6">
        <h2 class="display text-xl">Security</h2>
        <div class="mt-6 space-y-3">
          <div class="flex items-center justify-between p-4 border border-line rounded-xl">
            <div><div class="font-medium text-sm">Two-factor authentication</div><div class="text-xs text-ink-5">All members enforced</div></div>
            <span class="pill-green">Enforced</span>
          </div>
          <div class="flex items-center justify-between p-4 border border-line rounded-xl">
            <div><div class="font-medium text-sm">Audit log</div><div class="text-xs text-ink-5">90-day retention</div></div>
            <button class="btn btn-ghost">View log</button>
          </div>
        </div>
      </section>

      <section id="sso" class="card p-6">
        <h2 class="display text-xl">SSO</h2>
        <p class="text-sm text-ink-5 mt-1">Enterprise sign-on with Okta, Google Workspace, Azure AD.</p>
        <div class="mt-4 p-4 border border-line rounded-xl flex items-center justify-between">
          <div><div class="font-medium text-sm">Google Workspace</div><div class="text-xs text-ink-5">@auriga.world domain</div></div>
          <span class="pill-green">Connected</span>
        </div>
      </section>

      <section id="api" class="card p-6">
        <h2 class="display text-xl">API &amp; integrations</h2>
        <div class="mt-6 space-y-2">
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-9 h-9 rounded-lg bg-paper-2 flex items-center justify-center font-semibold text-xs">SH</span><div><div class="text-sm">Shopify</div><div class="text-xs text-ink-5">Connected · auriga.myshopify.com</div></div></div>
            <button class="btn btn-ghost btn-sm">Disconnect</button>
          </div>
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-9 h-9 rounded-lg bg-paper-2 flex items-center justify-center font-semibold text-xs">FG</span><div><div class="text-sm">Figma</div><div class="text-xs text-ink-5">Not connected</div></div></div>
            <button class="btn btn-ghost btn-sm">Connect</button>
          </div>
          <div class="flex items-center justify-between p-3 border border-line rounded-xl">
            <div class="flex items-center gap-3"><span class="w-9 h-9 rounded-lg bg-paper-2 flex items-center justify-center font-semibold text-xs">SL</span><div><div class="text-sm">Slack</div><div class="text-xs text-ink-5">Connected · #fashion-team</div></div></div>
            <button class="btn btn-ghost btn-sm">Disconnect</button>
          </div>
        </div>

        <h3 class="display text-base mt-8">API access</h3>
        <div class="mt-3 p-4 border border-line rounded-xl bg-paper-2 font-mono text-xs">
          <div class="text-ink-5">Production key</div>
          <div class="mt-2">fos_live_••••••••••••••••••••••<button class="btn btn-link ml-3 text-xs">Reveal</button></div>
        </div>
      </section>
    </div>
  </div>

</Dashboard>
