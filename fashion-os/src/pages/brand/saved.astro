---
import Dashboard from '@/layouts/Dashboard.astro';
---
<Dashboard title="Saved talent" pageTitle="Saved talent" current="saved" role="brand">

  <div class="card p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
    <div>
      <h2 class="display text-lg">Your private talent pool</h2>
      <div class="text-xs text-ink-5 mt-1"><span id="saved-count">0</span> creators saved · share with team or hire any time</div>
    </div>
    <div class="flex gap-2">
      <button class="btn btn-ghost btn-sm" disabled style="opacity:.5;cursor:not-allowed;">Export CSV</button>
      <button class="btn btn-ghost btn-sm" disabled style="opacity:.5;cursor:not-allowed;">Share with team</button>
      <a href="/brand/talent" class="btn btn-champagne btn-sm">+ Find more talent</a>
    </div>
  </div>

  <div id="saved-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    <!-- Empty state by default; hydrated from api.users.getSaved() on ff:ready -->
  </div>

  <div id="saved-empty" class="card p-10 text-center text-ink-5 hidden">
    <div class="text-4xl mb-3">♥</div>
    <div class="font-medium text-ink mb-1">No saved creators yet</div>
    <div class="text-sm">Tap the heart on any creator card to save them here.</div>
    <a href="/brand/talent" class="btn btn-primary btn-sm mt-4 inline-flex">Browse talent →</a>
  </div>

  <script is:inline>
    (function () {
      function init() {
        const api = window.api;
        if (!api) return;
        const grid = document.getElementById('saved-grid');
        const empty = document.getElementById('saved-empty');
        const count = document.getElementById('saved-count');
        if (!grid) return;

        function esc(s) {
          return String(s == null ? '' : s).replace(/[&<>"]/g, c => (
            { '&':'&amp;', '<':'&lt;', '>':'&gt;', '"':'&quot;' }[c]
          ));
        }
        function currencySymbol(c) {
          return c === 'EUR' ? '€' : c === 'GBP' ? '£' : c === 'INR' ? '₹' : '$';
        }

        api.users.getSaved().then(function (list) {
          count.textContent = list.length;
          if (!list.length) {
            empty.classList.remove('hidden');
            return;
          }
          grid.innerHTML = list.map(function (f) {
            const sym = currencySymbol(f.currency);
            const badge = (f.badges && f.badges[0]) || '';
            return '' +
              '<div class="card overflow-hidden">' +
                '<div class="aspect-[4/3] bg-paper-2 relative">' +
                  '<img src="' + esc(f.cover) + '" alt="" class="w-full h-full object-cover" loading="lazy"/>' +
                  '<button class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-champagne-2" data-unsave="' + esc(f.id) + '" aria-label="Unsave">♥</button>' +
                  (badge ? '<span class="pill pill-champagne absolute top-3 left-3">' + esc(badge) + '</span>' : '') +
                '</div>' +
                '<div class="p-4">' +
                  '<div class="flex items-center gap-2">' +
                    '<img src="' + esc(f.avatar) + '" class="w-8 h-8 rounded-full object-cover -mt-7 ring-2 ring-white" alt=""/>' +
                    '<div class="flex-1 min-w-0">' +
                      '<div class="font-medium text-sm truncate">' + esc(f.name) + '</div>' +
                      '<div class="text-xs text-ink-5 truncate">' + esc((f.headline || f.serviceSlug || '').replace(/-/g,' ')) + ' · ' + esc((f.city || '').split(',')[0]) + '</div>' +
                    '</div>' +
                  '</div>' +
                  '<div class="mt-3 flex items-center justify-between text-xs">' +
                    '<span class="text-champagne-2">★ ' + esc(f.rating || 0) + '</span>' +
                    '<span class="text-ink-5">From <strong class="text-ink">' + sym + esc(f.fromPrice || 0) + '</strong></span>' +
                  '</div>' +
                  '<div class="mt-3 flex gap-1.5">' +
                    '<a href="/pages/hire.html?freelancerId=' + esc(f.id) + '" class="btn btn-primary btn-sm flex-1 text-xs">Hire</a>' +
                    '<a href="/pages/profile.html?id=' + esc(f.id) + '" class="btn btn-ghost btn-sm flex-1 text-xs">View</a>' +
                  '</div>' +
                '</div>' +
              '</div>';
          }).join('');

          // Wire unsave buttons (toggleSavedFreelancer flips state)
          grid.querySelectorAll('[data-unsave]').forEach(function (btn) {
            btn.addEventListener('click', async function (e) {
              e.preventDefault();
              const id = btn.getAttribute('data-unsave');
              try {
                await api.users.toggleSavedFreelancer(id);
                if (window.UI) UI.toast('Removed from saved.', { kind: 'success' });
                // Re-fetch to refresh
                init();
              } catch (err) {
                if (window.UI) UI.toast(err.message || 'Could not update', { kind: 'error' });
              }
            });
          });
        }).catch(function (e) {
          console.error('Failed to load saved freelancers:', e);
          empty.classList.remove('hidden');
        });
      }
      if (window.api) init();
      else window.addEventListener('ff:ready', init, { once: true });
    })();
  </script>

</Dashboard>
