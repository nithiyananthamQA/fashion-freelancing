---
import Dashboard from '@/layouts/Dashboard.astro';
import { creators } from '@/data/mock';
const saved = creators.slice(0, 5);
---
<Dashboard title="Saved talent" pageTitle="Saved talent" current="saved" role="brand">

  <div class="card p-5 mb-6 flex items-center justify-between flex-wrap gap-3">
    <div>
      <h2 class="display text-lg">Your private talent pool</h2>
      <div class="text-xs text-ink-5 mt-1">{saved.length} creators saved · share with team or hire any time</div>
    </div>
    <div class="flex gap-2">
      <button class="btn btn-ghost btn-sm">Export CSV</button>
      <button class="btn btn-ghost btn-sm">Share with team</button>
      <a href="/brand/talent" class="btn btn-champagne btn-sm">+ Find more talent</a>
    </div>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    {saved.map((c) => (
      <div class="card overflow-hidden">
        <div class="aspect-[4/3] bg-paper-2 relative">
          <img src={c.cover} alt="" class="w-full h-full object-cover"/>
          <button class="absolute top-3 right-3 w-8 h-8 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-champagne-2" aria-label="Unsave">♥</button>
          {c.badges[0] && <span class="pill pill-champagne absolute top-3 left-3">{c.badges[0]}</span>}
        </div>
        <div class="p-4">
          <div class="flex items-center gap-2">
            <img src={c.avatar} class="w-8 h-8 rounded-full object-cover -mt-7 ring-2 ring-white" alt=""/>
            <div class="flex-1 min-w-0">
              <div class="font-medium text-sm truncate">{c.name}</div>
              <div class="text-xs text-ink-5 truncate">{c.specialty} · {c.location.split(',')[0]}</div>
            </div>
          </div>
          <div class="mt-3 flex items-center justify-between text-xs">
            <span class="text-champagne-2">★ {c.rating}</span>
            <span class="text-ink-5">From <strong class="text-ink">{c.currency === 'USD' ? '$' : c.currency === 'EUR' ? '€' : '£'}{c.from}</strong></span>
          </div>
          <div class="mt-3 flex gap-1.5">
            <a href="#" class="btn btn-primary btn-sm flex-1 text-xs">Hire</a>
            <a href="#" class="btn btn-ghost btn-sm flex-1 text-xs">Message</a>
          </div>
        </div>
      </div>
    ))}
  </div>

</Dashboard>
