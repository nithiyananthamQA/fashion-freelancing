---
import Dashboard from '@/layouts/Dashboard.astro';
import { creators } from '@/data/mock';
---
<Dashboard title="Find talent" pageTitle="Find talent" current="talent" role="brand">

  <div class="card p-5 mb-6 flex items-center gap-3 flex-wrap">
    <div class="flex-1 min-w-[260px] flex items-center gap-2 px-4 py-2 border border-line rounded-full bg-white">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="text-ink-400"><circle cx="11" cy="11" r="7"/><path d="M20 20l-3-3"/></svg>
      <input class="flex-1 bg-transparent outline-none text-sm" placeholder="Search creators by craft, skill or city…"/>
    </div>
    <button class="chip">Filters</button>
    <button class="chip">Save search</button>
    <button class="btn-gold">+ Invite to my job</button>
  </div>

  <div class="flex items-center gap-2 mb-5 overflow-x-auto pb-1">
    <button class="chip chip-active">All · 12,400</button>
    <button class="chip">Available now · 4,210</button>
    <button class="chip">Top 1% · 124</button>
    <button class="chip">Womenswear · 2,140</button>
    <button class="chip">Tech pack · 980</button>
    <button class="chip">Pattern · 1,302</button>
    <button class="chip">Stylists · 1,766</button>
    <button class="chip">Manufacturers · 412</button>
  </div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    {creators.map((c) => (
      <div class="card overflow-hidden card-hover group">
        <div class="plate aspect-[4/5] !rounded-none">
          <img src={c.cover} alt=""/>
          {c.badges[0] && <span class="pill pill-gold absolute top-3 left-3 z-10">{c.badges[0]}</span>}
          <div class="absolute bottom-3 right-3 flex gap-1.5 z-10">
            <button class="w-8 h-8 rounded-full bg-white/90 backdrop-blur flex items-center justify-center text-ink-700 hover:text-gold transition">♡</button>
          </div>
        </div>
        <div class="p-4">
          <div class="flex items-start gap-3">
            <img src={c.avatar} class="w-9 h-9 rounded-full object-cover -mt-7 ring-2 ring-white" alt=""/>
            <div class="flex-1 min-w-0">
              <div class="flex items-center justify-between">
                <div class="editorial text-lg leading-tight truncate">{c.name}</div>
                <span class="text-gold-deep text-xs">★ {c.rating}</span>
              </div>
              <div class="text-xs text-ink-500 truncate">{c.specialty} · {c.location}</div>
            </div>
          </div>
          <div class="mt-3 flex flex-wrap gap-1.5">
            {c.tags.slice(0,3).map((t) => <span class="chip text-[11px] !py-0.5">{t}</span>)}
          </div>
          <div class="mt-4 flex items-center justify-between">
            <span class="text-xs text-ink-500">From <strong class="text-ink-900 text-sm">{c.currency === 'USD' ? '$' : c.currency === 'EUR' ? '€' : '£'}{c.from}</strong></span>
            <button class="btn-gold !py-1.5 !px-3 text-xs">Invite</button>
          </div>
        </div>
      </div>
    ))}
  </div>

</Dashboard>
