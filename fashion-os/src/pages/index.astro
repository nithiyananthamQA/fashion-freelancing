---
// Serve the public homepage at /. We read the static index.html from /public/
// and stream it back, so the URL stays at / (no redirect).
import fs from 'node:fs';
import path from 'node:path';

const filePath = path.resolve('public/index.html');
let html = '';
try { html = fs.readFileSync(filePath, 'utf8'); } catch { html = '<!doctype html><title>Fashion Freelancing</title><h1>Homepage missing</h1>'; }
---
<Fragment set:html={html} />
