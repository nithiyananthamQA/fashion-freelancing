---
import '@/styles/globals.css';
import AdminSidebar from '@/components/AdminSidebar.astro';
const { title = 'Admin', current = '', pageTitle = 'Dashboard' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · Fashion Freelancing Admin</title>
  <meta name="theme-color" content="#F4F4FB" />
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Cdefs%3E%3ClinearGradient id='g' x1='0' y1='0' x2='1' y2='1'%3E%3Cstop offset='0' stop-color='%236E56F0'/%3E%3Cstop offset='1' stop-color='%232BA8E8'/%3E%3C/linearGradient%3E%3C/defs%3E%3Crect width='32' height='32' rx='8' fill='url(%23g)'/%3E%3Ctext x='16' y='22' font-family='Georgia,serif' font-size='14' font-weight='600' fill='%23fff' text-anchor='middle'%3EFA%3C/text%3E%3C/svg%3E" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-paper-2">
  <div class="flex min-h-screen">
    <AdminSidebar current={current} />
    <div class="flex-1 min-w-0">
      <header class="db-topbar border-b border-line sticky top-0 z-40">
        <div class="h-16 px-4 lg:px-8 flex items-center gap-3 lg:gap-4">
          <button id="db-nav-toggle" aria-label="Open menu"
            class="lg:hidden w-10 h-10 -ml-1 rounded-lg flex flex-col items-center justify-center gap-[5px] border border-line bg-white/70 backdrop-blur hover:border-champagne transition">
            <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
            <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
            <span class="w-4 h-0.5 bg-ink-900 rounded-full"></span>
          </button>
          <h1 class="display text-xl">{pageTitle}</h1>
          <div class="ml-auto flex items-center gap-2">
            <button class="chip">Refresh</button>
            <button class="chip">Export</button>
          </div>
        </div>
      </header>
      <main class="px-6 lg:px-8 py-8">
        <slot />
      </main>
    </div>
  </div>

  <!-- Admin motion: cinematic scroll-reveal + card cursor-spotlight -->
  <script is:inline>
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      function wire() {
        document.querySelectorAll('main .card').forEach(function (el, i) {
          el.classList.add('reveal');
          el.style.transitionDelay = ((i % 4) * 0.07) + 's';
        });
        var io = new IntersectionObserver(function (ents) {
          ents.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });
        document.addEventListener('pointermove', function (e) {
          var c = e.target.closest && e.target.closest('main .card');
          if (!c) return;
          var r = c.getBoundingClientRect();
          c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          c.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });

        var bar = document.querySelector('.db-topbar');
        if (bar) {
          var t = false;
          var sync = function () { bar.classList.toggle('is-scrolled', window.scrollY > 12); t = false; };
          window.addEventListener('scroll', function () {
            if (!t) { requestAnimationFrame(sync); t = true; }
          }, { passive: true });
          sync();
        }
      }
      if (document.readyState !== 'loading') wire();
      else document.addEventListener('DOMContentLoaded', wire);
    })();
  </script>
</body>
</html>
