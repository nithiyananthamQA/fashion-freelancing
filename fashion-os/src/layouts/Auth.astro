---
import '@/styles/globals.css';
import Logo from '@/components/Logo.astro';
const { title = 'Sign in', heroImage = 'https://images.unsplash.com/photo-1488161628813-04466f872be2?w=1400&auto=format&fit=crop', heroCaption = 'Yuna Aoki — SS27 silk capsule, Tokyo' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · Fashion Freelancing</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,400;0,9..144,500;0,9..144,600;1,9..144,500&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
</head>
<body class="bg-white">
  <div class="min-h-screen grid lg:grid-cols-[1fr_1.1fr]">

    <div class="flex flex-col px-6 sm:px-12 lg:px-20 py-10 relative">
      <Logo />
      <div class="flex-1 flex items-center">
        <div class="w-full max-w-md mx-auto">
          <slot />
        </div>
      </div>
      <div class="text-xs text-ink-500 flex justify-between gap-4">
        <span>© 2026 Fashion Freelancing</span>
        <div class="flex gap-4"><a href="#" class="hover:text-ink-900">Privacy</a><a href="#" class="hover:text-ink-900">Terms</a></div>
      </div>
    </div>

    <div class="hidden lg:block relative overflow-hidden">
      <img src={heroImage} alt="" class="absolute inset-0 w-full h-full object-cover"/>
      <div class="absolute inset-0 bg-gradient-to-tr from-black/50 via-transparent to-transparent"></div>
      <div class="absolute top-8 right-8 chip !bg-white/10 !border-white/20 text-white backdrop-blur-md">
        <span class="w-1.5 h-1.5 rounded-full bg-gold"></span>
        Featured creator this week
      </div>
      <div class="absolute bottom-8 left-8 right-8 text-white">
        <div class="editorial text-3xl max-w-sm">"Fashion Freelancing replaced our agency."</div>
        <div class="text-sm text-white/80 mt-3">{heroCaption}</div>
      </div>
    </div>

  </div>
</body>
</html>
