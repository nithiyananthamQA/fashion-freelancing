---
import '@/styles/globals.css';
import DashboardSidebar from '@/components/DashboardSidebar.astro';
import DashboardTopbar from '@/components/DashboardTopbar.astro';
const { title = 'Dashboard', current = '', role = 'creator', pageTitle = 'Overview' } = Astro.props;
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>{title} · Fashion Freelancing</title>
  <meta name="theme-color" content="#FFFFFF" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" media="print" onload="this.media=&apos;all&apos;" />
  <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" /></noscript>
</head>
<body class="bg-surface">
  <div class="flex min-h-screen">
    <DashboardSidebar current={current} role={role} />
    <div class="flex-1 min-w-0">
      <DashboardTopbar title={pageTitle} role={role} />
      <main class="px-6 lg:px-8 py-8">
        {/* Approval banner — shown by JS only when the signed-in creator's
            freelancer profile is in 'pending' or 'rejected' state. */}
        <div id="ff-approval-banner" class="hidden mb-6"></div>
        <slot />
      </main>
    </div>
  </div>

  <!-- Shared store/api/ui — same as public-html, served from /public/ -->
  <script src="/store.js" is:inline></script>
  <script src="/api.js" is:inline></script>
  <script src="/ui.js" is:inline></script>
  <script is:inline>
    // Mark shared modules ready for any page hydration scripts
    window.dispatchEvent(new CustomEvent('ff:ready', { detail: { api: window.api, ui: window.UI } }));
    // If no session, redirect to public sign-in. (For demo: bypass.)
    if (!window.api.users.sessionSync()) {
      // Auto-sign-in as demo Yuna for the creator dashboard
      const isBrand = location.pathname.startsWith('/brand');
      const isAdmin = location.pathname.startsWith('/admin');
      const email = isBrand ? 'sara@auriga.world' : isAdmin ? 'admin@fashionfreelancing.app' : 'yuna@example.com';
      window.api.users.signIn({ email }).then(() => location.reload());
    }
  </script>

  <!-- Approval banner — shown when the signed-in creator is pending/rejected -->
  <script is:inline>
    (function () {
      function paintBanner() {
        var api = window.api, banner = document.getElementById('ff-approval-banner');
        if (!api || !banner) return;
        var session = api.users.sessionSync();
        if (!session || session.role !== 'creator') return;
        var f = api._store.getState().freelancers.find(function (x) { return x.id === session.userId; });
        if (!f) return; // no freelancer profile yet — first-time pre-onboarding
        var status = f.approvalStatus || 'approved';
        if (status === 'approved') return;
        banner.classList.remove('hidden');
        if (status === 'pending') {
          banner.innerHTML = '' +
            '<div class="card p-5 flex items-start gap-4" style="background:linear-gradient(135deg,rgba(110,86,240,.08),rgba(43,168,232,.06));border-color:rgba(110,86,240,.3);">' +
            '<div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-white" style="background:linear-gradient(135deg,#6E56F0,#2BA8E8);">⏳</div>' +
            '<div class="flex-1 min-w-0">' +
              '<div class="font-semibold text-ink-900">Your page is under review.</div>' +
              '<div class="text-sm text-ink-500 mt-1">Our editors are checking your portfolio. We\'ll email you when it\'s approved — usually within 48 hours. Until then, you can browse but can\'t apply to jobs or be hired yet.</div>' +
            '</div>' +
            '<a href="/dashboard/profile" class="btn btn-ghost text-sm hidden md:inline-flex">Edit my page</a>' +
            '</div>';
        } else if (status === 'rejected') {
          banner.innerHTML = '' +
            '<div class="card p-5 flex items-start gap-4" style="background:#FCEAEF;border-color:#F2C7D1;">' +
            '<div class="w-10 h-10 rounded-full flex-shrink-0 flex items-center justify-center text-rose-700 bg-white">!</div>' +
            '<div class="flex-1 min-w-0">' +
              '<div class="font-semibold text-rose-700">Your page wasn\'t approved.</div>' +
              '<div class="text-sm text-rose-700/80 mt-1">' + (f.approvalReason || 'Profile did not meet our quality bar.') + ' Update your portfolio and we\'ll review again.</div>' +
            '</div>' +
            '<a href="/dashboard/profile" class="btn btn-ghost text-sm hidden md:inline-flex">Edit my page</a>' +
            '</div>';
        }
      }
      if (window.api) paintBanner();
      else window.addEventListener('ff:ready', paintBanner, { once: true });
    })();
  </script>

  <!-- Dashboard motion: cinematic scroll-reveal + card cursor-spotlight -->
  <script is:inline>
    (function () {
      var reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      function wire() {
        if (reduce) return;
        // opt every content card into scroll-reveal, gently staggered per row
        var cards = document.querySelectorAll('main .card');
        cards.forEach(function (el, i) {
          el.classList.add('reveal');
          el.style.transitionDelay = ((i % 4) * 0.07) + 's';
        });
        var io = new IntersectionObserver(function (ents) {
          ents.forEach(function (e) {
            if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); }
          });
        }, { threshold: 0.08, rootMargin: '0px 0px -40px 0px' });
        document.querySelectorAll('.reveal').forEach(function (el) { io.observe(el); });

        // cursor spotlight glow on cards
        document.addEventListener('pointermove', function (e) {
          var c = e.target.closest && e.target.closest('main .card');
          if (!c) return;
          var r = c.getBoundingClientRect();
          c.style.setProperty('--mx', (e.clientX - r.left) + 'px');
          c.style.setProperty('--my', (e.clientY - r.top) + 'px');
        });

        // topbar condenses once scrolled
        var bar = document.querySelector('.db-topbar');
        if (bar) {
          var t = false;
          var sync = function () { bar.classList.toggle('is-scrolled', window.scrollY > 12); t = false; };
          window.addEventListener('scroll', function () {
            if (!t) { requestAnimationFrame(sync); t = true; }
          }, { passive: true });
          sync();
        }
      }
      if (document.readyState !== 'loading') wire();
      else document.addEventListener('DOMContentLoaded', wire);
    })();
  </script>
</body>
</html>
