# Dependencies
node_modules/
.pnpm-store/

# Build output (Cloudflare Pages builds this fresh)
fashion-os/dist/
fashion-os/.astro/

# Local Cloudflare state — D1 and R2 emulation for `npm run dev`
fashion-os/.wrangler/

# Synced copies — regenerated by scripts/sync-public.mjs at build time.
# Source of truth is public-html/. Everything else in fashion-os/public/
# (_headers, _redirects, favicon.svg) is real, hand-maintained source.
fashion-os/public/pages/
fashion-os/public/assets/
fashion-os/public/index.html
fashion-os/public/404.html
fashion-os/public/robots.txt
fashion-os/public/sitemap.xml

# Environment / secrets
.env
.env.*
.dev.vars

# Editor / OS
.DS_Store
*.swp
.vscode/
.idea/

# Logs
*.log
npm-debug.log*
pnpm-debug.log*

# wrangler local cache — holds account metadata, never commit
.wrangler/

# generated by fashion-os/scripts/sync-public.mjs from public-html
fashion-os/src/site-templates/
